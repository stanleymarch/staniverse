{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": { "@/*": ["src/*"] }
  },
  "exclude": [
    "node_modules",
    "dist",
    "pipeline/telegram/incoming",
    "pipeline/telegram/archive",
    "pipeline/telegram/private",
    "pipeline/telegram/.venv",
    "public",
    "test-results",
    "tmp",
    ".tmp",
    ".omp"
  ]
}
