# Public Yandex Metrika counter id. Empty disables analytics and the consent popup.
PUBLIC_YANDEX_METRIKA_ID=

# Verification token from Yandex Webmaster. Empty omits the verification meta tag.
YANDEX_WEBMASTER_VERIFICATION=

# Telegram MTProto for the nightly sync (see README, Автосинхронизация).
# App keys from my.telegram.org; session lives in pipeline/telegram/private/.
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

# Private life channel reference for pipeline/telegram/resolve-life.py:
# a numeric channel id, a t.me link, or an invite hash — any form
# Telethon's get_entity resolves. Exact title fallback for dialog search.
# Never committed anywhere: no public URL may name the channel.
#LIFE_CHANNEL_REF=
#LIFE_CHANNEL_TITLE=
