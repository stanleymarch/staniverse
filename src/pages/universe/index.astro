---
import Base from "../../layouts/Base.astro";
import { allEntries } from "../../lib/content";
import { buildGraph } from "../../lib/graph";
import UniverseScene from "../../components/universe/UniverseScene.astro";
import "../../styles/universe.css";
import { getCollection } from "astro:content";

const graph = buildGraph(await allEntries());
const [section] = await getCollection("sections", (entry) => entry.id === "universe");
---

<Base title={section.data.title} description={section.data.summary} immersive>
  <UniverseScene {graph} />
</Base>

<script>
  import { mountUniverse } from "../../components/universe/UniverseRuntime";
  mountUniverse();
</script>
