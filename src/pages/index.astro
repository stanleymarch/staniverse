  .const-edge { stroke: color-mix(in srgb, var(--ink) 40%, transparent); stroke-width: 1; stroke-linecap: round; stroke-dasharray: 6 5; vector-effect: non-scaling-stroke; animation: const-drift calc(var(--dur-3) * 13) linear infinite; transition: stroke var(--dur-2) var(--ease), stroke-width var(--dur-2) var(--ease); }
