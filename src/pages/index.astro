  .const-glow { position: absolute; inset: -340%; border-radius: var(--radius-pill); background: radial-gradient(closest-side, color-mix(in srgb, var(--tint) 40%, transparent), transparent 76%); opacity: .72; transition: opacity var(--dur-2) var(--ease); }
  .const-core { position: absolute; inset: 0; border-radius: var(--radius-pill); background: radial-gradient(circle, var(--ink) 0 24%, var(--tint) 52%, color-mix(in srgb, var(--tint) 45%, transparent) 100%); box-shadow: 0 0 calc(var(--mag, 8) * .9px) color-mix(in srgb, var(--tint) 60%, transparent); }
