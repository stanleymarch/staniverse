---
import Base from "../layouts/Base.astro";
import ContentCard from "../components/ContentCard.astro";
import { getCollection } from "astro:content";
import { hrefFor, kindLabel, type AnyEntry } from "../lib/content";

/* Everything the home page needs comes from the two curated lists below: no full
   catalogue pass, no graph build, no Three.js. The first screen has to stay cheap,
   so the scene on it is DOM + SVG + CSS only. */
const entryById = new Map<string, AnyEntry>();
for (const entry of [...(await getCollection("works")), ...(await getCollection("projects")), ...(await getCollection("articles"))]) entryById.set(entry.data.id, entry);
const pick = (ids: string[]) => ids.flatMap((id) => { const entry = entryById.get(id); return entry ? [entry] : []; });

const works = pick(["work:virtualnyy-ofis-advokata", "work:maslenitsa-v-slobodskom", "work:ya-obmanyvat-sebya-ne-stanu", "work:arka-vyatskogo-kremlya"]);
const projects = pick(["project:nearventure", "project:loci", "project:metavyatka", "project:omnipub", "project:mnemoform", "project:lichnoe-delo"]);

/* Four concrete practices, each backed by a real entry. The audience statement
   stays narrower than the skills list: no invented client segment for symmetry. */
const directions = [
  {
    icon: "xr",
    title: "XR и пространственные опыты",
    text: "Виртуальные офисы, VR-сцены, AR-примерки, цифровые двойники и выставочные миры. Собираю в Unity и WebXR так, чтобы у пространства был сценарий, а не только геометрия.",
    tags: ["WebXR", "Unity", "Blender"],
    entryId: "work:virtualnyy-ofis-advokata",
    proof: "Виртуальный офис адвоката",
  },
  {
    icon: "ai",
    title: "AI-автоматизация и агенты",
    text: "Собираю модели, данные и инструменты в понятные рабочие процессы. На практике — от исследования и документов до системы знаний, где решения и вкус остаются человеку.",
    tags: ["агенты", "Obsidian", "автоматизация"],
    entryId: "article:ai-diploma",
    proof: "Как я защитил диплом с ИИ-агентами",
  },
  {
    icon: "archive",
    title: "Цифровые архивы и культура",
    text: "Фотограмметрия, звук, локальная история и музейные коллекции в формате, который живёт и онлайн, и в шлеме, и на экране в зале. Со вниманием к источнику и правам.",
    tags: ["фотограмметрия", "архивы", "наследие"],
    entryId: "project:metavyatka",
    proof: "MetaVyatka — архив Вятки",
  },
  {
    icon: "media",
    title: "Медиа и образование",
    text: "Документальные истории, тексты, видео и методические материалы: от замысла и съёмки до образовательного продукта, публикации и передачи команде.",
    tags: ["медиа", "образование", "ДПО"],
    entryId: "work:prepodavanie-metodicheskaya-rabota-i-prodakshn-v-tsifrovykh-kafedrakh",
    proof: "Методическая работа и продакшн",
  },
].flatMap((direction) => {
  const entry = entryById.get(direction.entryId);
  return entry ? [{ ...direction, href: hrefFor(entry) }] : [];
});

/* ---------------------------------------------------------------------------
   Living map: a constellation of real works and projects. Layout is a two-node
   band grid, so star centres always land on the cell centres the edges use.
   --------------------------------------------------------------------------- */
type SkyStar = { key: string; entry: AnyEntry; band: 0 | 1 | 2; side: "left" | "right"; tint: string; mag: number };

const skyPlan: Omit<SkyStar, "entry">[] = [
  { key: "work:virtualnyy-ofis-advokata", band: 0, side: "left", tint: "cyan", mag: 13 },
  { key: "work:arka-vyatskogo-kremlya", band: 0, side: "right", tint: "amber", mag: 10 },
  { key: "project:loci", band: 1, side: "left", tint: "rose", mag: 8 },
  { key: "project:metavyatka", band: 1, side: "right", tint: "violet", mag: 12 },
  { key: "work:maslenitsa-v-slobodskom", band: 2, side: "left", tint: "mint", mag: 10 },
  { key: "work:ya-obmanyvat-sebya-ne-stanu", band: 2, side: "right", tint: "steel", mag: 11 },
];
const stars: SkyStar[] = skyPlan.flatMap((plan) => {
  const entry = entryById.get(plan.key);
  return entry ? [{ ...plan, entry }] : [];
});
const starByKey = new Map(stars.map((star) => [star.key, star]));

/* Edges are the editorial relations already stored on the entries, filtered by the
   same review rule the site graph uses — nothing invented for the picture. */
const hiddenReviews = new Set(["rejected", "proposed", "pending", "needs-review"]);
const isVisibleRelation = (relation: AnyEntry["data"]["relations"][number]) => {
  const status = relation.status === "rejected" || relation.reviewStatus === "rejected" ? "rejected" : relation.reviewStatus ?? relation.status;
  return !status || !hiddenReviews.has(status);
};
const linkPairs = new Map<string, { a: string; b: string }>();
for (const star of stars) {
  for (const relation of star.entry.data.relations) {
    const other = starByKey.get(relation.target);
    if (!other || other.key === star.key || !isVisibleRelation(relation)) continue;
    const pairKey = [star.key, other.key].sort().join("|");
    linkPairs.set(pairKey, linkPairs.get(pairKey) ?? { a: star.key, b: other.key });
  }
}
const edges = [...linkPairs.values()];
const links = new Map(stars.map((star) => [star.key, [] as string[]]));
for (const edge of edges) {
  links.get(edge.a)?.push(edge.b);
  links.get(edge.b)?.push(edge.a);
}

/* Two coordinate sets, expressed in the same units as each board's viewBox: the wide
   one also covers the 6-column tablet board, because both centre a node at 1/6 and 5/6
   of the width. The mobile board stacks the same two-node bands one row at a time. */
const edgeGeometry = (cols: number, span: number, rowSpan: number, vbw: number, vbh: number) =>
  edges.map((edge) => {
    const point = (key: string) => {
      const star = starByKey.get(key)!;
      const startCol = star.side === "left" ? 0 : cols - span;
      return {
        x: +(((startCol + span / 2) / cols) * vbw).toFixed(2),
        y: +(((star.band * rowSpan + rowSpan / 2) / 6) * vbh).toFixed(2),
      };
    };
    return { ...edge, from: point(edge.a), to: point(edge.b) };
  });
const wideEdges = edgeGeometry(12, 4, 2, 400, 300);
const narrowEdges = edgeGeometry(4, 2, 1, 300, 400);

/* Deep sky behind the scene: deterministic dust of different sizes, colours and
   depths, split into three parallax layers. Depth is the translation amplitude in px. */
const tints = ["#dfeaff", "#7fd4f0", "#ffd9a8", "#b9a6ff", "#ffb9d6"];
const skyMotes = Array.from({ length: 54 }, (_, index) => {
  const seed = (n: number) => { const x = Math.sin((index + 1) * n) * 43758.5453; return x - Math.floor(x); };
  const bright = seed(3.7) > 0.82;
  return {
    layer: index % 3,
    x: +(seed(12.9898) * 100).toFixed(2),
    y: +(seed(78.233) * 100).toFixed(2),
    size: +(bright ? 2.4 + seed(2.3) * 1.2 : 1 + seed(5.1) * 1.2).toFixed(2),
    alpha: +(bright ? 0.6 + seed(9.4) * 0.32 : 0.24 + seed(4.4) * 0.42).toFixed(2),
    tint: tints[index % tints.length],
  };
});
const skyLayers = [0, 1, 2].map((layer) => skyMotes.filter((mote) => mote.layer === layer));
const skyDepths = [4, 8, 13];

const homepageJsonLd = {
  "@type": "ProfilePage",
  "@id": new URL("/#profile", Astro.site).href,
  url: new URL("/", Astro.site).href,
  name: "Стас Ермоленко — XR, AI-автоматизация, цифровые архивы и медиа",
  description: "Личная главная Станислава Ермоленко: пространственные XR-опыты, AI-автоматизация процессов и агенты, цифровые архивы и культура, медиа и образовательные продукты.",
  about: "XR, AI-автоматизация, цифровые архивы и медиа — для бизнеса, музеев и культурных проектов.",
  inLanguage: "ru-RU",
  mainEntity: { "@id": new URL("/#stanislav-ermolenko", Astro.site).href },
};
---

<Base title="Стас Ермоленко — XR, AI-автоматизация и цифровые архивы" description="XR-опыты и пространственные интерфейсы, AI-автоматизация и агенты, цифровые архивы, медиа и образовательные продукты. Работаю с бизнесом, музеями и культурными проектами." jsonLd={homepageJsonLd}>
  <div class="home-page">
    <section class="home-hero" data-scene aria-labelledby="home-title">
      <div class="home-sky" aria-hidden="true">
        <i class="sky-veil sky-veil-a" data-depth="3"></i>
        <i class="sky-veil sky-veil-b" data-depth="5"></i>
        <i class="sky-veil sky-veil-c" data-depth="7"></i>
        <i class="sky-band sky-band-a" data-depth="4"></i>
        <i class="sky-band sky-band-b" data-depth="6"></i>
        {skyLayers.map((layer, index) => <div class="sky-layer" data-depth={String(skyDepths[index])}>{layer.map((mote) => <i class="sky-mote" style={`left:${mote.x}%;top:${mote.y}%;--s:${mote.size}px;--o:${mote.alpha};--c:${mote.tint}`}></i>)}</div>)}
      </div>

      <div class="home-hero-copy">
        <h1 id="home-title" class="display">Всем 👋 привет,<br />это Стас!</h1>
        <p class="hero-lead">Делаю XR-пространства, AI-автоматизацию и цифровые архивы&nbsp;—&nbsp;для бизнеса, музеев и культурных проектов. Люблю задачи, где технология не шумит, а помогает людям работать, помнить и понимать.</p>
        <div class="hero-actions">
          <a class="button primary" href="/works/">Посмотреть работы</a>
          <a class="button quiet" href="mailto:stas@staniverse.xyz?subject=Проект для Стаса">Написать мне</a>
        </div>
      </div>

      <div class="home-constellation" data-depth="2.5">
        <div class="const-head">
          <span class="section-kicker">Живая карта связей</span>
        </div>
        <div class="const-board" data-const-board role="group" aria-label="Избранные работы и проекты и связи между ними">
          <svg class="const-edges const-edges-wide" viewBox="0 0 400 300" aria-hidden="true">
            {wideEdges.map((edge) => <line class="const-edge" x1={edge.from.x} y1={edge.from.y} x2={edge.to.x} y2={edge.to.y} data-edge-a={edge.a} data-edge-b={edge.b} />)}
          </svg>
          <svg class="const-edges const-edges-narrow" viewBox="0 0 300 400" aria-hidden="true">
            {narrowEdges.map((edge) => <line class="const-edge" x1={edge.from.x} y1={edge.from.y} x2={edge.to.x} y2={edge.to.y} data-edge-a={edge.a} data-edge-b={edge.b} />)}
          </svg>
          {stars.map((star) => (
            <a class="const-node" href={hrefFor(star.entry)} data-node={star.key} data-links={links.get(star.key)?.join(" ") ?? ""} data-band={star.band} data-side={star.side} data-tint={star.tint} data-title={star.entry.data.title} aria-describedby="const-status" style={`--mag:${star.mag}`}>
              <span class="const-figure" aria-hidden="true"><i class="const-glow"></i><i class="const-flare"></i><i class="const-core"></i></span>
              <span class="const-label"><span class="const-kind">{kindLabel[star.entry.data.kind] ?? "Материал"}</span><span class="const-name">{star.entry.data.title}</span></span>
            </a>
          ))}
        </div>
        <p class="const-status" id="const-status" data-const-status>Наведите, сфокусируйте или коснитесь звезды — подсветятся связанные работы и проекты.</p>
        <a class="const-universe-cta" href="/universe/">
          <span>Открыть XR-вселенную</span>
          <span class="const-universe-meta">3D · VR · AR <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <nav class="signal-strip" aria-label="Основные разделы">
      <a href="/works/"><strong>Работы</strong><span>реализованные работы</span></a>
      <a href="/projects/"><strong>Проекты</strong><span>собственные живые системы</span></a>
      <a href="/garden/"><strong>Сад</strong><span>публикации и темы</span></a>
      <button type="button" data-profile-open><strong>Обо мне</strong><span>опыт, навыки и контакты</span></button>
    </nav>

    <section class="section home-directions" aria-labelledby="directions-title">
      <div class="section-head">
        <div><div class="section-kicker">Направления</div><h2 id="directions-title">Один способ работы,<br class="home-break" /> четыре входа</h2></div>
        <a class="text-link" href="/works/">Все работы →</a>
      </div>
      <p class="section-copy">Чаще всего всё начинается с вопроса, что должно измениться. Бизнесу нужны процессы, предсказуемость и меньше ручной рутины; музеям и культурным институциям — сохранение, показ и разговор с посетителем; медиа- и образовательным проектам — сборка материала, тексты, видео и публикация. Ниже — четыре способа собрать такую работу.</p>
      <div class="directions-grid">
        {directions.map((direction) => (
          <article class="direction-tile">
            <span class="direction-icon" aria-hidden="true">
              {direction.icon === "xr" && <svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"></path><path d="m4.4 7.7 7.6 4.4 7.6-4.4M12 12.1V21"></path></svg>}
              {direction.icon === "ai" && <svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2"></circle><circle cx="6" cy="17" r="2"></circle><circle cx="18" cy="17" r="2"></circle><path d="m10.8 6.7-3.6 8.5m6-8.5 3.6 8.5M8 17h8"></path></svg>}
              {direction.icon === "archive" && <svg viewBox="0 0 24 24"><path d="m4 8 8-4 8 4-8 4-8-4Z"></path><path d="m4 12 8 4 8-4M4 16l8 4 8-4"></path></svg>}
              {direction.icon === "media" && <svg viewBox="0 0 24 24"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H12v18H7.5A3.5 3.5 0 0 0 4 23V5.5Z"></path><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H12v18h4.5A3.5 3.5 0 0 1 20 23V5.5Z"></path></svg>}
            </span>
            <h3>{direction.title}</h3>
            <p>{direction.text}</p>
            <div class="tag-row">{direction.tags.map((tag) => <span>{tag}</span>)}</div>
            <a class="direction-proof" href={direction.href}>{direction.proof} →</a>
          </article>
        ))}
      </div>
    </section>
    <section class="section" aria-labelledby="works-title"><div class="section-head"><div><div class="section-kicker">Избранные работы</div><h2 id="works-title">То, что стало<br class="home-break" /> реальным</h2></div><a class="text-link" href="/works/">Все работы →</a></div><div class="card-grid">{works.map((entry, i) => <ContentCard entry={entry} large={i === 0 || i === 3} showDate={false} />)}</div></section>

    <section class="section home-projects" aria-labelledby="projects-title">
      <div class="section-head"><div><div class="section-kicker">Собственные проекты</div><h2 id="projects-title">То, что продолжает<br class="home-break" /> двигаться</h2></div><a class="text-link" href="/projects/">Все проекты →</a></div>
      <p class="section-copy">Идеи, исследования и системы не обязаны быть законченными. У них есть статус, история и следующее действие.</p>
      <div class="card-grid">{projects.map((entry) => <ContentCard entry={entry} showDate={false} />)}</div>
    </section>
    <section class="section home-profile" aria-labelledby="home-profile-title">
      <div class="section-head">
        <div><div class="section-kicker">Профиль</div><h2 id="home-profile-title">Проектирую цифровой опыт —<br class="home-break" /> от исследования до работающей системы</h2></div>
        <a class="text-link" href="/about/">Обо мне →</a>
      </div>
      <div class="profile-band">
        <div class="profile-band-cell">
          <p class="profile-lead">Работаю на стыке XR, AI, веба и документального медиа: проектирую пространственный опыт, автоматизацию и системы, в которых технология помогает человеку помнить, понимать и присутствовать.</p>
          <div class="profile-facts"><span><strong>1994</strong><small>год рождения</small></span><span><strong>11+</strong><small>лет в медиа</small></span><span><strong>XR · AI · Web</strong><small>рабочий фокус</small></span><span><strong>СПб · из Вятки</strong><small>живу в Петербурге</small></span></div>
        </div>
        <div class="profile-band-cell">
          <span class="profile-label">Сейчас</span>
          <p class="profile-now-lead"><strong>Самозанятый · студент магистратуры ИТМО</strong></p>
          <p>Учусь в магистратуре ИТМО «Цифровые методы в гуманитарных исследованиях», веду <a href="https://t.me/staniverse" target="_blank" rel="noreferrer">Telegram-канал «станивёрс»</a>, иногда возвращаюсь к YouTube — <a href="https://www.youtube.com/@staniverse" target="_blank" rel="noreferrer">«станивёрс»</a> и <a href="https://www.youtube.com/@yatygorod" target="_blank" rel="noreferrer">«я.ты.город»</a>.</p>
          <button class="button quiet" type="button" data-profile-open>Полный профиль</button>
        </div>
      </div>
    </section>

    <section class="section home-invite" aria-labelledby="invite-title">
      <div class="home-invite-inner">
        <div>
          <div class="section-kicker">Разговор</div>
          <h2 id="invite-title">Расскажите,<br class="home-break" /> что у вас за задача</h2>
          <p class="section-copy">Опишите пару слов: что происходит, где узкое место и какой результат был бы достаточным. Отвечу честно, нужен ли здесь XR, AI или обычная аккуратная автоматизация, и предложу следующий шаг — без больших внедрений вслепую.</p>
        </div>
        <div class="home-invite-actions">
          <a class="button primary" href="mailto:stas@staniverse.xyz?subject=Проект для Стаса">Написать мне</a>
          <a class="button quiet" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Скачать CV</a>
          <a class="text-link" href="/contacts/">Другие контакты →</a>
        </div>
      </div>
    </section>

    <dialog class="profile-dialog" data-profile-dialog aria-labelledby="profile-title">
      <div class="profile-module">
      <form method="dialog" class="profile-close-form"><button class="profile-close" aria-label="Закрыть профиль">Закрыть ×</button></form>
      <div class="profile-heading"><div><div class="section-kicker">Профиль</div><h2 id="profile-title">Проектирую цифровой опыт —<br />от исследования до работающей системы</h2></div><a class="text-link" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Скачать CV ↗</a></div>
      <div class="profile-grid">
        <div class="profile-summary"><p>Работаю на стыке XR, AI, веба и документального медиа. Проектирую понятные интерфейсы, образовательные продукты и системы, в которых технология помогает человеку помнить, понимать и присутствовать.</p><div class="profile-facts"><span><strong>1994</strong><small>год рождения</small></span><span><strong>11+</strong><small>лет в медиа</small></span><span><strong>XR · AI · Web</strong><small>рабочий фокус</small></span><span><strong>СПб · из Вятки</strong><small>живу в Петербурге</small></span></div></div>
        <div class="profile-now"><span class="profile-label">Сейчас</span><strong>Самозанятый · студент магистратуры ИТМО</strong><p>Фриланс, автоматизация, GenAI, XR, веб и медиа. Учусь в магистратуре ИТМО «Цифровые методы в гуманитарных исследованиях» (2026 - н.в.).</p></div>
      </div>
      <details class="profile-details"><summary>Развернуть опыт, образование и инструменты <span aria-hidden="true">+</span></summary><div class="profile-details-grid">
        <div><span class="profile-label">Опыт</span><ul><li><strong>2025 - сейчас</strong> Специалист по информационным системам</li><li><strong>2023 - сейчас</strong> Самозанятый: автоматизация, GenAI, XR, Web, Media</li><li><strong>2023 - 2026</strong> Преподаватель и методист «Цифровых кафедр» ВятГУ; летом 2026 собрал курс «Основы продуктового менеджмента»</li><li><strong>2015 - 2023</strong> Оператор ЭВМ и куратор проектов Медиацентра ВятГУ</li></ul></div>
