---
import { existsSync, readdirSync } from "node:fs";
import Base from "../layouts/Base.astro";
import ContentCard from "../components/ContentCard.astro";
import { getCollection } from "astro:content";
import { allEntries } from "../lib/content";
import { buildGraph } from "../lib/graph";
import UniverseScene from "../components/universe/UniverseScene.astro";
import "../styles/universe.css";

const stars = Array.from({ length: 96 }, (_, i) => ({
  left: `${(i * 17.3) % 96}%`, top: `${(i * 29.7) % 88}%`,
  opacity: .35 + ((i * 7) % 8) * .1,
  size: 1.2 + ((i * 13) % 7) * .9,
  delay: `${((i * 11) % 40) / 10}s`, duration: `${2.6 + ((i * 19) % 30) / 10}s`,
}));
const workById = new Map((await getCollection("works")).map((entry) => [entry.data.id, entry]));
const works = ["work:virtualnyy-ofis-advokata", "work:maslenitsa-v-slobodskom", "work:ya-obmanyvat-sebya-ne-stanu", "work:arka-vyatskogo-kremlya"].flatMap((id) => {
  const entry = workById.get(id);
  return entry ? [entry] : [];
});
const projectById = new Map((await getCollection("projects")).map((entry) => [entry.data.id, entry]));
const projects = ["project:nearventure", "project:metavyatka", "project:albina", "project:omnipub", "project:mnemoform"].flatMap((id) => {
  const entry = projectById.get(id);
  return entry ? [entry] : [];
});
const entries = await allEntries();
const graph = buildGraph(entries);
const publicationCount = entries.filter((entry) => entry.collection === "publications").length;

/** Personal photo tile appears only when a real file exists; nothing is faked. */
const portraitFile = existsSync("public/assets") && readdirSync("public/assets").find((file) => /^stas-portrait\.(jpe?g|png|webp|avif)$/i.test(file));
const portraitSrc = portraitFile ? `/assets/${portraitFile}` : undefined;

const services = [
  {
    title: "AI-автоматизация бизнеса",
    text: "Встраиваю AI в уже работающие процессы: приём и уточнение заказов, создание сделок в CRM, документы, уведомления и следующие шаги. Человек сохраняет контроль, а рутина перестаёт съедать день.",
    tags: ["CRM", "n8n", "AI-агенты"],
    href: "/works/chertezhi-tekhdiplomy/",
    featured: true,
  },
  {
    title: "XR и пространственные продукты",
    text: "Собираю WebXR- и Unity-опыты, виртуальные офисы, AR-сцены и цифровые двойники. Могу подключиться к существующему продукту, разобраться в наследстве и довести идею до рабочего прототипа.",
    tags: ["WebXR", "Unity", "Three.js"],
    href: "/works/virtualnyy-ofis-advokata/",
    featured: true,
  },
  {
    title: "Персональные AI-агенты",
    text: "Настрою OpenClaw, Hermes или PicoClaw под ваши задачи, данные и привычный набор инструментов. А может, отговорю от этих клешней в пользу чего-то более простого и предсказуемого.",
    tags: ["OpenClaw", "Hermes", "PicoClaw"],
    href: "/projects/albina/",
    featured: false,
  },
  {
    title: "Контентные системы",
    text: "Не просто напишу пачку текстов: выстрою понятный процесс наполнения канала, сайта, каталога или медиатеки. Редакционный план, производство, автоматизация, публикация и передача команде.",
    tags: ["контент", "продакшн", "автоматизация"],
    href: "/works/prodakshn-dlya-ya-ty-gorod/",
    featured: false,
  },
  {
    title: "Исследования и программы ДПО",
    text: "Проведу прикладное исследование, соберу выводы в решение или разработаю образовательную программу для вуза и компании: учебный план, методички, оценочные средства и документы для согласования.",
    tags: ["исследования", "методическая работа", "образование"],
    href: "/works/prepodavanie-metodicheskaya-rabota-i-prodakshn-v-tsifrovykh-kafedrakh/",
    featured: false,
  },
];
const homepageJsonLd = {
  "@type": "ProfilePage",
  "@id": new URL("/#profile", Astro.site).href,
  url: new URL("/", Astro.site).href,
  name: "станивёрс — Станислав Ермоленко: AI-автоматизация и XR",
  description: "Портфолио и услуги Станислава Ермоленко: AI-автоматизация бизнес-процессов и CRM, AI-агенты, XR и WebXR, контентные системы, исследования и разработка ДПО.",
  inLanguage: "ru-RU",
  mainEntity: { "@id": new URL("/#stanislav-ermolenko", Astro.site).href },
};
---

<Base title="станивёрс" description="Станислав Ермоленко — AI-автоматизация бизнес-процессов и CRM, персональные AI-агенты, XR и WebXR, контентные системы, исследования и разработка ДПО." jsonLd={homepageJsonLd}>
  <div class="home-page">
    <section class="hero hero-full" aria-labelledby="home-title">
      <div class="hero-space" aria-hidden="true">
        <i class="nebula nebula-a" data-parallax="0.055"></i><i class="nebula nebula-b" data-parallax="0.1"></i>
        {[0, 1, 2].map((layer) => <div class="star-layer" data-parallax={String(.035 + layer * .035)}>{stars.filter((_, index) => index % 3 === layer).map((star) => <i class="star" style={`left:${star.left};top:${star.top};opacity:${star.opacity};--s:${star.size};--d:${star.delay};--t:${star.duration}`}></i>)}</div>)}
      </div>
      <div class="hero-copy">
        <p class="hero-hello">Всем привет, это Стас!</p>
        <h1 id="home-title" class="display">Помогаю внедрять<br />AI и XR —<br />без лишней магии</h1>
        <p class="hero-lead">Подключаю AI-агентов к реальным бизнес-процессам, собираю XR-опыты и сложные контентные системы. Могу войти в работающий проект, разобраться в наследстве и довести до предсказуемого результата — не обязательно начинать всё с нуля.</p>
        <div class="hero-actions"><a class="button primary" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Скачать CV</a><a class="button" href="/works/">Смотреть работы</a><a class="button" href="mailto:stas@staniverse.xyz?subject=Проект для Стаса">Обсудить проект</a><a class="button cosmic" href="/universe/">Войти во вселенную ↗</a></div>
      </div>
      <div class="hero-bento" aria-label="Коротко о сайте">
        {portraitSrc && <figure class="bento-tile bento-photo"><img src={portraitSrc} alt="Станислав Ермоленко" loading="eager" /></figure>}
        <div class="bento-tile bento-now"><span class="section-kicker">Сейчас</span><strong>ИТМО · 2026 - н.в.</strong><p>Учусь в магистратуре «Цифровые методы в гуманитарных исследованиях», веду Telegram-канал Staniverse и иногда возвращаюсь к YouTube.</p></div>
        <div class="bento-tile bento-stats"><span><strong>{workById.size}</strong><small>работ в каталоге</small></span><span><strong>{projectById.size}</strong><small>проектов в каталоге</small></span><span><strong>{publicationCount}</strong><small>публикации в архиве</small></span></div>
        <a class="bento-tile bento-cta" href="mailto:stas@staniverse.xyz?subject=Консультация"><strong>Начать с разбора?</strong><span>60 минут — 5 000 ₽. Разберём задачу и выберем следующий шаг без продажи лишней технологии →</span></a>
      </div>
    </section>

    <UniverseScene {graph} embedded />

    <nav class="signal-strip" aria-label="Основные разделы">
      <a href="/works/"><strong>Работы</strong><span>реализованные работы</span></a>
      <a href="/projects/"><strong>Проекты</strong><span>собственные живые системы</span></a>
      <a href="/garden/"><strong>Сад</strong><span>публикации и темы</span></a>
      <button type="button" data-profile-open><strong>Обо мне</strong><span>опыт, навыки и контакты</span></button>
    </nav>

    <section class="section home-services" aria-labelledby="services-title">
      <div class="section-head"><div><div class="section-kicker">Работа со мной</div><h2 id="services-title">Чем могу быть полезен</h2></div><a class="text-link" href="mailto:stas@staniverse.xyz?subject=Проект для Стаса">Обсудить проект →</a></div>
      <div class="services-grid">{services.map((service) => <article class:list={["service-tile", { "is-featured": service.featured }]}><h3>{service.title}</h3><p>{service.text}</p><div class="tag-row">{service.tags.map((tag) => <span>{tag}</span>)}</div><a class="service-proof" href={service.href}>Посмотреть похожий опыт →</a></article>)}</div>
      <p class="services-note"><strong>Не знаете, с чего начать?</strong> Можно взять отдельный разбор за 5 000 ₽ / 60 минут. За встречу разложим процесс, найдём узкое место и решим, нужен ли здесь AI, XR или обычная надёжная автоматизация. Большие внедрения оцениваю после диагностики и делю на этапы с понятным результатом.</p>
    </section>

    <dialog class="profile-dialog" data-profile-dialog aria-labelledby="profile-title">
      <div class="profile-module">
      <form method="dialog" class="profile-close-form"><button class="profile-close" aria-label="Закрыть профиль">Закрыть ×</button></form>
      <div class="profile-heading"><div><div class="section-kicker">Профиль</div><h2 id="profile-title">Режиссёр цифровых опытов,<br />исследователь и разработчик</h2></div><a class="text-link" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Скачать CV ↗</a></div>
      <div class="profile-grid">
        <div class="profile-summary"><p>Работаю на стыке XR, AI, веба и документального медиа. Собираю понятные интерфейсы, образовательные продукты и системы, в которых технология помогает человеку помнить, понимать и присутствовать.</p><div class="profile-facts"><span><strong>1994</strong><small>год рождения</small></span><span><strong>11+</strong><small>лет в медиа</small></span><span><strong>XR · AI · Web</strong><small>рабочий фокус</small></span><span><strong>СПб · из Вятки</strong><small>живу в Петербурге</small></span></div></div>
        <div class="profile-now"><span class="profile-label">Сейчас</span><strong>Самозанятый · АНО · ИТМО</strong><p>Фриланс, автоматизация, GenAI, XR, веб и медиа. Учусь в магистратуре ИТМО «Цифровые методы в гуманитарных исследованиях» (2026 - н.в.).</p></div>
      </div>
      <details class="profile-details"><summary>Развернуть опыт, образование и инструменты <span aria-hidden="true">+</span></summary><div class="profile-details-grid">
        <div><span class="profile-label">Опыт</span><ul><li><strong>2025 - сейчас</strong> Специалист по информационным системам в АНО</li><li><strong>2023 - сейчас</strong> Самозанятый: автоматизация, GenAI, XR, Web, Media</li><li><strong>2023 - 2026</strong> Преподаватель и методист «Цифровых кафедр» ВятГУ; летом 2026 собрал курс «Основы продуктового менеджмента»</li><li><strong>2015 - 2023</strong> Оператор ЭВМ и куратор проектов Медиацентра ВятГУ</li></ul></div>
        <div><span class="profile-label">Образование и курсы</span><ul><li><strong>2026 - н.в.</strong> ИТМО, магистратура «Цифровые методы в гуманитарных исследованиях» (Digital Humanities), 45.04.04</li><li><strong>2026</strong> Бакалавр ГМУ, ВятГУ</li><li><strong>2026</strong> Somnium Space Academy</li><li><strong>2026</strong> Agents Week, ШАД Яндекса</li><li><strong>2026</strong> Premasters Art&amp;Science, ИТМО</li><li><strong>2025</strong> VR-разработка на Unity и XR Interaction Toolkit, Stepik</li><li><strong>2024</strong> Интернет-маркетинг и юриспруденция, ДПО ВятГУ</li><li><strong>2024</strong> Digital Autumn: Changing Perspective, интенсив по XR</li><li><strong>2024</strong> Unity Essential Pathway</li><li><strong>2022</strong> «Современные цифровые технологии», ВятГУ</li><li><strong>2021</strong> Цифровые технологии в журналистике и PR, ДПО ВятГУ</li><li><strong>2015</strong> MB110x: Introduction to the Music Business</li><li><strong>2015</strong> BMPR365x: Vocal Recording Technology</li></ul></div>
        <div><span class="profile-label">Инструменты</span><p>XR: Unity · Blender · Substance · WebXR · 8th Wall · Three.js<br />AI: n8n · LangChain · Dify · Supabase · Neo4j · ComfyUI · Python<br />Харнессы и агенты: Claude Code · Codex · OpenCode · OpenClaw · Hermes · Pico Claw · pi<br />Веб: Astro · Tilda · WordPress · Telegram Bot API<br />Инфраструктура: Linux · Docker · Nginx · Home Assistant<br />Медиа: DaVinci Resolve · Premiere · Photoshop · OBS Studio</p></div>
        <div><span class="profile-label">Достижения</span><p>Призёр XV Молодёжных Дельфийских игр России в тележурналистике, победитель «МедиаМастер-2019», финалист конкурса студенческих медиапроектов форума «Пространство Евразии», Топ-10 ArtMasters-2025 в компетенции «Дизайнер виртуальных миров».</p></div>
      </div></details>
      <div class="profile-page-link"><a class="text-link" href="/about/">Открыть отдельную страницу и манифест →</a></div>
      </div>
    </dialog>

    <section class="section" aria-labelledby="works-title"><div class="section-head"><div><div class="section-kicker">Избранные работы</div><h2 id="works-title">То, что стало реальным</h2></div><a class="text-link" href="/works/">Все работы →</a></div><div class="card-grid">{works.map((entry, i) => <ContentCard entry={entry} large={i === 0 || i === 3} />)}</div></section>
    <section class="section home-projects" aria-labelledby="projects-title"><div class="section-head"><div><div class="section-kicker">Собственные проекты</div><h2 id="projects-title">То, что продолжает двигаться</h2></div><a class="text-link" href="/projects/">Все проекты →</a></div><p class="section-copy">Идеи, исследования и системы не обязаны быть законченными. У них есть статус, история и следующее действие.</p><div class="card-grid">{projects.map((entry) => <ContentCard entry={entry} />)}</div></section>
    <section class="section" aria-labelledby="path-title"><div class="section-head"><div><div class="section-kicker">Карта опыта</div><h2 id="path-title">Не лента, а система связей</h2></div></div><div class="about-grid"><div class="fact-panel"><h2>Сад</h2><p>Telegram-посты, статьи и видео можно фильтровать по темам, сущностям и типам. Текст сохраняет авторский голос, а связи живут отдельным вычисляемым слоем.</p><a class="text-link" href="/garden/">Исследовать каталог →</a></div><div class="fact-panel"><h2>Вселенная</h2><p>Полноэкранный кинематографический граф с генеративным звуком: самостоятельный режим исследования. Локальные графы на страницах объясняют ближайший контекст.</p><a class="text-link" href="/universe/">Начать полёт →</a></div></div></section>
  </div>

  <script>
    import { mountUniverse } from "../components/universe/UniverseRuntime";
    mountUniverse();
    const dialog = document.querySelector<HTMLDialogElement>("[data-profile-dialog]");
    const trigger = document.querySelector<HTMLButtonElement>("[data-profile-open]");
    trigger?.addEventListener("click", () => dialog?.showModal());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Gentle depth on the hero + section reveals; nothing moves when the visitor asked for calm.
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!calm) {
      const layers = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
      let frame = 0;
      const onScroll = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const y = scrollY;
          for (const layer of layers) layer.style.translate = `0 ${(y * Number(layer.dataset.parallax)).toFixed(1)}px`;
        });
      };
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      // Section reveals live in the shared Base script so every page shares one system.
    }
  </script>
</Base>

<style>
  .home-page { --home-accent: #65ddf2; --home-ink: #f1f5ff; --home-muted: #9cafc9; --home-line: rgba(116, 157, 198, .22); }

  /* Desktop hero fills the viewport below the real sticky header, not a second screen. */
  .home-page .hero-full { min-height: calc(100svh - 4.9rem); display: grid; align-content: center; padding-block: clamp(3rem, 6vh, 4.5rem); }
  @media (min-width: 1000px) { .home-page .hero-full { grid-template-columns: minmax(0, 1.12fr) minmax(20rem, .88fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; } }
  .home-page .hero-copy { max-width: 52rem; }
  .hero-hello { margin: 0 0 .7rem; color: var(--home-accent); font-size: clamp(1rem, 1.4vw, 1.3rem); font-weight: 500; letter-spacing: .01em; }
  .home-page .display { color: var(--home-ink); max-width: 11ch; font-size: clamp(2.4rem, 4.15vw, 3.6rem); }

  /* Deep-sky backdrop: layered nebulae + a dense twinkling starfield. */
  .home-page .hero-space { inset: 0; background: radial-gradient(circle at 76% 35%, rgba(61, 122, 219, .2), transparent 26rem), radial-gradient(circle at 88% 62%, rgba(35, 205, 234, .16), transparent 22rem); }
  .home-page .hero-space::before { border-color: rgba(73, 133, 220, .27); } .home-page .hero-space::after { border-color: rgba(100, 223, 244, .25); }
  .star-layer { position: absolute; inset: 0; will-change: translate; }
  .nebula { position: absolute; border-radius: 50%; filter: blur(46px); pointer-events: none; }
  .nebula-a { top: 8%; right: 4%; width: 30rem; height: 22rem; background: rgba(64, 88, 190, .16); }
  /* Desktop balance: smaller, dimmer rings and a capped portrait keep the copy in charge. */
  @media (min-width: 1000px) {
    .home-page .hero-space::before { width: min(34vw, 28rem); border-color: rgba(73, 133, 220, .18); }
    .home-page .hero-space::after { width: min(23vw, 17rem); border-color: rgba(100, 223, 244, .14); }
    .bento-photo img { max-height: 11rem; }
  }
  .home-page .star { width: calc(var(--s, 2) * 1px); height: calc(var(--s, 2) * 1px); background: #d6f9ff; box-shadow: 0 0 calc(var(--s, 2) * 4px) calc(var(--s, 2) * 1.4px) rgba(100, 223, 244, .5); animation: twinkle var(--t, 3s) ease-in-out var(--d, 0s) infinite alternate; }
  @keyframes twinkle { from { opacity: .25; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .home-page .star { animation: none; } }

  .hero-bento { display: grid; gap: clamp(.65rem, 1vw, .85rem); }
  .bento-tile { min-width: 0; padding: clamp(.9rem, 1.25vw, 1.1rem) clamp(1rem, 1.5vw, 1.2rem); border: 1px solid var(--home-line); border-radius: .85rem; background: rgba(10, 15, 26, .72); backdrop-filter: blur(8px); }
  .bento-now strong { display: block; margin: .4rem 0 .35rem; color: var(--home-ink); font-size: clamp(.95rem, 1.1vw, 1.05rem); }
  .bento-now p { margin: 0; color: var(--home-muted); font-size: clamp(.78rem, .85vw, .84rem); line-height: 1.5; text-wrap: pretty; }
  .bento-photo { margin: 0; overflow: hidden; padding: 0; }
  .bento-photo img { display: block; width: 100%; height: 100%; max-height: 14rem; object-fit: cover; }
  .bento-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .bento-stats span { display: grid; align-content: start; gap: .2rem; }
  .bento-stats strong { color: var(--home-ink); font: 500 clamp(1.25rem, 1.7vw, 1.7rem)/1 Unbounded; }
  .bento-cta { display: grid; gap: .35rem; border-color: rgba(101, 221, 242, .4); background: linear-gradient(140deg, rgba(20, 52, 71, .75), rgba(10, 15, 26, .8)); }
  .bento-cta strong { color: var(--home-ink); font-size: clamp(.9rem, 1vw, 1rem); }
  .bento-cta span { color: var(--home-accent); font-size: clamp(.76rem, .85vw, .84rem); line-height: 1.45; text-wrap: pretty; }
  .bento-cta:hover, .bento-cta:focus-visible { border-color: var(--home-accent); }

  .home-page .section-kicker, .home-page .profile-label { color: var(--home-muted); }
  .home-page .hero-lead, .home-page .section-copy { color: var(--home-muted); }
  .home-page .button.primary, .home-page .profile-facts strong { background: var(--home-accent); border-color: var(--home-accent); color: #06131a; }
  .home-page .button.cosmic { border-color: #426b89; background: #102331; } .home-page .text-link, .home-page .profile-details summary span { color: var(--home-accent); }

  /* Services: concrete offers, no card zoo. */
  .home-services { background: #0a0f1a; }
  .services-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; border-block: 1px solid var(--home-line); background: var(--home-line); }
  .service-tile { container-type: inline-size; grid-column: span 2; min-width: 0; padding: clamp(1.35rem, 2.2vw, 2rem); background: #0a0f1a; }
  .service-tile.is-featured { grid-column: span 3; background: linear-gradient(145deg, #0d1724, #0a0f1a 72%); }
  .service-tile h3 { margin: 0 0 .6rem; color: var(--home-ink); font: 500 var(--card-title)/1.25 Unbounded; letter-spacing: -.02em; }
