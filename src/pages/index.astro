---
import Base from "../layouts/Base.astro";
import ContentCard from "../components/ContentCard.astro";
import { getCollection } from "astro:content";
import { isCommissionedWork } from "../lib/canonical";

const stars = Array.from({ length: 22 }, (_, i) => ({
  left: `${8 + ((i * 37) % 88)}%`, top: `${7 + ((i * 53) % 82)}%`, opacity: .35 + (i % 5) * .13,
}));
const workById = new Map((await getCollection("works")).filter(isCommissionedWork).map((entry) => [entry.data.id, entry]));
const works = ["work:virtualnyy-ofis-advokata", "work:tsifrovaya-stsenografiya-dlya-nomera-na-artmasters", "work:otborochnaya-rabota-artmasters", "work:sayt-advokata-antona-okulova"].flatMap((id) => {
  const entry = workById.get(id);
  return entry ? [entry] : [];
});
const projects = (await getCollection("projects")).filter((entry) => entry.data.featured).filter((entry) => ["project:albina", "project:metavyatka", "project:mnemoform", "project:nearventure"].includes(entry.data.id)).slice(0, 4);
---

<Base title="Staniverse" description="Портфолио и цифровой сад Станислава Ермоленко: XR, AI, медиа и собственные цифровые проекты.">
  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-space" aria-hidden="true">{stars.map((star) => <i class="star" style={`left:${star.left};top:${star.top};opacity:${star.opacity}`}></i>)}</div>
      <div class="hero-copy">
        <div class="section-kicker">Станислав Ермоленко · Вятка</div>
        <h1 id="home-title" class="display">Соединяю<br />вещи и смотрю,<br />что получится</h1>
        <p class="hero-lead">XR, AI, медиа и цифровые продукты. Здесь собраны мои работы, собственные проекты, публикации и связи, которые показывают, как один опыт приводит к следующему.</p>
        <div class="hero-actions"><a class="button primary" href="/works/">Смотреть работы</a><a class="button" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Скачать CV</a><a class="button cosmic" href="/universe/">Войти во вселенную ↗</a></div>
      </div>
    </section>

    <nav class="signal-strip" aria-label="Основные разделы">
      <a href="/works/"><strong>Работы</strong><span>реализовано для других</span></a>
      <a href="/projects/"><strong>Проекты</strong><span>собственные живые системы</span></a>
      <a href="/garden/"><strong>Сад</strong><span>публикации и темы</span></a>
      <a href="/about/"><strong>Обо мне</strong><span>опыт, навыки и контакты</span></a>
    </nav>

    <section class="profile-module" aria-labelledby="profile-title">
      <div class="profile-heading"><div><div class="section-kicker">Профиль</div><h2 id="profile-title">Режиссёр цифровых опытов,<br />исследователь и разработчик</h2></div><a class="text-link" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Скачать CV ↗</a></div>
      <div class="profile-grid">
        <div class="profile-summary"><p>Работаю на стыке XR, AI, веба и документального медиа. Собираю понятные интерфейсы, образовательные продукты и системы, в которых технология помогает человеку помнить, понимать и присутствовать.</p><div class="profile-facts"><span><strong>11+</strong><small>лет в медиа</small></span><span><strong>XR · AI · Web</strong><small>рабочий фокус</small></span><span><strong>Вятка</strong><small>место и контекст</small></span></div></div>
        <div class="profile-now"><span class="profile-label">Сейчас</span><strong>Фриланс · АНО · ИТМО</strong><p>Автоматизация, GenAI, XR, веб и медиа. С сентября 2026 года магистратура ИТМО «Цифровые методы в гуманитарных исследованиях».</p></div>
      </div>
      <details class="profile-details"><summary>Развернуть опыт, образование и инструменты <span aria-hidden="true">+</span></summary><div class="profile-details-grid">
        <div><span class="profile-label">Опыт</span><ul><li><strong>2025 - сейчас</strong> Специалист по информационным системам в АНО</li><li><strong>2023 - сейчас</strong> Фриланс: автоматизация, GenAI, XR, Web, Media</li><li><strong>2023 - 2025</strong> Преподаватель и методист «Цифровых кафедр» ВятГУ</li><li><strong>2015 - 2023</strong> Куратор проектов Медиацентра ВятГУ</li></ul></div>
        <div><span class="profile-label">Образование и курсы</span><ul><li><strong>2026 - сейчас</strong> ИТМО, магистратура «Цифровые методы в гуманитарных исследованиях», 45.04.04</li><li><strong>2026</strong> Бакалавриат ГМУ, ВятГУ; Somnium Space Academy; Agents Week ШАД</li><li><strong>2025</strong> VR-разработка на Unity, XR Interaction Toolkit, Stepik</li><li><strong>2015 - 2024</strong> Berklee edX, цифровые технологии в журналистике и PR, интернет-маркетинг, юриспруденция, Unity Essential Pathway</li></ul></div>
        <div><span class="profile-label">Инструменты</span><p>Unity · Blender · Substance · WebXR · Three.js · n8n · Claude Code · LangChain · Dify · Supabase · Neo4j · ComfyUI · Python · Astro · Tilda · WordPress · Telegram Bot API · Linux · Docker · DaVinci Resolve · Premiere · Photoshop · OBS Studio</p></div>
        <div><span class="profile-label">Достижения</span><p>Призёр XV Молодёжных Дельфийских игр России в тележурналистике, победитель «МедиаМастер-2019», финалист ArtMasters-2025 в направлении «Дизайнер виртуальных миров».</p></div>
      </div></details>
    </section>

    <section class="section" aria-labelledby="works-title"><div class="section-head"><div><div class="section-kicker">Избранные работы</div><h2 id="works-title">То, что стало реальным</h2></div><a class="text-link" href="/works/">Все работы →</a></div><div class="card-grid">{works.map((entry, i) => <ContentCard entry={entry} large={i === 0} />)}</div></section>
    <section class="section home-projects" aria-labelledby="projects-title"><div class="section-head"><div><div class="section-kicker">Собственные проекты</div><h2 id="projects-title">То, что продолжает двигаться</h2></div><a class="text-link" href="/projects/">Все проекты →</a></div><p class="section-copy">Идеи, исследования и системы не обязаны быть законченными. У них есть статус, история и следующее действие.</p><div class="card-grid">{projects.map((entry) => <ContentCard entry={entry} />)}</div></section>
    <section class="section" aria-labelledby="path-title"><div class="section-head"><div><div class="section-kicker">Карта опыта</div><h2 id="path-title">Не лента, а система связей</h2></div></div><div class="about-grid"><div class="fact-panel"><h2>Сад</h2><p>Telegram-посты, статьи и видео можно фильтровать по темам, сущностям и типам. Текст сохраняет авторский голос, а связи живут отдельным вычисляемым слоем.</p><a class="text-link" href="/garden/">Исследовать каталог →</a></div><div class="fact-panel"><h2>Вселенная</h2><p>Полноэкранный кинематографический граф с генеративным звуком — самостоятельный режим исследования. Локальные графы на страницах объясняют ближайший контекст.</p><a class="text-link" href="/universe/">Начать полёт →</a></div></div></section>
  </div>
</Base>

<style>
  .home-page { --home-accent: #65ddf2; --home-ink: #f1f5ff; --home-muted: #9cafc9; --home-line: rgba(116, 157, 198, .22); }
  .home-page .hero { min-height: 76vh; }
  .home-page .hero-space { background: radial-gradient(circle at 76% 35%, rgba(61, 122, 219, .22), transparent 15rem), radial-gradient(circle at 88% 62%, rgba(35, 205, 234, .18), transparent 13rem); }
  .home-page .hero-space::before { border-color: rgba(73, 133, 220, .27); } .home-page .hero-space::after { border-color: rgba(100, 223, 244, .25); }
  .home-page .star { background: #d6f9ff; box-shadow: 0 0 16px 5px rgba(100, 223, 244, .58); }
  .home-page .section-kicker, .home-page .profile-label { color: var(--home-muted); } .home-page .display { color: var(--home-ink); max-width: 9ch; }
  .home-page .hero-lead, .home-page .section-copy { color: var(--home-muted); }
  .home-page .button.primary, .home-page .profile-facts strong { background: var(--home-accent); border-color: var(--home-accent); color: #06131a; }
  .home-page .button.cosmic { border-color: #426b89; background: #102331; } .home-page .text-link, .home-page .profile-details summary span { color: var(--home-accent); }
  .home-page .signal-strip > a:hover, .home-page .signal-strip > a:focus-visible { background: #0d1724; }
  .profile-module { max-width: 1400px; margin: 0 auto; padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1rem, 7vw, 7rem); border-bottom: 1px solid var(--home-line); }
  .profile-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2rem; } .profile-heading h2 { margin: .35rem 0 0; color: var(--home-ink); font: 500 clamp(2rem, 4vw, 4rem)/1.05 Unbounded; letter-spacing: -.045em; text-wrap: balance; }
  .profile-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(260px, .75fr); gap: clamp(2rem, 7vw, 7rem); padding: 1.5rem 0; border-top: 1px solid var(--home-line); }
  .profile-summary p { max-width: 52rem; margin: 0; color: var(--home-ink); font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.45; } .profile-facts { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 2rem; }
  .profile-facts span { display: grid; gap: .25rem; } .profile-facts strong { width: fit-content; padding: .18rem .45rem; font-size: .9rem; font-weight: 500; } .profile-facts small { color: var(--home-muted); font-size: .72rem; }
  .profile-now { border-left: 1px solid var(--home-line); padding-left: 1.5rem; } .profile-now strong { display: block; margin: .65rem 0 .5rem; color: var(--home-ink); font-size: 1.1rem; } .profile-now p, .profile-details-grid p, .profile-details-grid li { color: var(--home-muted); font-size: .82rem; line-height: 1.55; } .profile-now p { margin: 0; }
  .profile-details { margin-top: 1rem; border-top: 1px solid var(--home-line); } .profile-details summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; color: var(--home-ink); cursor: pointer; font-size: .86rem; list-style: none; } .profile-details summary::-webkit-details-marker { display: none; } .profile-details[open] summary { border-bottom: 1px solid var(--home-line); }
  .profile-details-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; padding-top: 1.5rem; } .profile-details-grid ul { display: grid; gap: .75rem; margin: .8rem 0 0; padding: 0; list-style: none; } .profile-details-grid li strong { display: block; color: var(--home-ink); font-size: .72rem; font-weight: 500; } .profile-details-grid p { margin: .8rem 0 0; }
  .home-projects { background: #0a0f1a; } .home-page .content-card { border-color: var(--home-line); } .home-page .content-card:hover, .home-page .content-card:focus-visible { border-color: #58739a; }
  @media (max-width: 900px) { .profile-grid { grid-template-columns: 1fr; } .profile-now { border-top: 1px solid var(--home-line); border-left: 0; padding: 1.5rem 0 0; } .profile-details-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .home-page .hero { min-height: 76vh; } .home-page .display { max-width: 100%; font-size: clamp(2.6rem, 12vw, 4.5rem); } .profile-heading { align-items: start; flex-direction: column; gap: .8rem; } .profile-heading h2 { font-size: clamp(1.8rem, 9vw, 2.8rem); } .profile-details-grid { grid-template-columns: 1fr; } .profile-facts { gap: 1rem 1.5rem; } }
</style>
