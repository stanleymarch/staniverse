  .const-flare::after { position: absolute; top: 50%; left: 50%; width: 460%; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--tint) 70%, transparent), transparent); content: ""; transform: translate(-50%, -50%); }
  .const-flare::after { transform: translate(-50%, -50%) rotate(90deg); }

  .const-label { position: absolute; top: calc(50% + var(--s-3)); left: 50%; display: grid; gap: var(--s-1); width: max-content; max-width: 100%; padding: .4rem .6rem; border: 1px solid var(--glass-line); border-radius: 10px; background: var(--glass); box-shadow: var(--glass-hi); backdrop-filter: blur(12px) saturate(1.4); -webkit-backdrop-filter: blur(12px) saturate(1.4); translate: -50% 0; text-align: center; transition: translate var(--dur-2) var(--ease), rotate var(--dur-2) var(--ease), opacity var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease); }
