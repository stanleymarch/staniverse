---
import Base from "../../layouts/Base.astro";
---

<Base title="Технологии и лицензии" description="Открытые технологии, шрифты и лицензии, используемые при создании станивёрса.">
  <article class="licenses-page content-shell">
    <header class="licenses-hero">
      <p class="section-kicker">Открытая инфраструктура</p>
