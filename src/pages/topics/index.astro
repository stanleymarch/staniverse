---
import Base from "../../layouts/Base.astro";
import { allEntries } from "../../lib/content";
import { getCollection } from "astro:content";
import { collectTopics } from "../../lib/topics";
const topics = collectTopics(await allEntries(), true);
const [section] = await getCollection("sections", (entry) => entry.id === "topics");
---
<Base title={section.data.title} description={section.data.summary}>
  <header class="catalog-hero"><div class="section-kicker">{section.data.kicker}</div></header>
  <section class="section" aria-labelledby="topic-index-title"><div class="section-head"><div><div class="section-kicker">Указатель</div><h2 id="topic-index-title">Выберите направление</h2></div><a class="text-link" href="/garden/">Все материалы и фильтры в Саду →</a></div><div class="topic-cloud">{topics.map((topic) => <a href={`/topics/${topic.slug}/`}><strong>{topic.name}</strong><span>{topic.entries.length} материалов</span></a>)}</div></section>
</Base>
