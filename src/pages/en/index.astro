  .profile-band { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 1px; border-block: 1px solid var(--line); background: var(--line); }
  .profile-band-cell { display: grid; align-content: start; gap: var(--s-3); min-width: 0; padding: var(--s-5) var(--s-4); background: var(--ground); }
  .profile-lead { max-width: 48rem; margin: 0; color: var(--ink); font-size: clamp(1.02rem, 1.5vw, 1.25rem); line-height: 1.5; text-wrap: pretty; }
