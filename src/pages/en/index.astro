    .const-edge { stroke-dasharray: none; }
    .sky-mote, .const-edge, .const-label, .const-glow, .const-node::after, .direction-tile::after, .direction-tile h3, .profile-close { transition: none; }
    .const-node:hover .const-label, .const-node:focus-visible .const-label { translate: -50% 0; rotate: none; }
    .direction-tile:hover h3, .direction-tile:focus-within h3 { translate: none; }
  }
