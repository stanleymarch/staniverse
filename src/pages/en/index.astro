  .const-board { position: relative; display: grid; grid-template-columns: repeat(var(--cols, 12), minmax(0, 1fr)); grid-template-rows: repeat(6, minmax(0, 1fr)); aspect-ratio: 4 / 3; min-width: 0; --cols: 12; --span: 4; --row-span: 2; }
  @media (max-width: 1050px) { .home-constellation { width: 100%; max-width: 34rem; margin-inline: auto; } .const-board { --cols: 6; --span: 2; } }
  @media (max-width: 700px) { .const-board { --cols: 4; --span: 2; --row-span: 1; aspect-ratio: 3 / 4; } }

  .const-edges { position: absolute; inset: 0; width: 100%; height: 100%; }
  .const-edges-narrow { display: none; }
  @media (max-width: 700px) { .const-edges-wide { display: none; } .const-edges-narrow { display: block; } }
  .const-edge { stroke: color-mix(in srgb, var(--ink) 40%, transparent); stroke-width: 1; stroke-linecap: round; stroke-dasharray: 6 5; vector-effect: non-scaling-stroke; animation: const-drift calc(var(--dur-3) * 13) linear infinite; transition: stroke var(--dur-2) var(--ease), stroke-width var(--dur-2) var(--ease); }
  .const-edge.is-hot { stroke: color-mix(in srgb, var(--accent) 92%, transparent); stroke-width: 1.5; animation-duration: calc(var(--dur-3) * 4); }
  .const-edge.is-dim { stroke: color-mix(in srgb, var(--ink) 12%, transparent); }
  @keyframes const-drift { to { stroke-dashoffset: -11; } }

  .const-node { position: relative; display: block; margin: var(--s-1); min-width: 0; min-height: 44px; --tint: var(--accent); --mag-scale: 1; }
  .const-node:hover,
  .const-node.is-hot { --mag-scale: 1.3; }
  .const-node[data-side="left"] { grid-column: 1 / span var(--span); }
  .const-node[data-side="right"] { grid-column: calc(var(--cols) - var(--span) + 1) / span var(--span); }
  .const-node[data-band="0"] { grid-row: 1 / span var(--row-span); }
  .const-node[data-band="1"] { grid-row: 3 / span var(--row-span); }
  .const-node[data-band="2"] { grid-row: 5 / span var(--row-span); }

  /* A star: bright core, soft halo, and two diffraction spikes. */
  .const-figure { position: absolute; top: 50%; left: 50%; width: calc(var(--mag, 8) * 1px * var(--mag-scale, 1)); aspect-ratio: 1; translate: -50% -50%; }
  .const-glow { position: absolute; inset: -340%; border-radius: var(--radius-pill); background: radial-gradient(closest-side, color-mix(in srgb, var(--tint) 40%, transparent), transparent 76%); opacity: .72; transition: opacity var(--dur-2) var(--ease); }
  .const-core { position: absolute; inset: 0; border-radius: var(--radius-pill); background: radial-gradient(circle, var(--ink) 0 24%, var(--tint) 52%, color-mix(in srgb, var(--tint) 45%, transparent) 100%); box-shadow: 0 0 calc(var(--mag, 8) * .9px) color-mix(in srgb, var(--tint) 60%, transparent); }
  .const-flare::before,
  .const-flare::after { position: absolute; top: 50%; left: 50%; width: 460%; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--tint) 70%, transparent), transparent); content: ""; transform: translate(-50%, -50%); }
  .const-flare::after { transform: translate(-50%, -50%) rotate(90deg); }

  .const-label { position: absolute; top: calc(50% + var(--s-3)); left: 50%; display: grid; gap: var(--s-1); width: max-content; max-width: 100%; translate: -50% 0; text-align: center; text-shadow: 0 1px 6px var(--ground); transition: translate var(--dur-2) var(--ease), rotate var(--dur-2) var(--ease), opacity var(--dur-2) var(--ease); }
  .const-kind { color: color-mix(in srgb, var(--ink) 45%, var(--ink-2)); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; }
  .const-name { color: var(--ink); font-size: .84rem; line-height: 1.25; text-wrap: balance; hyphens: auto; }

  .const-node.is-hot .const-glow,
  .const-node.is-linked .const-glow { opacity: 1; }
  .const-node.is-dim .const-figure,
  .const-node.is-dim .const-label { opacity: .4; }
  .const-node::after { position: absolute; top: 50%; left: 50%; width: calc(var(--mag, 8) * 3.4px * var(--mag-scale, 1)); aspect-ratio: 1; translate: -50% -50%; border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); border-radius: var(--radius-pill); content: ""; opacity: 0; transition: opacity var(--dur-2) var(--ease); }
