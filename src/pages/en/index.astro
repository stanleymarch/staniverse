---
import Base from "../../layouts/Base.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";
import { hrefFor, type AnyEntry } from "../../lib/content";

/* Same curated lists as the Russian home: nothing is derived from a full
   catalogue pass here either, so the first screen stays as cheap in English. */
const entryById = new Map<string, AnyEntry>();
for (const entry of [...(await getCollection("works")), ...(await getCollection("projects")), ...(await getCollection("articles"))]) entryById.set(entry.data.id, entry);
const pick = (ids: string[]) => ids.flatMap((id) => { const entry = entryById.get(id); return entry ? [entry] : []; });

const works = pick(["work:virtualnyy-ofis-advokata", "work:maslenitsa-v-slobodskom", "work:ya-obmanyvat-sebya-ne-stanu", "work:arka-vyatskogo-kremlya"]);
const projects = pick(["project:nearventure", "project:metavyatka", "project:albina", "project:omnipub", "project:mnemoform"]);

/* Only four project pages exist in English so far. Every other link keeps the
   Russian original: a translation must never send a reader into a dead route. */
const translatedProjects: Record<string, string> = {
  "project:metavyatka": "/en/projects/metavyatka/",
  "project:ya-ty-gorod": "/en/projects/ya-ty-gorod/",
  "project:mnemoform": "/en/projects/mnemoform/",
  "project:staniverse": "/en/projects/staniverse/",
};
const hrefOf = (entry: AnyEntry) => translatedProjects[entry.data.id] ?? hrefFor(entry);

const kindNames: Record<string, string> = { work: "Work", project: "Own project" };
const statusNames: Record<string, string> = {
  ongoing: "Ongoing",
  completed: "Completed",
  idea: "Idea",
  planned: "Planned",
  development: "In development",
  active: "Active",
  paused: "Paused",
  archived: "Archived",
};
const kindOf = (entry: AnyEntry) => kindNames[entry.data.kind] ?? "Material";
const statusOf = (entry: AnyEntry) => ("status" in entry.data ? statusNames[entry.data.status as string] : undefined);
/* Only tags that are Russian words get a translated chip: the card keeps the
   Russian tag list for filtering, so nothing here may touch data-tags. */
const tagNames: Record<string, string> = { "киров/вятка": "kirov/vyatka" };
const tagsOf = (entry: AnyEntry) => {
  const tags = entry.data.tags.slice(0, 4);
  return tags.some((tag) => tagNames[tag]) ? tags.map((tag) => tagNames[tag] ?? tag) : undefined;
};

/* The works and projects quoted by the cards below: the English titles and
   summaries mirror the Russian entries word for word, ellipses included. */
const copy: Record<string, { title: string; summary: string }> = {
  "work:virtualnyy-ofis-advokata": {
    title: "Virtual office for a lawyer",
    summary: "Build a virtual office for a lawyer that works as a space for consultations, professional conversation and public talks rather than a decorative 3D location. Alongside it — build a personal…",
  },
  "work:maslenitsa-v-slobodskom": {
    title: "Maslenitsa in Slobodskoy",
    summary: "Create a social VR experience on the Somnium Space platform that lets a European audience immerse themselves in the Russian Maslenitsa tradition — against the real architecture of Cathedral Square in the town of Slobodskoy.",
  },
  "work:ya-obmanyvat-sebya-ne-stanu": {
    title: "I won't deceive myself",
    summary: "Final work at ArtMasters (Virtual World Designer category, August 2025). Digital scenography for a multimedia piece marking the 130th anniversary of Sergei Yesenin.",
  },
  "work:arka-vyatskogo-kremlya": {
    title: "The Arch of the Vyatka Kremlin",
    summary: "Preserve and rethink in digital form a people's landmark of Kirov, draw attention to it and show how local cultural heritage can live in the metaverse, beyond the physical vulnerability of the original…",
  },
  "project:nearventure": {
    title: "Nearventure",
    summary: "A micro-adventure planner: you set the time and the way you travel, and get a route through interesting places with a map, elevation data and GPX.",
  },
  "project:metavyatka": {
    title: "MetaVyatka",
    summary: "MetaVyatka is an unfinished digital archive and XR project about Vyatka, already presented in festival applications and individual digital conservation cases. Its further directions include growing the sound archive, a Next.js catalogue, an AI guide with RAG and moving the worlds to BasisVR; the readiness of these planned systems is not claimed.",
  },
  "project:albina": {
    title: "Albina",
    summary: "Albina is an embodied AI persona with memory, character, voice and several modes of presence. What interests me here is not simply a “chatbot with an avatar” but a digital entity that has a behavioural frame, a visual…",
  },
  "project:omnipub": {
    title: "OmniPub",
    summary: "OmniPub is a content autopilot and editorial pipeline for media that need order in the flow of sources. I am building a system where automation removes the manual routine without killing taste, editorial control and…",
  },
  "project:mnemoform": {
    title: "Mnemoform",
    summary: "Mnemoform is a project about translating memories, bodily signals and personal stories into tangible forms — not only physical objects, but also generative graphics and sound. What interests me here is not an abstract art metaphor but…",
  },
};

/* Four concrete practices, each backed by a real entry. The audience statement
   stays narrower than the skills list: no invented client segment for symmetry. */
const directions = [
  {
    title: "XR and spatial experiences",
    text: "Virtual offices, VR scenes, AR try-ons, digital twins and exhibition worlds. I build them in Unity and WebXR so that a space has a script, not only geometry.",
    tags: ["WebXR", "Unity", "Blender"],
    entryId: "work:virtualnyy-ofis-advokata",
    proof: "Virtual office for a lawyer",
  },
  {
    title: "AI automation and agents",
    text: "I bring models, data and tools into understandable working processes. In practice that runs from research and documents to a knowledge system where decisions and taste stay with people.",
    tags: ["agents", "Obsidian", "automation"],
    entryId: "article:ai-diploma",
    proof: "How I defended my thesis with AI agents",
  },
  {
    title: "Digital archives and culture",
    text: "Photogrammetry, sound, local history and museum collections in a format that lives online, in a headset and on a screen in the hall. With attention to the source and to rights.",
    tags: ["photogrammetry", "archives", "heritage"],
    entryId: "project:metavyatka",
    proof: "MetaVyatka — the archive of Vyatka",
  },
  {
    title: "Media and education",
    text: "Documentary stories, texts, video and teaching materials: from the idea and the shoot to an educational product, a publication and a handover to the team.",
    tags: ["media", "education", "professional training"],
    entryId: "work:prepodavanie-metodicheskaya-rabota-i-prodakshn-v-tsifrovykh-kafedrakh",
    proof: "Teaching, methodology and production",
  },
].flatMap((direction) => {
  const entry = entryById.get(direction.entryId);
  return entry ? [{ ...direction, href: hrefOf(entry) }] : [];
});

/* ---------------------------------------------------------------------------
   Living map: a constellation of real works and projects. Layout is a two-node
   band grid, so star centres always land on the cell centres the edges use.
   --------------------------------------------------------------------------- */
type SkyStar = { key: string; entry: AnyEntry; band: 0 | 1 | 2; side: "left" | "right"; tint: string; mag: number };

const skyPlan: Omit<SkyStar, "entry">[] = [
  { key: "work:virtualnyy-ofis-advokata", band: 0, side: "left", tint: "cyan", mag: 13 },
  { key: "work:arka-vyatskogo-kremlya", band: 0, side: "right", tint: "amber", mag: 10 },
  { key: "project:albina", band: 1, side: "left", tint: "rose", mag: 8 },
  { key: "project:metavyatka", band: 1, side: "right", tint: "violet", mag: 12 },
  { key: "work:maslenitsa-v-slobodskom", band: 2, side: "left", tint: "mint", mag: 10 },
  { key: "work:ya-obmanyvat-sebya-ne-stanu", band: 2, side: "right", tint: "steel", mag: 11 },
];
const stars: SkyStar[] = skyPlan.flatMap((plan) => {
  const entry = entryById.get(plan.key);
  return entry ? [{ ...plan, entry }] : [];
});
const starByKey = new Map(stars.map((star) => [star.key, star]));

/* Edges are the editorial relations already stored on the entries, filtered by the
   same review rule the site graph uses — nothing invented for the picture. */
const hiddenReviews = new Set(["rejected", "proposed", "pending", "needs-review"]);
const isVisibleRelation = (relation: AnyEntry["data"]["relations"][number]) => {
  const status = relation.status === "rejected" || relation.reviewStatus === "rejected" ? "rejected" : relation.reviewStatus ?? relation.status;
  return !status || !hiddenReviews.has(status);
};
const linkPairs = new Map<string, { a: string; b: string }>();
for (const star of stars) {
  for (const relation of star.entry.data.relations) {
    const other = starByKey.get(relation.target);
    if (!other || other.key === star.key || !isVisibleRelation(relation)) continue;
    const pairKey = [star.key, other.key].sort().join("|");
    linkPairs.set(pairKey, linkPairs.get(pairKey) ?? { a: star.key, b: other.key });
  }
}
const edges = [...linkPairs.values()];
const links = new Map(stars.map((star) => [star.key, [] as string[]]));
for (const edge of edges) {
  links.get(edge.a)?.push(edge.b);
  links.get(edge.b)?.push(edge.a);
}

/* Two coordinate sets, expressed in the same units as each board's viewBox: the wide
   one also covers the 6-column tablet board, because both centre a node at 1/6 and 5/6
   of the width. The mobile board stacks the same two-node bands one row at a time. */
const edgeGeometry = (cols: number, span: number, rowSpan: number, vbw: number, vbh: number) =>
  edges.map((edge) => {
    const point = (key: string) => {
      const star = starByKey.get(key)!;
      const startCol = star.side === "left" ? 0 : cols - span;
      return {
        x: +(((startCol + span / 2) / cols) * vbw).toFixed(2),
        y: +(((star.band * rowSpan + rowSpan / 2) / 6) * vbh).toFixed(2),
      };
    };
    return { ...edge, from: point(edge.a), to: point(edge.b) };
  });
const wideEdges = edgeGeometry(12, 4, 2, 400, 300);
const narrowEdges = edgeGeometry(4, 2, 1, 300, 400);

/* Deep sky behind the scene: deterministic dust of different sizes, colours and
   depths, split into three parallax layers. Depth is the translation amplitude in px. */
const tints = ["#dfeaff", "#7fd4f0", "#ffd9a8", "#b9a6ff", "#ffb9d6"];
const skyMotes = Array.from({ length: 54 }, (_, index) => {
  const seed = (n: number) => { const x = Math.sin((index + 1) * n) * 43758.5453; return x - Math.floor(x); };
  const bright = seed(3.7) > 0.82;
  return {
    layer: index % 3,
    x: +(seed(12.9898) * 100).toFixed(2),
    y: +(seed(78.233) * 100).toFixed(2),
    size: +(bright ? 2.4 + seed(2.3) * 1.2 : 1 + seed(5.1) * 1.2).toFixed(2),
    alpha: +(bright ? 0.6 + seed(9.4) * 0.32 : 0.24 + seed(4.4) * 0.42).toFixed(2),
    tint: tints[index % tints.length],
  };
});
const skyLayers = [0, 1, 2].map((layer) => skyMotes.filter((mote) => mote.layer === layer));
const skyDepths = [4, 8, 13];

const homepageJsonLd = {
  "@type": "ProfilePage",
  "@id": new URL("/en/#profile", Astro.site).href,
  url: new URL("/en/", Astro.site).href,
  name: "Stas Ermolenko — XR, AI automation, digital archives and media",
  description: "The English home page of Stanislav Ermolenko: spatial XR experiences, AI automation of processes and agents, digital archives and culture, media and educational products.",
  about: "XR, AI automation, digital archives and media — for business, museums and cultural projects.",
  inLanguage: "en",
  mainEntity: { "@id": new URL("/#stanislav-ermolenko", Astro.site).href },
};
---

<Base title="Stas Ermolenko — XR, AI automation and digital archives" description="XR experiences and spatial interfaces, AI automation and agents, digital archives, media and educational products. I work with business, museums and cultural projects." lang="en" jsonLd={homepageJsonLd}>
  <div class="home-page">
    <section class="home-hero" data-scene aria-labelledby="home-title">
      <div class="home-sky" aria-hidden="true">
        <i class="sky-veil sky-veil-a" data-depth="3"></i>
        <i class="sky-veil sky-veil-b" data-depth="5"></i>
        <i class="sky-veil sky-veil-c" data-depth="7"></i>
        <i class="sky-band sky-band-a" data-depth="4"></i>
        <i class="sky-band sky-band-b" data-depth="6"></i>
        {skyLayers.map((layer, index) => <div class="sky-layer" data-depth={String(skyDepths[index])}>{layer.map((mote) => <i class="sky-mote" style={`left:${mote.x}%;top:${mote.y}%;--s:${mote.size}px;--o:${mote.alpha};--c:${mote.tint}`}></i>)}</div>)}
      </div>

      <div class="home-hero-copy">
        <h1 id="home-title" class="display">Hi 👋 everyone,<br />I'm Stas!</h1>
        <p class="hero-lead">I make XR spaces, AI automation and digital archives&nbsp;—<br class="home-break" /> for business, museums and cultural projects. I like tasks where the technology does not make noise but helps people work, remember and understand.</p>
        <div class="hero-actions">
          <a class="button primary" href="/works/">See the works</a>
          <a class="button quiet" href="mailto:stas@staniverse.xyz?subject=Project for Stas">Write to me</a>
        </div>
      </div>

      <div class="home-constellation" data-depth="2.5">
        <div class="const-head">
          <span class="section-kicker">Living map of connections</span>
        </div>
        <div class="const-board" data-const-board role="group" aria-label="Selected works and projects and the connections between them">
          <svg class="const-edges const-edges-wide" viewBox="0 0 400 300" aria-hidden="true">
            {wideEdges.map((edge) => <line class="const-edge" x1={edge.from.x} y1={edge.from.y} x2={edge.to.x} y2={edge.to.y} data-edge-a={edge.a} data-edge-b={edge.b} />)}
          </svg>
          <svg class="const-edges const-edges-narrow" viewBox="0 0 300 400" aria-hidden="true">
            {narrowEdges.map((edge) => <line class="const-edge" x1={edge.from.x} y1={edge.from.y} x2={edge.to.x} y2={edge.to.y} data-edge-a={edge.a} data-edge-b={edge.b} />)}
          </svg>
          {stars.map((star) => (
            <a class="const-node" href={hrefOf(star.entry)} data-node={star.key} data-links={links.get(star.key)?.join(" ") ?? ""} data-band={star.band} data-side={star.side} data-tint={star.tint} data-title={copy[star.key]?.title ?? star.entry.data.title} aria-describedby="const-status" style={`--mag:${star.mag}`}>
              <span class="const-figure" aria-hidden="true"><i class="const-glow"></i><i class="const-flare"></i><i class="const-core"></i></span>
              <span class="const-label"><span class="const-kind">{kindOf(star.entry)}</span><span class="const-name">{copy[star.key]?.title ?? star.entry.data.title}</span></span>
            </a>
          ))}
        </div>
        <p class="const-status" id="const-status" data-const-status>Hover, focus or tap a star — the related works and projects light up.</p>
        <a class="const-universe-cta" href="/universe/">
          <span>Open the XR universe</span>
          <span class="const-universe-meta">3D · VR · AR <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <nav class="signal-strip" aria-label="Main sections">
      <a href="/works/"><strong>Works</strong><span>delivered work</span></a>
      <a href="/projects/"><strong>Projects</strong><span>own living systems</span></a>
      <a href="/garden/"><strong>Garden</strong><span>publications and topics</span></a>
      <button type="button" data-profile-open><strong>About me</strong><span>experience, skills and contacts</span></button>
    </nav>

    <section class="section home-directions" aria-labelledby="directions-title">
      <div class="section-head">
        <div><div class="section-kicker">Directions</div><h2 id="directions-title">One way of working,<br class="home-break" /> four entry points</h2></div>
        <a class="text-link" href="/works/">All works →</a>
      </div>
      <p class="section-copy">Most often it all starts with the question of what has to change. Businesses need processes, predictability and less manual routine; museums and cultural institutions need preservation, display and a conversation with the visitor; media and educational projects need their material assembled, texts, video and publication. Below are four ways to build that kind of work.</p>
      <div class="directions-grid">
        {directions.map((direction) => (
          <article class="direction-tile">
            <h3>{direction.title}</h3>
            <p>{direction.text}</p>
            <div class="tag-row">{direction.tags.map((tag) => <span>{tag}</span>)}</div>
            <a class="direction-proof" href={direction.href}>{direction.proof} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="works-title"><div class="section-head"><div><div class="section-kicker">Selected works</div><h2 id="works-title">The ones that became<br class="home-break" /> real</h2></div><a class="text-link" href="/works/">All works →</a></div><div class="card-grid">{works.map((entry, i) => <ContentCard entry={entry} large={i === 0 || i === 3} showDate={false} titleOverride={copy[entry.data.id]?.title} summaryOverride={copy[entry.data.id]?.summary} tagsOverride={tagsOf(entry)} kindLabelOverride={kindOf(entry)} statusOverride={statusOf(entry)} />)}</div></section>

    <section class="section home-projects" aria-labelledby="projects-title">
      <div class="section-head"><div><div class="section-kicker">Own projects</div><h2 id="projects-title">The ones that keep<br class="home-break" /> moving</h2></div><a class="text-link" href="/projects/">All projects →</a></div>
      <p class="section-copy">Ideas, research and systems do not have to be finished. They have a status, a history and a next action.</p>
      <div class="card-grid">{projects.map((entry) => <ContentCard entry={entry} showDate={false} hrefOverride={translatedProjects[entry.data.id]} titleOverride={copy[entry.data.id]?.title} summaryOverride={copy[entry.data.id]?.summary} tagsOverride={tagsOf(entry)} kindLabelOverride={kindOf(entry)} statusOverride={statusOf(entry)} />)}</div>
    </section>

    <section class="section home-profile" aria-labelledby="home-profile-title">
      <div class="section-head">
        <div><div class="section-kicker">Profile</div><h2 id="home-profile-title">I design digital experience —<br class="home-break" /> from research to a working system</h2></div>
        <a class="text-link" href="/about/">About me →</a>
      </div>
      <div class="profile-band">
        <div class="profile-band-cell">
          <p class="profile-lead">I work at the intersection of XR, AI, web and documentary media: I design spatial experiences, automation and systems in which technology helps a person remember, understand and be present.</p>
          <div class="profile-facts"><span><strong>1994</strong><small>year of birth</small></span><span><strong>11+</strong><small>years in media</small></span><span><strong>XR · AI · Web</strong><small>working focus</small></span><span><strong>St. Petersburg · from Vyatka</strong><small>based in St. Petersburg</small></span></div>
        </div>
        <div class="profile-band-cell">
          <span class="profile-label">Now</span>
          <p class="profile-now-lead"><strong>Self-employed · master's student at ITMO</strong></p>
          <p>I study in ITMO's master's programme “Digital Methods in the Humanities”, I run the <a href="https://t.me/staniverse" target="_blank" rel="noreferrer">Telegram channel “staniverse”</a>, and I sometimes come back to YouTube — <a href="https://www.youtube.com/@staniverse" target="_blank" rel="noreferrer">“staniverse”</a> and <a href="https://www.youtube.com/@yatygorod" target="_blank" rel="noreferrer">“я.ты.город”</a>.</p>
          <button class="button quiet" type="button" data-profile-open>Full profile</button>
        </div>
      </div>
    </section>

    <section class="section home-invite" aria-labelledby="invite-title">
      <div class="home-invite-inner">
        <div>
          <div class="section-kicker">Conversation</div>
          <h2 id="invite-title">Tell me what<br class="home-break" /> you are working on</h2>
          <p class="section-copy">Describe it in a couple of words: what is happening, where the bottleneck is and what result would be good enough. I will answer honestly whether it needs XR, AI or plain careful automation, and suggest the next step — without a big blind rollout.</p>
        </div>
        <div class="home-invite-actions">
          <a class="button primary" href="mailto:stas@staniverse.xyz?subject=Project for Stas">Write to me</a>
          <a class="button quiet" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Download CV</a>
          <a class="text-link" href="/contacts/">Other contacts →</a>
        </div>
      </div>
    </section>

    <dialog class="profile-dialog" data-profile-dialog aria-labelledby="profile-title">
      <div class="profile-module">
      <form method="dialog" class="profile-close-form"><button class="profile-close" aria-label="Close profile">Close ×</button></form>
      <div class="profile-heading"><div><div class="section-kicker">Profile</div><h2 id="profile-title">I design digital experience —<br />from research to a working system</h2></div><a class="text-link" href="/cv/Stanislav-Ermolenko-CV-RU.pdf" download>Download CV ↗</a></div>
      <div class="profile-grid">
        <div class="profile-summary"><p>I work at the intersection of XR, AI, web and documentary media. I design clear interfaces, educational products and systems in which technology helps a person remember, understand and be present.</p><div class="profile-facts"><span><strong>1994</strong><small>year of birth</small></span><span><strong>11+</strong><small>years in media</small></span><span><strong>XR · AI · Web</strong><small>working focus</small></span><span><strong>St. Petersburg · from Vyatka</strong><small>based in St. Petersburg</small></span></div></div>
        <div class="profile-now"><span class="profile-label">Now</span><strong>Self-employed · master's student at ITMO</strong><p>Freelance, automation, GenAI, XR, web and media. I study in ITMO's master's programme “Digital Methods in the Humanities” (2026 – present).</p></div>
      </div>
      <details class="profile-details"><summary>Expand experience, education and tools <span aria-hidden="true">+</span></summary><div class="profile-details-grid">
        <div><span class="profile-label">Experience</span><ul><li><strong>2025 – present</strong> Information systems specialist</li><li><strong>2023 – present</strong> Self-employed: automation, GenAI, XR, Web, Media</li><li><strong>2023 – 2026</strong> Lecturer and methodologist at VyatSU “Digital Departments”; in summer 2026 I put together the course “Fundamentals of Product Management”</li><li><strong>2015 – 2023</strong> Computer operator and project curator at the VyatSU Media Centre</li></ul></div>
        <div><span class="profile-label">Education and courses</span><ul><li><strong>2026 – present</strong> ITMO, master's programme “Digital Methods in the Humanities” (Digital Humanities), 45.04.04</li><li><strong>2026</strong> Bachelor in State and Municipal Administration, VyatSU</li><li><strong>2026</strong> Somnium Space Academy</li><li><strong>2026</strong> Agents Week, Yandex School of Data Analysis</li><li><strong>2026</strong> Premasters Art&amp;Science, ITMO</li><li><strong>2025</strong> VR development with Unity and the XR Interaction Toolkit, Stepik</li><li><strong>2024</strong> Internet marketing and law, professional retraining at VyatSU</li><li><strong>2024</strong> Digital Autumn: Changing Perspective, XR intensive</li><li><strong>2024</strong> Unity Essential Pathway</li><li><strong>2022</strong> “Modern digital technologies”, VyatSU</li><li><strong>2021</strong> Digital technologies in journalism and PR, professional retraining at VyatSU</li><li><strong>2015</strong> MB110x: Introduction to the Music Business</li><li><strong>2015</strong> BMPR365x: Vocal Recording Technology</li></ul></div>
        <div><span class="profile-label">Tools</span><p>XR: Unity · Blender · Substance · WebXR · 8th Wall · Three.js<br />AI: n8n · LangChain · Dify · Supabase · Neo4j · ComfyUI · Python<br />Harnesses and agents: Claude Code · Codex · OpenCode · OpenClaw · Hermes · Pico Claw · pi<br />Web: Astro · Tilda · WordPress · Telegram Bot API<br />Infrastructure: Linux · Docker · Nginx · Home Assistant<br />Media: DaVinci Resolve · Premiere · Photoshop · OBS Studio</p></div>
        <div><span class="profile-label">Achievements</span><p>Prize-winner of the XV Russian Youth Delphic Games in TV journalism, winner of “MediaMaster-2019”, finalist of the student media projects competition at the “Space of Eurasia” forum, Top-10 at ArtMasters-2025 in the “Virtual world designer” category.</p></div>
      </div></details>
      <div class="profile-page-link"><a class="text-link" href="/about/">Open the separate page and the manifesto →</a></div>
      </div>
    </dialog>
  </div>

  <script>
    // Living map: hovering, focusing or tapping a star lights its own constellation
    // edges and dims everything that is not part of it.
    const board = document.querySelector<HTMLElement>("[data-const-board]");
    const status = document.querySelector<HTMLElement>("[data-const-status]");
    if (board && status) {
      const nodes = [...board.querySelectorAll<HTMLElement>("[data-node]")];
      const edges = [...board.querySelectorAll<SVGLineElement>(".const-edge")];
      const byKey = new Map(nodes.map((node) => [node.dataset.node ?? "", node]));
      const hint = status.textContent ?? "";
      const list = (node: HTMLElement) => (node.dataset.links ?? "").split(" ").filter(Boolean);

      const highlight = (key?: string) => {
        if (key) board.dataset.hot = key;
        else delete board.dataset.hot;
        for (const node of nodes) {
          const hot = node.dataset.node === key;
          const linked = Boolean(key) && list(byKey.get(key!)!).includes(node.dataset.node ?? "");
          node.classList.toggle("is-hot", hot);
          node.classList.toggle("is-linked", linked);
          node.classList.toggle("is-dim", Boolean(key) && !hot && !linked);
        }
        for (const edge of edges) {
          const touches = Boolean(key) && (edge.dataset.edgeA === key || edge.dataset.edgeB === key);
          edge.classList.toggle("is-hot", touches);
          edge.classList.toggle("is-dim", Boolean(key) && !touches);
        }
        const active = key ? byKey.get(key) : undefined;
        if (!active) { status.textContent = hint; return; }
        const connected = list(active).map((linkedKey) => byKey.get(linkedKey)?.dataset.title).filter(Boolean);
        status.textContent = connected.length
          ? `${active.dataset.title} — connections: ${connected.join(", ")}.`
          : `${active.dataset.title} — a separate branch, connections will appear later.`;
      };

      const target = (event: Event) => (event.target as Element | null)?.closest<HTMLElement>("[data-node]");
      board.addEventListener("pointerover", (event) => { const node = target(event); if (node) highlight(node.dataset.node); });
      board.addEventListener("pointerout", (event) => { if (!(event.relatedTarget as Element | null)?.closest("[data-node]")) highlight(); });
      board.addEventListener("pointerdown", (event) => { const node = target(event); if (node) highlight(node.dataset.node); });
      board.addEventListener("focusin", (event) => { const node = target(event); if (node) highlight(node.dataset.node); });
      board.addEventListener("focusout", () => highlight());
    }

    // Gentle depth: the sky and the constellation drift with the pointer, by a few
    // pixels, and only when the visitor has not asked for calm.
    const scene = document.querySelector<HTMLElement>("[data-scene]");
    if (scene && !matchMedia("(prefers-reduced-motion: reduce)").matches && matchMedia("(pointer: fine)").matches) {
      const layers = [...scene.querySelectorAll<HTMLElement>("[data-depth]")];
      let frame = 0;
      let x = 0;
      let y = 0;
      const paint = () => {
        frame = 0;
        for (const layer of layers) {
          const depth = Number(layer.dataset.depth ?? 0);
          layer.style.translate = `${(x * depth).toFixed(2)}px ${(y * depth).toFixed(2)}px`;
        }
      };
      addEventListener("pointermove", (event) => {
        x = (event.clientX / innerWidth - .5) * 2;
        y = (event.clientY / innerHeight - .5) * 2;
        if (!frame) frame = requestAnimationFrame(paint);
      }, { passive: true });
    }

    const dialog = document.querySelector<HTMLDialogElement>("[data-profile-dialog]");
    for (const trigger of document.querySelectorAll<HTMLButtonElement>("[data-profile-open]")) trigger.addEventListener("click", () => dialog?.showModal());
    dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</Base>

<style>
  /* Spectral tints for the map stars: the one place where colour carries meaning
     (which world a node belongs to). Everything else comes from the contract tokens. */
  .const-node[data-tint="cyan"] { --tint: #7fd4f0; }
  .const-node[data-tint="amber"] { --tint: #ffc98a; }
  .const-node[data-tint="violet"] { --tint: #a99bff; }
  .const-node[data-tint="rose"] { --tint: #ff9ec4; }
  .const-node[data-tint="mint"] { --tint: #8fe3c0; }
  .const-node[data-tint="steel"] { --tint: #bcd0ff; }

  .home-page { min-width: 0; }
  .home-break { display: none; }
  @media (min-width: 700px) { .home-break { display: block; } }

  /* ---------------------------------------------------------------- first screen */
  .home-hero { position: relative; display: grid; align-content: center; gap: var(--s-6); min-width: 0; padding: var(--flow-section) var(--rail-inset); overflow: clip; }
  @media (min-width: 1000px) { .home-hero { grid-template-columns: minmax(0, 1.02fr) minmax(24rem, .98fr); gap: clamp(2rem, 3.5vw, 4rem); min-height: calc(100svh - 4rem); } }
  .home-hero-copy { position: relative; z-index: 1; align-self: center; min-width: 0; max-width: 42rem; }
  .home-hero .display { max-width: 15ch; margin: var(--s-2) 0 var(--s-4); font-size: clamp(2.2rem, 1.5rem + 2.8vw, 3.5rem); }
  .home-hero .hero-lead { max-width: 46rem; margin: 0; color: var(--ink-2); }
  .home-hero .hero-actions { margin-top: var(--s-5); }
  /* The one quiet action style on this page: hairline, no fill. */
  .home-page .button.quiet { border-color: var(--line); background: transparent; color: var(--ink); }
  .home-page .button.quiet:hover,
  .home-page .button.quiet:focus-visible { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }

  /* Deep sky: token-derived nebulae, then colour-varied dust at three depths. */
  .home-sky { position: absolute; inset: 0; z-index: 0; overflow: clip; pointer-events: none; }
  .home-sky::after { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 58%, var(--ground)); content: ""; }
  .sky-veil { position: absolute; border-radius: var(--radius-pill); filter: blur(48px); }
  .sky-veil-a { top: -8%; right: -6%; width: min(46rem, 72vw); aspect-ratio: 4 / 3; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 26%, transparent), transparent); }
  .sky-veil-b { bottom: -14%; left: -12%; width: min(38rem, 64vw); aspect-ratio: 3 / 2; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 20%, transparent), transparent); filter: blur(56px) hue-rotate(44deg); }
  .sky-veil-c { top: 30%; left: 40%; width: min(30rem, 48vw); aspect-ratio: 1; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 14%, transparent), transparent); filter: blur(46px) hue-rotate(-30deg); }
  /* Two long, soft bands: enough structure for the sky to read as deep space. */
  .sky-band { position: absolute; width: 170%; aspect-ratio: 7 / 1; border-radius: var(--radius-pill); filter: blur(38px); opacity: .5; }
  .sky-band-a { top: 6%; left: -34%; rotate: -16deg; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 20%, transparent) 32%, color-mix(in srgb, var(--accent) 26%, transparent) 62%, transparent); }
  .sky-band-b { bottom: 4%; right: -30%; rotate: 13deg; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 22%, transparent) 40%, transparent); filter: blur(44px) hue-rotate(38deg); opacity: .42; }
  .sky-layer { position: absolute; inset: 0; will-change: translate; }
  .sky-mote { position: absolute; width: calc(var(--s, 1.4px) * var(--mote-scale, 1)); height: calc(var(--s, 1.4px) * var(--mote-scale, 1)); border-radius: var(--radius-pill); background: var(--c, var(--ink)); opacity: calc(var(--o, .5) * var(--mote-boost, 1)); box-shadow: 0 0 calc(var(--s, 1.4px) * 4) color-mix(in srgb, var(--c, var(--ink)) 55%, transparent); }
  .sky-mote:nth-child(5n) { animation: sky-breathe calc(var(--dur-3) * 11) var(--ease) infinite alternate; }
  @keyframes sky-breathe { from { opacity: calc(var(--o, .5) * var(--mote-boost, 1) * .4); } to { opacity: calc(var(--o, .5) * var(--mote-boost, 1)); } }

  /* ------------------------------------------------------------ living map scene */
  .home-constellation { position: relative; z-index: 1; display: grid; gap: var(--s-2); min-width: 0; }
  .const-head { margin-bottom: var(--s-3); }
  /* The way into the 3D map sits at the foot of the flat map it continues — a
     hairline row like every other band on the site, not a pill in the corner. */
  .const-universe-cta { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 44px; margin-top: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); color: var(--ink); font-size: .9rem; transition: color var(--dur-2) var(--ease); }
  .const-universe-cta .const-universe-meta { color: var(--ink-2); font-size: .72rem; white-space: nowrap; transition: color var(--dur-2) var(--ease); }
  .const-universe-cta:hover, .const-universe-cta:focus-visible,
