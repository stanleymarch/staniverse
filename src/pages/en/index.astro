  /* ------------------------------------------------------------------ directions */
  .directions-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; border-block: 1px solid var(--line); background: var(--line); }
  .direction-tile { position: relative; display: flex; flex-direction: column; align-content: start; gap: var(--s-2); min-width: 0; padding: var(--s-5) var(--s-4); background: var(--ground); }
  .direction-tile::after { position: absolute; inset: 0; border: 1px solid transparent; content: ""; pointer-events: none; transition: border-color var(--dur-2) var(--ease); }
  .direction-tile:hover::after,
  .direction-tile:focus-within::after { border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .direction-tile h3 { margin: 0; color: var(--ink); font: 500 clamp(1.02rem, .92rem + 1vw, 1.3rem) / 1.22 Unbounded; letter-spacing: -.02em; text-wrap: balance; transition: translate var(--dur-2) var(--ease); }
  .direction-tile p { margin: 0; color: var(--ink-2); font-size: .88rem; line-height: 1.6; text-wrap: pretty; }
