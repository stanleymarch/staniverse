  /* --------------------------------------------------------------- profile dialog */
  .profile-dialog { width: min(92vw, 1400px); max-width: none; max-height: min(90dvh, 980px); margin: auto; padding: 0; overflow: auto; border: 1px solid var(--line); border-radius: var(--radius-1); background: var(--ground); color: var(--ink); }
  .profile-dialog::backdrop { background: color-mix(in srgb, var(--ground) 82%, transparent); }
  .profile-module { position: relative; max-width: 1400px; margin: 0 auto; padding: var(--flow-section) var(--rail-inset); }
  .profile-close-form { position: sticky; z-index: 3; top: 0; display: flex; justify-content: flex-end; height: 0; margin: 0; }
  .profile-close { min-height: 44px; padding: .65rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-pill); background: var(--surface); color: var(--ink); cursor: pointer; transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease); }
  .profile-close:hover, .profile-close:focus-visible { border-color: var(--accent); color: var(--accent); }
  .profile-page-link { margin-top: var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .profile-heading { display: flex; justify-content: space-between; align-items: end; gap: var(--s-5); margin-bottom: var(--s-5); }
  .profile-heading h2 { margin: var(--s-1) 0 0; color: var(--ink); font: 500 clamp(1.8rem, 3.2vw, 3rem) / 1.05 Unbounded; letter-spacing: -.04em; text-wrap: balance; }
  .profile-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(260px, .75fr); gap: var(--flow-section); padding: var(--s-4) 0; border-top: 1px solid var(--line); }
  .profile-summary p { max-width: 52rem; margin: 0; color: var(--ink); font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.45; }
  .profile-now { border-left: 1px solid var(--line); padding-left: var(--s-4); }
  .profile-now strong { display: block; margin: var(--s-2) 0; color: var(--ink); font-size: 1.05rem; }
  .profile-now p, .profile-details-grid p, .profile-details-grid li { margin: 0; color: var(--ink-2); font-size: .82rem; line-height: 1.55; }
  .profile-details { margin-top: var(--s-3); border-top: 1px solid var(--line); }
  .profile-details summary { display: flex; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) 0; color: var(--ink); cursor: pointer; font-size: .86rem; list-style: none; }
  .profile-details summary::-webkit-details-marker { display: none; }
  .profile-details summary span { color: var(--accent); }
  .profile-details[open] summary { border-bottom: 1px solid var(--line); }
  .profile-details-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); padding-top: var(--s-4); }
  .profile-details-grid ul { display: grid; gap: var(--s-2); margin: var(--s-3) 0 0; padding: 0; list-style: none; }
  .profile-details-grid li strong { display: block; color: var(--ink); font-size: .72rem; font-weight: 500; }
  .profile-details-grid p { margin: var(--s-3) 0 0; }
  @media (max-width: 900px) { .profile-heading { align-items: start; flex-direction: column; gap: var(--s-3); } .profile-heading .text-link { white-space: nowrap; } .profile-grid { grid-template-columns: 1fr; } .profile-now { border-top: 1px solid var(--line); border-left: 0; padding: var(--s-4) 0 0; } .profile-details-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .profile-dialog { width: calc(100vw - 1rem); max-height: calc(100dvh - 1rem); } .profile-heading h2 { font-size: clamp(1.6rem, 8vw, 2.4rem); } .profile-details-grid { grid-template-columns: 1fr; } }

  /* ------------------------------------------------------------------- small screens */
  @media (max-width: 999px) { .home-hero { align-content: start; } }
  @media (max-width: 700px) {
    .home-hero { gap: var(--flow-half); padding-block: var(--flow-half) var(--flow-section); }
    .home-hero .display { max-width: 100%; font-size: clamp(2rem, 1.4rem + 5vw, 2.8rem); }
    .const-node { --mag-scale: .8; }
    /* A phone sees a slice of the sky at once: give the dust a little more presence. */
    .home-sky { --mote-scale: 1.3; --mote-boost: 1.25; }
    .const-kind { font-size: .64rem; letter-spacing: .08em; }
    .const-name { font-size: .78rem; }
    .profile-band { grid-template-columns: 1fr; }
    .profile-facts { gap: var(--s-3) var(--s-4); }
  }
