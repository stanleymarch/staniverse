---
import { withoutTrailingStop } from "../../../lib/typography";
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* The structural facts stay bound to the Russian entry — status, facets, stack and
   the update date are read from the collection, never retyped for the translation. */
const source = (await getCollection("experiments")).find((item) => item.data.id === "experiment:knockdown");
const statusLabels: Record<string, string> = { live: "Running", soon: "In development" };
const typeLabels: Record<string, string> = { "игра": "Game", "песочница": "Sandbox", "инструмент": "Tool", "арт-опыт": "Art experience" };
const platformLabels: Record<string, string> = { "мобильные": "Mobile", "гарнитуры": "Headsets", "десктоп": "Desktop" };
const capabilityLabels: Record<string, string> = { "физика": "Physics", "звук": "Sound" };
const translate = (labels: Record<string, string>, values: string[]) => values.map((value) => labels[value] ?? value);
const status = source ? statusLabels[source.data.status] ?? source.data.status : "Running";
const types = translate(typeLabels, source?.data.types ?? []);
const platforms = translate(platformLabels, source?.data.platforms ?? []);
const capabilities = translate(capabilityLabels, source?.data.capabilities ?? []);
const stack = source?.data.stack ?? [];
const href = source?.data.href;
const repo = source?.data.repo;
const updated = source?.data.updated ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(source.data.updated) : "";

const pageTitle = "Knockdown — an AR physics sandbox";
const description = "A physics sandbox in AR: a tap on the floor places a tower of fifteen bricks, a tap throws a ball at it, and you count what has been knocked down.";
const experimentJsonLd = {
  "@type": "CreativeWork",
  "@id": new URL("/en/experiments/knockdown/#content", Astro.site).href,
  url: new URL("/en/experiments/knockdown/", Astro.site).href,
  name: "Knockdown",
  headline: "Knockdown",
  description,
  inLanguage: "en",
  author: { "@id": new URL("/#stanislav-ermolenko", Astro.site).href },
  isPartOf: { "@id": new URL("/#website", Astro.site).href },
  ...(source?.data.updated ? { dateModified: source.data.updated.toISOString() } : {}),
};
---
<Base title={pageTitle} description={description} lang="en" jsonLd={experimentJsonLd}>
  <article class="entry-shell">
    <header class="entry-hero">
      <div class="entry-hero-meta"><span class="section-kicker">Experiment · {status}</span></div>
      <h1>Knockdown</h1>
      <p class="entry-summary">{withoutTrailingStop(description)}</p>
      <div class="publication-facts">
        {status === "Running" && href && <a href={href}>Open experiment ↗</a>}
        {repo && <a href={repo}>Code ↗</a>}
      </div>
      <dl class="work-facts">
        <div><dt>Status</dt><dd>{status}</dd></div>
        <div><dt>Type</dt><dd>{types.join(" · ")}</dd></div>
        <div><dt>Platforms</dt><dd>{platforms.join(" · ")}</dd></div>
        {capabilities.length > 0 && <div><dt>Capabilities</dt><dd>{capabilities.join(" · ")}</dd></div>}
        <div><dt>Technology</dt><dd>{stack.join(" · ")}</dd></div>
        {updated && <div><dt>Updated</dt><dd>{updated}</dd></div>}
      </dl>
    </header>
    <div class="prose">
      <h2>What it is</h2>
      <p><code>Knockdown</code> is a physics demo in augmented reality: a tower appears on the floor of your real room, and you knock it down with a throw. What interested me here was not the game but the chain &ldquo;SLAM surface → physical world → hit count&rdquo;.</p>

      <h2>How to play</h2>
      <ul>
        <li><strong>Tap the floor</strong> — places a tower of fifteen bricks (five levels, each brick about nine centimetres).</li>
        <li><strong>Tap anywhere</strong> — throws a ball there: it flies from the tap point at roughly seven metres per second.</li>
        <li><strong>Reset</strong> — sets the tower up again.</li>
      </ul>

      <h2>What is inside</h2>
      <p>A brick counts as knocked down if it has moved more than eight centimetres from its place or tilted more than roughly forty-four degrees — the counter at the bottom shows &ldquo;Down N / 15&rdquo;. The physics runs on <code>cannon-es</code>: the ball is a body thrown at the tap point rather than &ldquo;at the centre of the tower&rdquo;, so the trajectory and the spin affect the result. The breakdown lives in <code>src/physics-world.js</code>, <code>src/tower.js</code> and <code>src/knockdown.js</code>.</p>

      <h2>Stack</h2>
      <ul>
        <li>8th Wall (SLAM, surfaces)</li>
        <li>A-Frame (scene and HUD)</li>
        <li>cannon-es (physics)</li>
      </ul>

      <h2>Links</h2>
      <ul>
        {href && <li><a href={href}>Open the demo on your phone</a></li>}
        {repo && <li><a href={repo}>Experiment source code</a></li>}
      </ul>

      <p class="entry-original"><a class="text-link" href="/experiments/knockdown/">Original (Russian) →</a></p>
    </div>
  </article>
</Base>
