---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* The structural facts stay bound to the Russian entry — status, year, role, client
   and genres are read from the collection, never retyped for the translation. */
const source = (await getCollection("works")).find((item) => item.data.id === "work:prepodavanie-metodicheskaya-rabota-i-prodakshn-v-tsifrovykh-kafedrakh");
const statusLabels: Record<string, string> = { ongoing: "Ongoing", completed: "Completed" };
const genreLabels: Record<string, string> = { education: "Education", ai: "AI", video: "Video", automation: "Automation" };
const status = source ? statusLabels[source.data.status] ?? source.data.status : "Completed";
const genres = source?.data.genres.map((genre) => genreLabels[genre] ?? genre) ?? [];
/* Role and client reach the page from the collection in Russian, so their translation
   is keyed to the exact source fragments: anything unmatched falls back to the source. */
const roleLabels: Record<string, string> = {
  "Участвовал в методической сборке программ ДПО": "Took part in the methodological assembly of the professional retraining programmes",
  "Разрабатывал лекционные и вспомогательные материалы": "Developed lecture and supporting materials",
  "Создавал оценочные средства и задания для проверки компетенций": "Created assessment tools and tasks for testing competencies",
};
const clientLabels: Record<string, string> = { "ВятГУ": "VyatSU", };
const year = source ? String(source.data.year).trim() : "";
const role = (source?.data.role ?? "").split("; ").map((part) => roleLabels[part.trim()] ?? part.trim()).join(" · ");
const client = clientLabels[source?.data.client ?? ""] ?? source?.data.client ?? "";

const pageTitle = "Teaching, methodology and production at the “Digital Departments” — retraining programmes at VyatSU";
const description = "Take part in VyatSU's professional retraining programmes not only as a lecturer but as someone who helps assemble the content, methodology and media production side of an educational product. The work ran inside the “Applied Software Development” and “AI Solutions Development” programmes.";
const workJsonLd = {
  "@type": "CreativeWork",
  "@id": new URL("/en/works/prepodavanie-metodicheskaya-rabota-i-prodakshn-v-tsifrovykh-kafedrakh/#content", Astro.site).href,
  url: new URL("/en/works/prepodavanie-metodicheskaya-rabota-i-prodakshn-v-tsifrovykh-kafedrakh/", Astro.site).href,
  name: "Teaching, methodology and production at the “Digital Departments”",
  headline: "Teaching, methodology and production at the “Digital Departments”",
  description,
  inLanguage: "en",
  author: { "@id": new URL("/#stanislav-ermolenko", Astro.site).href },
  isPartOf: { "@id": new URL("/#website", Astro.site).href },
  ...(source?.data.updated ? { dateModified: source.data.updated.toISOString() } : {}),
};
---
<Base title={pageTitle} description={description} lang="en" jsonLd={workJsonLd}>
  <article class="entry-shell">
    <header class="entry-hero">
      <div class="entry-hero-meta"><span class="section-kicker">Work · {status}</span></div>
      <h1>Teaching, methodology and production at the &ldquo;Digital Departments&rdquo;</h1>
      <p class="entry-summary">{description}</p>
      <dl class="work-facts">
        {year && <div><dt>Year</dt><dd>{year}</dd></div>}
        {role && <div><dt>Role</dt><dd>{role}</dd></div>}
        {client && <div><dt>Client</dt><dd>{client}</dd></div>}
        {genres.length > 0 && <div><dt>Genres</dt><dd>{genres.join(" · ")}</dd></div>}
      </dl>
    </header>
    <div class="prose">
      <h2>The brief</h2>
      <p>Take part in VyatSU&rsquo;s professional retraining programmes not only as a lecturer but as someone who helps assemble the content, methodology and media production side of an educational product.</p>

      <h2>Context</h2>
      <p>This is not a story about a single lecture or a one-off masterclass. Within the <code>Digital Departments</code> several professional retraining programmes were running, and my role inside them was multi-layered: methodologist, lecturer and a person who can package a course into a clear and modern format.</p>
      <p>For the portfolio this case matters also because it shows not &ldquo;academic teaching for a tick&rdquo; but work at the junction of current technology, the university circuit and production.</p>
      <p>This is work inside the <code>Vyatka State University</code>, a state higher education institution. That is an important frame for positioning: the experience in courses and teaching here rests not on an info-business model but on an academic environment, professional retraining programmes and real educational infrastructure.</p>

      <h2>Solution</h2>
      <p>The work ran inside the professional retraining programmes <code>Applied Software Development</code> and <code>AI Solutions Development</code>. I took part in developing the learning materials and assessment tools, gave lectures and practical classes, and also worked on the production of educational content and the support of event formats.</p>
      <p>In terms of content the focus was on topics directly connected to the current practical stack: generative AI, building chatbots, automation, UI and the applied use of digital tools. In terms of form this was not only a &ldquo;talking lecturer&rdquo; but also production: shooting, editing, organising live streams, recording video lectures and integrating non-standard formats such as an interview from a metaverse space.</p>

      <h2>What I did personally</h2>
      <ul>
        <li>Took part in the methodological assembly of the professional retraining programmes</li>
        <li>Developed lecture and supporting materials</li>
        <li>Created assessment tools and tasks for testing competencies</li>
        <li>Gave lectures on GenAI, chatbots, automation and related digital topics</li>
        <li>Worked on shooting, editing and organising live streams</li>
        <li>Helped turn the learning content into a livelier and more modern media product</li>
      </ul>

      <h2>Stack</h2>
      <ul>
        <li>GenAI</li>
        <li>chatbots</li>
        <li>automation</li>
        <li>UI / digital interfaces</li>
        <li>video shooting and editing</li>
        <li>live streaming</li>
      </ul>

      <h2>Skills</h2>
      <ul>
        <li>teaching practice-oriented topics</li>
        <li>methodological development</li>
        <li>educational production</li>
        <li>explaining the complex language of technology in human terms</li>
        <li>working at the junction of content, form and teaching</li>
      </ul>

      <h2>Result</h2>
      <p>This case brought together several strong roles in one piece of work: lecturer, methodologist and producer of learning content. It shows that I can be trusted not only with a single lecture on a fashionable topic but with a more complex task: to invent, assemble, explain and bring an educational product to a working form.</p>
      <p>An especially strong part of the case is that the teaching here is not detached from real practice. Topics such as GenAI, chatbots and automation ran not as a retelling of other people&rsquo;s presentations but as a continuation of my own working experience.</p>
      <p>For future educational projects this is also a marker of trust: I have academic experience inside a state university, not only private experiments with lectures and content.</p>

      <p class="entry-original"><a class="text-link" href="/works/prepodavanie-metodicheskaya-rabota-i-prodakshn-v-tsifrovykh-kafedrakh/">Original (Russian) →</a></p>
    </div>
  </article>
</Base>
