---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { hrefFor, kindLabel } from "../../lib/content";
import { collectTopics } from "../../lib/topics";
import { normalizeTopics, getTopicDefinition } from "../../lib/taxonomy";
import "../../styles/garden.css";
const entries=[...await getCollection("articles"),...await getCollection("publications")].filter((entry)=>entry.id!=="manifesto"&&(entry.collection!=="publications"||!["video","youtube-video"].includes(entry.data.kind)||entry.data.ownership==="verified"||entry.data.ownership==="own")).sort((a,b)=>(b.data.date?.getTime()??0)-(a.data.date?.getTime()??0));
const topics=collectTopics(entries,true).slice(0,18);
const records=entries.map((entry)=>({id:entry.data.id,href:hrefFor(entry),title:entry.data.title,summary:entry.data.summary,kind:entry.data.kind,kindLabel:kindLabel[entry.data.kind],date:entry.data.date?.toISOString()??"",topics:normalizeTopics(entry.data.tags).map((id)=>({id,label:getTopicDefinition(id)?.label??id})),media:entry.collection==="publications"?entry.data.media.length:0,relations:entry.data.relations.map((relation)=>({target:relation.target,type:relation.type,evidence:relation.evidence,confidence:relation.confidence}))}));
---
<Base title="Сад опыта">
  <header class="garden-hero"><div><div class="section-kicker">Публичная память</div><h1>Сад</h1><p>Каталог опыта: публикации, статьи, видео и цепочки мыслей, связанные с темами и живыми проектами.</p></div><div class="garden-search-wrap"><label for="garden-search">Поиск по материалам</label><input id="garden-search" type="search" placeholder="Тема, проект, технология…" autocomplete="off" data-garden-search /></div></header>
  <div class="garden-mode" role="group" aria-label="Режим сада"><button type="button" data-garden-mode="feed">Лента</button><button type="button" class="active" data-garden-mode="catalog">Каталог</button><button type="button" data-garden-mode="map">Карта</button><button type="button" class="garden-filter-toggle" data-filter-toggle aria-expanded="false">Фильтры</button></div>
  <div class="garden-layout">
    <aside class="garden-facets" data-garden-facets><div class="garden-facet-head"><strong>Фильтры</strong><button type="button" data-garden-reset>Сбросить</button></div><fieldset><legend>Тип материала</legend><label><input type="checkbox" value="telegram-post" data-kind-filter /> Посты Telegram</label><label><input type="checkbox" value="telegram-article" data-kind-filter /> Статьи Telegram</label><label><input type="checkbox" value="article" data-kind-filter /> Авторские статьи</label><label><input type="checkbox" value="youtube-video" data-kind-filter /> Проверенные видео</label></fieldset><fieldset><legend>Темы</legend><div class="garden-topic-options">{topics.map((topic)=><label><input type="checkbox" value={topic.id} data-topic-filter /><span>{topic.name}</span><small>{topic.entries.length}</small></label>)}</div></fieldset><fieldset><legend>Медиа</legend><label><input type="checkbox" value="with-media" data-media-filter /> Только с медиа</label></fieldset></aside>
    <main class="garden-results" aria-live="polite"><div class="garden-result-head"><p data-result-count>{entries.length} материалов</p><p data-active-filters>Все темы и форматы</p></div><div class="garden-list" data-garden-list></div><div class="garden-empty" data-garden-empty hidden>Ничего не найдено. Уберите часть фильтров или измените запрос.</div><button class="garden-more" type="button" data-garden-more>Показать ещё</button></main>
    <aside class="garden-map-panel" data-garden-map hidden><div class="section-kicker">Карта контекста</div><h2>Связи выбранного набора</h2><p>Сплошные линии означают доказанные связи. Пунктиром показаны тематические и смысловые рекомендации.</p><svg class="garden-map-svg" data-garden-map-svg viewBox="0 0 800 560" role="img" aria-label="Граф отфильтрованных материалов"></svg><ol class="garden-map-list" data-garden-map-list aria-label="Материалы на карте"></ol><p class="garden-map-note">Выберите материал, чтобы открыть его локальный граф. Для пространственного путешествия существует отдельная Вселенная.</p></aside>
  </div>
  <script is:inline type="application/json" id="garden-records" set:html={JSON.stringify(records).replace(/</g,"\\u003c")} />
  <script is:inline src="/scripts/garden-map.js"></script>
  <script is:inline src="/scripts/garden-catalog.js"></script>
</Base>
