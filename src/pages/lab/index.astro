---
import Base from "../../layouts/Base.astro";
import {
  capabilityFacets,
  complexityFacets,
  complexityLabels,
  experiments,
  platformFacets,
  stackFacets,
  typeFacets,
} from "../../data/experiments";

/* One row per facet, all built the same way. A row disappears with its whole
   vocabulary: with no headset experiment yet the platform facet still has a
   value, while "Возможности" stays hidden until the first AI or backend piece
   ships instead of offering an empty chip. */
const facetRows = [
  { key: "type", label: "Тип", any: "Все", values: typeFacets.map((value) => ({ value, label: value })) },
  { key: "platform", label: "Платформа", any: "Любая", values: platformFacets.map((value) => ({ value, label: value })) },
  { key: "capability", label: "Возможности", any: "Любые", values: capabilityFacets.map((value) => ({ value, label: value })) },
  { key: "stack", label: "Технология", any: "Все", values: stackFacets.map((value) => ({ value, label: value })) },
  { key: "complexity", label: "Сложность", any: "Любая", values: complexityFacets.map((level) => ({ value: String(level), label: complexityLabels[level] })) },
].filter((row) => row.values.length > 0);

const jsonLd = {
  "@type": "CollectionPage",
  "@id": new URL("/lab/#page", Astro.site).href,
  url: new URL("/lab/", Astro.site).href,
  name: "Лаборатория — эксперименты станивёрса",
  description: "Отдельные WebXR- и браузерные эксперименты: одни собираются из каталога experiments/<имя>/ и публикуются под /lab/<имя>/, другие живут в отдельном репозитории и публикуются на GitHub Pages.",
  inLanguage: "ru-RU",
  isPartOf: { "@id": new URL("/#website", Astro.site).href },
  hasPart: experiments.map((experiment) => ({
    "@type": "CreativeWork",
    name: experiment.title,
    description: experiment.summary,
    keywords: [...experiment.types, ...experiment.platforms, ...experiment.capabilities, ...experiment.stack].join(", "),
    url: experiment.href ? new URL(experiment.href, Astro.site).href : undefined,
  })),
};
---

<Base title="Лаборатория" description="Отдельные WebXR- и браузерные эксперименты Станислава Ермоленко: игры, приложения и инструменты — от мобильного AR до гарнитур." jsonLd={jsonLd}>
  <header class="catalog-hero">
    <div class="section-kicker">Лаборатория</div>
    <h1>Эксперименты</h1>
    <p class="hero-lead">Самостоятельные приложения, а не только игры: WebXR-сцены, демо SDK, пространственные механики, а дальше — вещи с ИИ и бэкендом. Что-то собирается из каталога <code>experiments/&lt;имя&gt;/</code> и публикуется по адресу <code>/lab/&lt;имя&gt;/</code> тем же git-пушем, что и основной сайт; что-то живёт в отдельном репозитории и уезжает на GitHub Pages. Ссылка в карточке ведёт туда, где эксперимент работает сейчас; демо с камерой стоит открывать с телефона.</p>
  </header>
  <section class="section">
    {experiments.length === 0 ? (
      <div class="lab-empty">
        <p><strong>Пока пусто — и это честно.</strong></p>
        <p>Карточки появятся здесь одновременно с первыми работающими экспериментами: конвейер сборки и публикации уже проверен, новые несут реальные демо, а не заглушки.</p>
      </div>
    ) : (
      <>
        <div class="lab-facets" data-lab-facets>
          {facetRows.map((row) => (
            <div class="catalog-controls" role="group" aria-label={row.label}>
              <span class="facet-label">{row.label}</span>
              <button type="button" class="filter-button active" data-facet={row.key} data-value="all" aria-pressed="true">{row.any}</button>
              {row.values.map((item) => <button type="button" class="filter-button" data-facet={row.key} data-value={item.value} aria-pressed="false">{item.label}</button>)}
            </div>
          ))}
          <div class="catalog-controls">
            <label class="facet-label" for="lab-sort">Сортировка</label>
            <select class="filter-button lab-sort" id="lab-sort" data-lab-sort>
              <option value="catalog">Порядок в каталоге</option>
              <option value="complexity-desc">Сложность: сначала сложные</option>
              <option value="complexity-asc">Сложность: сначала простые</option>
              <option value="title">Название: А–Я</option>
            </select>
            <output class="lab-count" data-lab-count aria-live="polite">{experiments.length} из {experiments.length}</output>
          </div>
        </div>
        <div class="card-grid" data-lab-grid>
          {experiments.map((experiment, index) => (
            <article
              class:list={["content-card", { "is-soon": experiment.status === "soon" }]}
              data-kind="experiment"
              data-index={index}
              data-title={experiment.title}
              data-types={experiment.types.join("|")}
              data-platforms={experiment.platforms.join("|")}
              data-capabilities={experiment.capabilities.join("|")}
              data-stack={experiment.stack.join("|")}
              data-complexity={experiment.complexity}
            >
              <div class="card-meta">
                <span>Эксперимент</span>
                <span>{complexityLabels[experiment.complexity]}</span>
                {experiment.status === "live"
                  ? <span class="status">Работает</span>
                  : <span class="status">Скоро</span>}
              </div>
              <h2>{experiment.title}</h2>
              <p>{experiment.summary}</p>
              <div class="tag-row is-facet">{[...experiment.types, ...experiment.platforms, ...experiment.capabilities].map((value) => <span>{value}</span>)}</div>
              <div class="tag-row">{experiment.stack.map((item) => <span>#{item}</span>)}</div>
              <div class="card-links">
                {experiment.status === "live" && experiment.href
                  ? <a class="card-arrow-link" href={experiment.href}>Открыть эксперимент <span class="card-arrow" aria-hidden="true">↗</span></a>
                  : <span class="card-arrow-link is-muted">Ещё в работе</span>}
                {experiment.status === "live" && experiment.href && experiment.repo
                  ? <a class="card-repo-link" href={experiment.repo}>Код</a>
                  : null}
              </div>
            </article>
          ))}
        </div>
        <div class="empty-state" data-lab-empty>Под такой набор фасетов экспериментов пока нет — снимите часть фильтров.</div>
      </>
    )}
  </section>
  <script is:inline>
    (() => {
      const grid = document.querySelector("[data-lab-grid]");
      if (!grid) return;
      const cards = [...grid.querySelectorAll("[data-kind='experiment']")];
      const empty = document.querySelector("[data-lab-empty]");
      const count = document.querySelector("[data-lab-count]");
      const sortSelect = document.querySelector("[data-lab-sort]");
      const state = { type: "all", platform: "all", capability: "all", stack: "all", complexity: "all", sort: "catalog" };

      const holds = (list, value) => value === "all" || (list || "").split("|").includes(value);
      const matches = (card) =>
        holds(card.dataset.types, state.type) &&
        holds(card.dataset.platforms, state.platform) &&
        holds(card.dataset.capabilities, state.capability) &&
        holds(card.dataset.stack, state.stack) &&
        (state.complexity === "all" || card.dataset.complexity === state.complexity);

      const order = (card) => Number(card.dataset.index);
      const compare = (a, b) => {
        if (state.sort === "title") return a.dataset.title.localeCompare(b.dataset.title, "ru");
        if (state.sort === "complexity-desc") return Number(b.dataset.complexity) - Number(a.dataset.complexity) || order(a) - order(b);
        if (state.sort === "complexity-asc") return Number(a.dataset.complexity) - Number(b.dataset.complexity) || order(a) - order(b);
        return order(a) - order(b);
      };

      const render = () => {
        cards.slice().sort(compare).forEach((card) => grid.append(card));
        let shown = 0;
        cards.forEach((card) => {
          const visible = matches(card);
          card.hidden = !visible;
          if (visible) shown += 1;
        });
        if (empty) empty.style.display = shown ? "none" : "block";
        if (count) count.textContent = `${shown} из ${cards.length}`;
      };

      document.querySelectorAll("[data-lab-facets] [data-facet]").forEach((button) => {
        button.addEventListener("click", () => {
          const facet = button.dataset.facet;
          state[facet] = button.dataset.value;
          document.querySelectorAll(`[data-lab-facets] [data-facet="${facet}"]`).forEach((item) => {
            const active = item === button;
            item.classList.toggle("active", active);
            item.setAttribute("aria-pressed", String(active));
          });
          render();
        });
      });
      sortSelect?.addEventListener("change", () => { state.sort = sortSelect.value; render(); });
    })();
  </script>
</Base>

<style>
  .content-card.is-soon { border-style: dashed; }
  .lab-facets { margin-bottom: var(--s-5); }
  .lab-facets .catalog-controls { margin-top: var(--s-2); }
  .facet-label { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); font-size: .68rem; letter-spacing: .09em; text-transform: uppercase; }
  .lab-sort { width: auto; padding-right: var(--s-5); color: var(--ink); font: inherit; }
  .lab-count { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); font-size: .78rem; font-variant-numeric: tabular-nums; }
  .tag-row.is-facet span { border: 1px solid var(--line); background: transparent; }
  .card-links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin-top: auto; padding-top: var(--s-3); }
  .card-arrow-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-size: .8rem; letter-spacing: .04em; }
  .card-arrow-link.is-muted { color: var(--ink-2); }
  .card-repo-link { color: var(--ink-2); font-size: .8rem; letter-spacing: .04em; border-bottom: 1px solid var(--line); }
  .card-arrow-link:hover, .card-arrow-link:focus-visible,
  .card-repo-link:hover, .card-repo-link:focus-visible { color: var(--ink); }
  .card-repo-link:hover, .card-repo-link:focus-visible { border-bottom-color: var(--accent-line); }
  .hero-lead code { font-family: ui-monospace, monospace; font-size: .85em; color: var(--ink); }
  .lab-empty { display: grid; gap: var(--s-2); max-width: 44rem; padding: var(--s-6) var(--s-5); border: 1px dashed var(--line); border-radius: var(--radius-1); color: var(--ink-2); }
  .lab-empty strong { color: var(--ink); font-weight: 550; }
</style>
