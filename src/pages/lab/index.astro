---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { hrefFor } from "../../lib/content";

/* The catalogue is the content collection itself: a facet vocabulary is derived
   from the rows, so a new experiment adds its own type, platform, capability or
   technology to the filters just by existing. A row without values never shows
   (no empty chips). */
const entries = (await getCollection("experiments")).sort((a, b) => a.data.title.localeCompare(b.data.title, "ru"));
const vocabulary = (values: string[]) => [...new Set(values)].sort((a, b) => a.localeCompare(b, "ru"));
const facetRows = [
  { key: "type", label: "Тип", any: "Все", values: vocabulary(entries.flatMap((entry) => entry.data.types)) },
  { key: "platform", label: "Платформа", any: "Любая", values: vocabulary(entries.flatMap((entry) => entry.data.platforms)) },
  { key: "capability", label: "Возможности", any: "Любые", values: vocabulary(entries.flatMap((entry) => entry.data.capabilities)) },
  { key: "stack", label: "Технология", any: "Все", values: vocabulary(entries.flatMap((entry) => entry.data.stack)) },

].filter((row) => row.values.length > 0);
const facetField: Record<string, "types" | "platforms" | "capabilities" | "stack"> = { type: "types", platform: "platforms", capability: "capabilities", stack: "stack" };
const facetCount = (key: string, value: string) => entries.filter((entry) => (entry.data[facetField[key] ?? "types"]).includes(value)).length;

const jsonLd = {
  "@type": "CollectionPage",
  "@id": new URL("/lab/#page", Astro.site).href,
  url: new URL("/lab/", Astro.site).href,
  name: "Лаборатория — эксперименты станивёрса",
  description: "Отдельные WebXR- и браузерные эксперименты: игры, приложения и арт-опыты — от мобильного AR до гарнитур. У каждого есть запуск и страница с разбором механики.",
  inLanguage: "ru-RU",
  isPartOf: { "@id": new URL("/#website", Astro.site).href },
  hasPart: entries.map((entry) => ({
    "@type": "CreativeWork",
    name: entry.data.title,
    description: entry.data.summary,
    keywords: [...entry.data.types, ...entry.data.platforms, ...entry.data.capabilities, ...entry.data.stack].join(", "),
    url: entry.data.href ?? new URL(hrefFor(entry), Astro.site).href,
  })),
};
---

<Base title="Лаборатория" description="Отдельные WebXR- и браузерные эксперименты Станислава Ермоленко: игры, приложения и арт-опыты — от мобильного AR до гарнитур. У каждого есть запуск и разбор механики." jsonLd={jsonLd}>
  <header class="catalog-hero">
    <div class="section-kicker">Лаборатория</div>
    <h1>Эксперименты</h1>
    <p class="hero-lead">Самостоятельные приложения, а не только игры: WebXR-сцены, демо SDK, пространственные механики, а дальше — вещи с ИИ и бэкендом. Каждый эксперимент запускается по ссылке из карточки, а рядом лежит короткий разбор: что внутри и как этим пользоваться. Опыты на Google XR Blocks рассчитаны прежде всего на Quest 3; в Safari на iOS нужных возможностей WebXR может не быть, поэтому такие демо там могут не запуститься. Демо с камерой стоит открывать с телефона.</p>
  </header>
  <section class="section">
    {entries.length === 0 ? (
      <div class="lab-empty">
        <p><strong>Пока пусто — и это честно.</strong></p>
        <p>Карточки появятся здесь одновременно с первыми работающими экспериментами.</p>
      </div>
    ) : (
      <>
        <div class="lab-facets" data-lab-facets>
          {facetRows.map((row) => (
            <div class="catalog-controls" role="group" aria-label={row.label}>
              <span class="facet-label">{row.label}</span>
              <button type="button" class="filter-button active" data-facet={row.key} data-value="all" aria-pressed="true">{row.any}<small>{entries.length}</small></button>
              {row.values.map((value) => <button type="button" class="filter-button" data-facet={row.key} data-value={value} aria-pressed="false">{value}<small>{facetCount(row.key, value)}</small></button>)}
            </div>
          ))}
          <div class="catalog-controls">
            <label class="facet-label" for="lab-sort">Сортировка</label>
            <select class="filter-button lab-sort" id="lab-sort" data-lab-sort>
              <option value="catalog">Порядок в каталоге</option>
              <option value="title">Название: А–Я</option>
            </select>
            <output class="lab-count" data-lab-count aria-live="polite">{entries.length} из {entries.length}</output>
          </div>
        </div>
        <div class="card-grid" data-lab-grid>
          {entries.map((entry, index) => (
            <article
              class:list={["content-card", { "is-soon": entry.data.status === "soon" }]}
              id={entry.id}
              data-kind="experiment"
              data-index={index}
              data-title={entry.data.title}
              data-types={entry.data.types.join("|")}
              data-platforms={entry.data.platforms.join("|")}
              data-capabilities={entry.data.capabilities.join("|")}
              data-stack={entry.data.stack.join("|")}
            >
              <div class="card-meta">
                <span>Эксперимент</span>
                {entry.data.status === "live"
                  ? <span class="status">Работает</span>
                  : <span class="status">Скоро</span>}
              </div>
              <h2><a class="card-title-link" href={hrefFor(entry)}>{entry.data.title}</a></h2>
              <p>{entry.data.summary}</p>
              <div class="tag-row is-facet">{[...entry.data.types, ...entry.data.platforms, ...entry.data.capabilities].map((value) => <span>{value}</span>)}</div>
              <div class="tag-row">{entry.data.stack.map((item) => <span>#{item}</span>)}</div>
              <div class="card-links">
                {entry.data.status === "live" && entry.data.href
                  ? <a class="card-arrow-link" href={entry.data.href}>Открыть опыт <span class="card-arrow" aria-hidden="true">↗</span></a>
                  : <span class="card-arrow-link is-muted">Ещё в работе</span>}
                <a class="card-repo-link" href={hrefFor(entry)}>Разбор механики</a>
                {entry.data.repo ? <a class="card-repo-link" href={entry.data.repo}>Код</a> : null}
              </div>
            </article>
          ))}
        </div>
        <div class="empty-state" data-lab-empty>Под такой набор фасетов экспериментов пока нет — снимите часть фильтров.</div>
      </>
    )}
  </section>
  <script is:inline>
    (() => {
      const grid = document.querySelector("[data-lab-grid]");
      if (!grid) return;
      const cards = [...grid.querySelectorAll("[data-kind='experiment']")];
      const empty = document.querySelector("[data-lab-empty]");
      const count = document.querySelector("[data-lab-count]");
      const sortSelect = document.querySelector("[data-lab-sort]");
      const state = { type: "all", platform: "all", capability: "all", stack: "all", sort: "catalog" };

      const holds = (list, value) => value === "all" || (list || "").split("|").includes(value);
      const matches = (card) =>
        holds(card.dataset.types, state.type) &&
        holds(card.dataset.platforms, state.platform) &&
        holds(card.dataset.capabilities, state.capability) &&
        holds(card.dataset.stack, state.stack);

      const order = (card) => Number(card.dataset.index);
      const compare = (a, b) => {
        if (state.sort === "title") return a.dataset.title.localeCompare(b.dataset.title, "ru");
        return order(a) - order(b);
      };

      const render = () => {
        cards.slice().sort(compare).forEach((card) => grid.append(card));
        let shown = 0;
        cards.forEach((card) => {
          const visible = matches(card);
          card.hidden = !visible;
          if (visible) shown += 1;
        });
        if (empty) empty.style.display = shown ? "none" : "block";
        if (count) count.textContent = `${shown} из ${cards.length}`;
      };

      document.querySelectorAll("[data-lab-facets] [data-facet]").forEach((button) => {
        button.addEventListener("click", () => {
          const facet = button.dataset.facet;
          state[facet] = button.dataset.value;
          document.querySelectorAll(`[data-lab-facets] [data-facet="${facet}"]`).forEach((item) => {
            const active = item === button;
            item.classList.toggle("active", active);
            item.setAttribute("aria-pressed", String(active));
          });
          render();
        });
      });
      sortSelect?.addEventListener("change", () => { state.sort = sortSelect.value; render(); });
    })();
  </script>
</Base>

<style>
  .content-card.is-soon { border-style: dashed; }
  .lab-facets { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem var(--s-6); max-width: 84rem; margin-bottom: var(--s-5); }
  .lab-facets .catalog-controls { flex: 0 1 auto; margin-top: 0; }
  .facet-label { display: inline-flex; align-items: center; min-height: 44px; margin-right: var(--s-1); color: var(--ink-2); font-size: .68rem; letter-spacing: .09em; text-transform: uppercase; }
  .lab-sort { width: auto; padding-right: var(--s-5); color: var(--ink); font: inherit; }
  .lab-count { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); font-size: .78rem; font-variant-numeric: tabular-nums; }
  .tag-row.is-facet span { border: 1px solid var(--line); background: transparent; }
  .card-title-link { color: inherit; text-decoration: none; }
  .card-title-link:hover, .card-title-link:focus-visible { color: var(--accent); }
  .card-links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin-top: auto; padding-top: var(--s-3); }
  .card-arrow-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-size: .8rem; letter-spacing: .04em; }
  .card-arrow-link.is-muted { color: var(--ink-2); }
  .card-repo-link { color: var(--ink-2); font-size: .8rem; letter-spacing: .04em; border-bottom: 1px solid var(--line); }
  .card-arrow-link:hover, .card-arrow-link:focus-visible,
  .card-repo-link:hover, .card-repo-link:focus-visible { color: var(--ink); }
  .card-repo-link:hover, .card-repo-link:focus-visible { border-bottom-color: var(--accent-line); }
  .hero-lead code { font-family: ui-monospace, monospace; font-size: .85em; color: var(--ink); }
  .lab-empty { display: grid; gap: var(--s-2); max-width: 44rem; padding: var(--s-6) var(--s-5); border: 1px dashed var(--line); border-radius: var(--radius-1); color: var(--ink-2); }
  .lab-empty strong { color: var(--ink); font-weight: 550; }
</style>
