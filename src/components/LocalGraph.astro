---
import type { GraphEdge, GraphNode } from "../lib/graph";
import { buildDirectedRelations, buildLocalGraph, buildLocalGraphView } from "./localGraph";
import { provenanceField } from "../lib/graph-visuals";

interface Props {
  currentId: string;
  nodes: GraphNode[];
  edges: GraphEdge[];
}

const { currentId, nodes, edges } = Astro.props;
const graph = buildLocalGraph(currentId, nodes, edges, 3);
const view = buildLocalGraphView(graph);
const directions = buildDirectedRelations(currentId, nodes, edges);
const connected = graph.nodes.some((node) => node.depth > 0);
const depthWord = (depth: number) => depth === 1 ? "уровень" : "уровня";
const nodeLabel = (node: { depth: number; kind?: string }) => node.kind === "topic" ? "тема, ведёт на страницу темы" : node.depth === 0 ? "текущий материал" : `${node.depth} ${depthWord(node.depth)}`;
const maxGraphDepth = Math.max(0, ...graph.nodes.map((node) => node.depth));
const availableDepths = [1, 2, 3].filter((depth) => depth <= maxGraphDepth);
const arrowMarkerId = `local-graph-arrow-${currentId.replace(/[^a-z0-9]+/gi, "-")}`;
---

<aside class="local-graph local-graph-v2" aria-labelledby="local-graph-title" data-local-graph data-current-id={currentId}>
  <header class="local-graph__header">
    <p class="local-graph__kicker">Локальный граф</p>
    <h2 id="local-graph-title">Связи рядом</h2>
    <p class="local-graph__intro">{maxGraphDepth > 1 ? "Один шаг показывает прямой контекст. Увеличьте глубину, чтобы увидеть соседние слои." : "Здесь показан прямой контекст материала."}</p>
  </header>

  {maxGraphDepth > 1 && <div class="local-graph__controls" role="group" aria-label="Глубина графа">
    <span class="local-graph__controls-label">Глубина</span>
    {availableDepths.map((depth) => (
      <button type="button" class="local-graph__depth-button" data-depth-button={depth} aria-pressed={depth === 1 ? "true" : "false"}>
        {depth} <span>{depthWord(depth)}</span>
      </button>
    ))}
  </div>}

  {connected ? (
    <>
      <div class="local-graph__legend" aria-label="Легенда связей">
        <span class="local-graph__legend-item"><i class="local-graph__legend-line is-solid" aria-hidden="true"></i>Подтверждённая связь</span>
        <span class="local-graph__legend-item"><i class="local-graph__legend-line is-dotted" aria-hidden="true"></i>Тема или семантика</span>
        <span class="local-graph__legend-item"><i class="local-graph__legend-line is-directional" aria-hidden="true"></i>Причинная связь</span>
      </div>

      <svg
        class="local-graph__stage"
        data-local-graph-stage
        data-depth="1"
        viewBox="0 0 720 880"
        role="img"
        aria-label={`Граф окрестности: ${view.nodes.length} узлов, ${view.links.length} связей`}
        aria-describedby="local-graph-keyboard-help"
      >
        <defs>
          <marker id={arrowMarkerId} class="local-graph__arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" />
          </marker>
        </defs>
        <g data-graph-view>
          <g class="local-graph__edges" aria-hidden="true">
          {view.links.map((link) => {
            const dx = link.x2 - link.x1;
            const dy = link.y2 - link.y1;
            const distance = Math.hypot(dx, dy) || 1;
            const inset = link.causal ? 9 : 0;
            return (
              <line
                class:list={["local-graph__edge", link.causal ? "is-causal" : link.dotted ? "is-dotted" : "is-solid"]}
                data-edge-depth={link.depth}
                data-edge-source={link.source}
                data-edge-target={link.target}
                x1={link.x1 + (dx / distance) * inset}
                y1={link.y1 + (dy / distance) * inset}
                x2={link.x2 - (dx / distance) * inset}
                y2={link.y2 - (dy / distance) * inset}
                marker-end={link.causal ? `url(#${arrowMarkerId})` : undefined}
              />
            );
          })}
        </g>
        <g class="local-graph__labels" aria-hidden="true">
          {view.labels.map((label) => (
            <text class="local-graph__label" data-label-depth={label.depth} x={label.x} y={label.y} text-anchor={label.anchor}>{label.text}</text>
          ))}
        </g>
        <g class="local-graph__nodes" role="list" aria-label="Узлы локального графа">
          {view.nodes.map((node) => (
            <a
              class:list={["local-graph__node", node.depth === 0 && "is-current", node.kind === "topic" && "is-topic"]}
              data-node-depth={node.depth}
              data-node-id={node.id}
              data-focus-node
              hidden={node.depth > 1}
              href={node.href}
              aria-current={node.depth === 0 ? "page" : undefined}
              aria-label={`${node.title}, ${nodeLabel(node)}`}
            >
              <title>{`${node.title} — ${nodeLabel(node)}`}</title>
              <circle class="local-graph__hit" cx={node.x} cy={node.y} r="15" />
              <circle class="local-graph__dot" cx={node.x} cy={node.y} r={node.r} />
            </a>
          ))}
        </g>
        </g>
      </svg>
      <p class="local-graph__keyboard-help" id="local-graph-keyboard-help">Клавиши стрелок переходят между узлами, Enter открывает выбранный материал. Колесо приближает, протягивание сдвигает, двойной клик возвращает исходный вид.</p>

      <section class="local-graph__directions" aria-labelledby="local-graph-directions-title">
        <h3 class="local-graph__directions-title" id="local-graph-directions-title">Связи по направлениям</h3>
        <p class="local-graph__directions-intro">Прямые связи этого материала. Стрелка показывает, откуда связь ведёт, а подпись — что она означает.</p>
        {directions.map((direction) => (
          <details class="local-graph__direction" data-relation-direction={direction.id}>
            <summary>
              <span>{direction.heading}</span>
              <span class="local-graph__direction-count">{direction.relations.length}</span>
              <span class="local-graph__direction-hint">{direction.hint}</span>
            </summary>
            {direction.relations.length > 0 ? (
              <ol class="local-graph__direction-list" aria-label={`${direction.heading} связи`}>
                {direction.relations.map((relation) => (
                  <li class:list={["local-graph__direction-item", relation.inferred && "is-inferred", relation.causal && "is-causal"]}>
                    <p class="local-graph__direction-line">
                      <span class="local-graph__direction-arrow" aria-hidden="true">{direction.id === "outgoing" ? "→" : "←"}</span>
                      <a class="local-graph__direction-link" href={relation.href}>{relation.title}</a>
                      <span class:list={["local-graph__relation-label", relation.causal && "is-causal"]}>{relation.label}</span>
                      <span class="local-graph__relation-confidence">{Math.round(relation.confidence * 100)}%</span>
                    </p>
                    <p class="local-graph__direction-meta">
                      <span>Основание: {relation.evidence}</span>
                      {relation.status ? <span class="local-graph__direction-status">{relation.status}</span> : null}
                    </p>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="local-graph__direction-empty">{direction.emptyText}</p>
            )}
          </details>
        ))}
      </section>

      <details class="local-graph__disclosure">
        <summary>Показать список узлов</summary>
        <ol class="local-graph__list" aria-label="Список узлов локального графа">
          {graph.nodes.map((node) => (
            <li data-list-depth={node.depth} hidden={node.depth > 1}>
              <a href={node.href} aria-current={node.depth === 0 ? "page" : undefined}>{node.title}</a>
              <span>{nodeLabel(node)}</span>
            </li>
          ))}
        </ol>
      </details>

      <details class="local-graph__disclosure local-graph__evidence">
        <summary>Показать доказательства связей</summary>
        <ol class="local-graph__relations" aria-label="Доказательства связей">
          {graph.edges.map((edge) => (
            <li data-relation-depth={edge.depth} hidden={edge.depth > 1}>
              <details>
                <summary>
                  <span>{edge.sourceNode?.title ?? edge.source} → {edge.targetNode?.title ?? edge.target}</span>
                  <span class:list={["local-graph__relation-label", edge.causal && "is-causal"]}>{edge.label}</span>
                  <span class="local-graph__relation-confidence">{Math.round(edge.confidence * 100)}%</span>
                </summary>
                <dl>
                  <div><dt>Связь</dt><dd>{edge.label}</dd></div>
                  <div><dt>Тип</dt><dd>{edge.type}</dd></div>
                  <div><dt>Основание</dt><dd>{edge.evidence}</dd></div>
                  <div><dt>Уверенность</dt><dd>{Math.round(edge.confidence * 100)}%</dd></div>
                  {edge.explanation ? <div><dt>Объяснение</dt><dd>{edge.explanation}</dd></div> : null}
                  {edge.reviewStatus || edge.status ? <div><dt>Статус проверки</dt><dd>{edge.reviewStatus ?? edge.status}</dd></div> : null}
                  {edge.provenance ? (
                    <>
                      {provenanceField(edge.provenance, "source") ? <div><dt>Источник</dt><dd>{provenanceField(edge.provenance, "source")}</dd></div> : null}
                      {provenanceField(edge.provenance, "method") ? <div><dt>Метод</dt><dd>{provenanceField(edge.provenance, "method")}</dd></div> : null}
                      {provenanceField(edge.provenance, "extractor") ? <div><dt>Извлекатель</dt><dd>{provenanceField(edge.provenance, "extractor")}</dd></div> : null}
                    </>
                  ) : null}
                </dl>
              </details>
            </li>
          ))}
        </ol>
      </details>
    </>
  ) : (
    <div class="local-graph__empty" role="status">
      <span class="local-graph__empty-mark" aria-hidden="true">∅</span>
      <h3>{graph.current ? "У этого материала пока нет соседей" : "Материал не найден в графе"}</h3>
      <p>{graph.current ? "Связи появятся, когда для записи будет добавлено подтверждённое отношение или общая тема." : "Попробуйте открыть материал из каталога или вернуться к карте вселенной."}</p>
    </div>
  )}

  <a class="local-graph__universe-link" href={`/universe/?focus=${encodeURIComponent(currentId)}`}>Открыть во Вселенной <span aria-hidden="true">↗</span></a>
  <p class="local-graph__status" data-graph-status aria-live="polite"></p>
</aside>

<script>
  import { pluralRu } from "../lib/plural";
  import { mountGraphView } from "../lib/svg-graph-view";

  const roots = document.querySelectorAll<HTMLElement>("[data-local-graph]");

  roots.forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>("[data-local-graph-stage]");
    if (stage) mountGraphView(stage, { touch: true });
    const depthButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-depth-button]")];
    const status = root.querySelector<HTMLElement>("[data-graph-status]");
    const drawnNodes = [...root.querySelectorAll<SVGElement>("[data-focus-node]")];
    const drawnEdges = [...root.querySelectorAll<SVGLineElement>("[data-edge-depth]")];
    const isHidden = (element: Element) => element.hasAttribute("hidden");
    const setHidden = (element: Element, hidden: boolean) => element.toggleAttribute("hidden", hidden);
    const dataset = (element: Element) => (element as HTMLElement).dataset;
    let selectedDepth = 1;

    /* Pointing at a dot answers with that node's own neighbourhood: everything
       outside it steps back, the way a graph view reads under the pointer. */
    const neighbours = new Map<string, Set<string>>();
    for (const edge of drawnEdges) {
      const source = edge.dataset.edgeSource ?? "";
      const target = edge.dataset.edgeTarget ?? "";
      neighbours.set(source, (neighbours.get(source) ?? new Set()).add(target));
      neighbours.set(target, (neighbours.get(target) ?? new Set()).add(source));
    }
    const highlight = (id?: string) => {
      for (const node of drawnNodes) {
        const key = dataset(node).nodeId ?? "";
        const linked = Boolean(id) && (key === id || neighbours.get(id ?? "")?.has(key));
        node.classList.toggle("is-hot", key === id);
        node.classList.toggle("is-linked", Boolean(linked) && key !== id);
        node.classList.toggle("is-dim", Boolean(id) && !linked);
      }
      for (const edge of drawnEdges) {
        const touches = Boolean(id) && (edge.dataset.edgeSource === id || edge.dataset.edgeTarget === id);
        edge.classList.toggle("is-hot", touches);
        edge.classList.toggle("is-dim", Boolean(id) && !touches);
      }
    };
    const nodeFrom = (target: EventTarget | null) => (target instanceof Element ? target.closest<SVGElement>("[data-focus-node]") : null);
    stage?.addEventListener("pointerover", (event) => {
      const node = nodeFrom(event.target);
      if (node) highlight(dataset(node).nodeId);
    });
    stage?.addEventListener("pointerout", (event) => {
      if (!nodeFrom(event.relatedTarget)) highlight();
    });
    stage?.addEventListener("focusin", (event) => {
      const node = nodeFrom(event.target);
      if (node) highlight(dataset(node).nodeId);
    });
    stage?.addEventListener("focusout", () => highlight());

    const sync = () => {
      stage?.setAttribute("data-depth", String(selectedDepth));
      for (const button of depthButtons) button.setAttribute("aria-pressed", String(Number(button.dataset.depthButton) === selectedDepth));
      for (const node of drawnNodes) setHidden(node, Number(dataset(node).nodeDepth) > selectedDepth);
      for (const edge of drawnEdges) setHidden(edge, Number(edge.dataset.edgeDepth) > selectedDepth);
      root.querySelectorAll("[data-list-depth]").forEach((item) => setHidden(item, Number(dataset(item).listDepth) > selectedDepth));
      root.querySelectorAll("[data-relation-depth]").forEach((item) => setHidden(item, Number(dataset(item).relationDepth) > selectedDepth));
      if (status) {
        const shownNodes = drawnNodes.filter((node) => !isHidden(node)).length;
        const shownEdges = drawnEdges.filter((edge) => !isHidden(edge)).length;
        status.textContent = `${pluralRu(shownNodes, "узел", "узла", "узлов")} · ${pluralRu(shownEdges, "связь", "связи", "связей")}`;
      }
    };

    depthButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedDepth = Number(button.dataset.depthButton) || 1;
        sync();
      });
    });

    root.addEventListener("keydown", (event) => {
      if (!(event.target instanceof Element) || !event.target.matches("[data-focus-node]")) return;
      const visible = drawnNodes.filter((node) => !isHidden(node));
      const currentIndex = visible.indexOf(event.target as SVGElement);
      if (currentIndex < 0) return;
      const forward = event.key === "ArrowRight" || event.key === "ArrowDown";
      const backward = event.key === "ArrowLeft" || event.key === "ArrowUp";
      const targetIndex = forward ? (currentIndex + 1) % visible.length : backward ? (currentIndex - 1 + visible.length) % visible.length : event.key === "Home" ? 0 : event.key === "End" ? visible.length - 1 : -1;
      if (targetIndex < 0) return;
      event.preventDefault();
      (visible[targetIndex] as SVGElement & { focus?: () => void }).focus?.();
    });

    sync();
  });
</script>

<style>
  .local-graph-v2 {
    --local-bg: #0b1320;
    --local-surface: #101c2c;
    --local-surface-raised: #15243a;
    --local-line: #29405a;
    --local-muted: #95a8bf;
    --local-text: #e8f3fb;
    --local-cyan: #66dff4;
    --local-cyan-soft: rgba(102, 223, 244, .2);
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid var(--local-line);
    border-radius: 1rem;
    background: var(--local-bg);
    color: var(--local-text);
  }

  .local-graph-v2 :where(a, button, summary):focus-visible {
    outline: 2px solid var(--local-cyan);
    outline-offset: 3px;
  }
  .local-graph-v2 [hidden] { display: none !important; }

  .local-graph__header { display: grid; gap: .45rem; }
  .local-graph__kicker { margin: 0; color: var(--local-cyan); font: 600 .65rem/1.2 ui-monospace, SFMono-Regular, monospace; letter-spacing: .14em; text-transform: uppercase; }
  .local-graph__header h2 { margin: 0; color: var(--local-text); font: 600 clamp(1.15rem, 2vw, 1.45rem)/1.15 Unbounded, system-ui, sans-serif; overflow-wrap: anywhere; }
  .local-graph__intro { margin: 0; color: var(--local-muted); font-size: .82rem; line-height: 1.5; }

  .local-graph__controls { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: 1rem 0 .75rem; }
  .local-graph__controls-label { margin-right: .2rem; color: var(--local-muted); font-size: .72rem; }
  .local-graph__depth-button { padding: .4rem .62rem; border: 1px solid var(--local-line); border-radius: .55rem; background: transparent; color: var(--local-muted); font: inherit; font-size: .72rem; cursor: pointer; transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; }
  .local-graph__depth-button:hover { border-color: var(--local-cyan); color: var(--local-text); }
  .local-graph__depth-button:active { transform: translateY(1px); }
  .local-graph__depth-button[aria-pressed="true"] { border-color: var(--local-cyan); background: var(--local-cyan); color: #07151c; }
  .local-graph__depth-button span { display: none; }

  .local-graph__legend { display: flex; flex-wrap: wrap; gap: .75rem; margin: .45rem 0 .7rem; color: var(--local-muted); font-size: .68rem; }
  .local-graph__legend-item { display: inline-flex; align-items: center; gap: .35rem; }
  .local-graph__legend-line { display: inline-block; width: 1.4rem; border-top: 2px solid var(--local-cyan); }
  .local-graph__legend-line.is-dotted { border-top-style: dotted; border-top-color: #8094ac; }
  .local-graph__legend-line.is-directional { position: relative; border-top-color: #f1b7dd; }
  .local-graph__legend-line.is-directional::after { position: absolute; top: -5px; right: -1px; border-top: 4px solid transparent; border-bottom: 4px solid transparent; border-left: 6px solid #f1b7dd; content: ""; }

  /* The neighbourhood is drawn as dots on a force layout: deeper rings appear
     where the force put them, without moving what the reader already located. */
  .local-graph__stage { display: block; width: 100%; height: auto; margin: 0 -.15rem .75rem; border: 1px solid rgba(102, 223, 244, .16); border-radius: .8rem; background: linear-gradient(145deg, #101e2e, #0a121f 72%); cursor: grab; touch-action: pan-y; user-select: none; }
  .local-graph__stage.is-panning { cursor: grabbing; }
  .local-graph__edges, .local-graph__labels { pointer-events: none; }
  .local-graph__edge { stroke: #63b9cf; stroke-width: 1; vector-effect: non-scaling-stroke; transition: opacity .2s ease, stroke-width .2s ease; }
  .local-graph__edge.is-dotted { stroke: #7289a3; stroke-dasharray: 2.5 3.5; }
  .local-graph__edge.is-causal { stroke: #f1b7dd; stroke-width: 1.4; }
  .local-graph__edge.is-dim { opacity: .12; }
  .local-graph__edge.is-hot { stroke-width: 2.2; }
  .local-graph__arrow path { fill: #f1b7dd; }
  .local-graph__node { cursor: pointer; transition: opacity .2s ease; }
  .local-graph__node.is-dim { opacity: .25; }
  .local-graph__hit { fill: transparent; pointer-events: all; }
  .local-graph__dot { fill: var(--local-cyan); stroke: var(--local-bg); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .local-graph__node.is-topic .local-graph__dot { fill: var(--local-bg); stroke: var(--local-cyan); }
  .local-graph__node.is-linked .local-graph__dot,
  .local-graph__node.is-current .local-graph__dot,
  .local-graph__node:hover .local-graph__dot,
  .local-graph__node:focus-visible .local-graph__dot { stroke: #ffffff; }
  .local-graph__label { fill: var(--local-muted); font-size: 13px; paint-order: stroke; stroke: var(--local-bg); stroke-width: 4px; stroke-linejoin: round; }
  /* Labels follow the stage depth in CSS, so the rings stay correct without scripts. */
  .local-graph__stage[data-depth="1"] .local-graph__label:not([data-label-depth="1"]),
  .local-graph__stage[data-depth="2"] .local-graph__label[data-label-depth="3"] { display: none; }
  .local-graph__keyboard-help { margin: 0 0 .75rem; color: var(--local-muted); font-size: .68rem; line-height: 1.45; }

  .local-graph__directions { margin: 0 0 .35rem; border-top: 1px solid rgba(102, 223, 244, .16); }
  .local-graph__directions-title { margin: .8rem 0 .25rem; color: var(--local-text); font-size: .85rem; }
  .local-graph__directions-intro { margin: 0 0 .2rem; color: var(--local-muted); font-size: .7rem; line-height: 1.45; }
  .local-graph__direction { border-top: 1px solid rgba(102, 223, 244, .12); }
  .local-graph__direction summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem; padding: .6rem 0; color: var(--local-text); font-size: .78rem; cursor: pointer; }
  .local-graph__direction-count { padding: 0 .38rem; border: 1px solid var(--local-line); border-radius: 999px; color: var(--local-cyan); font-size: .64rem; }
  .local-graph__direction-hint { color: var(--local-muted); font-size: .66rem; }
  .local-graph__direction-list { display: grid; gap: .35rem; margin: 0 0 .8rem; padding: 0; list-style: none; }
  .local-graph__direction-item { display: grid; gap: .18rem; padding: .45rem .55rem; border: 1px solid rgba(102, 223, 244, .14); border-radius: .55rem; background: var(--local-surface); }
  .local-graph__direction-item.is-inferred { border-color: #3c526b; border-style: dashed; }
  .local-graph__direction-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem; margin: 0; }
  .local-graph__direction-arrow { color: var(--local-cyan); font-size: .74rem; }
  .local-graph__direction-link { flex: 1 1 auto; min-width: 0; color: var(--local-text); font-size: .74rem; line-height: 1.3; text-underline-offset: .2em; overflow-wrap: anywhere; }
  .local-graph__direction-item.is-inferred .local-graph__direction-link { color: var(--local-muted); }
  .local-graph__direction-meta { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; color: #7790aa; font-size: .62rem; }
  .local-graph__direction-status { color: var(--local-cyan); }
  .local-graph__direction-empty { margin: 0 0 .8rem; color: var(--local-muted); font-size: .7rem; line-height: 1.45; }

  .local-graph__disclosure { border-top: 1px solid rgba(102, 223, 244, .16); }
  .local-graph__disclosure summary { padding: .7rem 0; color: var(--local-text); font-size: .78rem; cursor: pointer; }
  .local-graph__list, .local-graph__relations { display: grid; gap: .3rem; margin: 0 0 .8rem; padding-left: 1.2rem; color: var(--local-muted); font-size: .72rem; }
  .local-graph__list li { display: flex; justify-content: space-between; gap: .7rem; padding: .2rem 0; }
  .local-graph__list a { color: var(--local-text); }
  .local-graph__list span { white-space: nowrap; }
  .local-graph__relations { gap: .45rem; }
  .local-graph__relations details { margin-left: -.2rem; }
  .local-graph__relations summary { display: flex; justify-content: space-between; gap: .5rem; color: var(--local-text); cursor: pointer; }
