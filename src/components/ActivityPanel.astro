---
/**
 * A quiet activity panel for sidebars: a half-year writing calendar plus the
 * few stats a person actually rereads — totals, the weekday that carries the
 * most posts, average length, and the topics that recur. Data arrives already
 * scoped by the caller (garden corpus or one channel), so the panel never
 * decides what counts as activity.
 */
interface Props {
  dates: string[];
  chars: number[];
  topics: string[];
  heading: string;
  avgLabel: string;
  unit: "запись" | "материал";
  weeks?: number;
}

const { dates, chars, topics, heading, avgLabel, unit, weeks = 26 } = Astro.props;

const unitForms: Record<Props["unit"], [string, string, string]> = {
  "запись": ["запись", "записи", "записей"],
  "материал": ["материал", "материала", "материалов"],
};
const plural = (n: number, forms: [string, string, string]) => {
  const tail = Math.abs(n) % 100;
  const last = tail % 10;
  return forms[tail > 10 && tail < 20 ? 2 : last === 1 ? 0 : last >= 2 && last <= 4 ? 1 : 2];
};

const countByDay = new Map<string, number>();
const date = (value: Date) => `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
for (const day of dates) countByDay.set(day, (countByDay.get(day) ?? 0) + 1);

const perWeekday = [0, 0, 0, 0, 0, 0, 0];
for (const day of dates) perWeekday[new Date(`${day}T12:00:00`).getDay()] += 1;
const total = dates.length;
/* JS weeks start on Sunday; the calendar and the copy read Monday-first. */
const weekdayOrder = [1, 2, 3, 4, 5, 6, 0].map((index) => perWeekday[index]);
const busiest = weekdayOrder.indexOf(Math.max(...weekdayOrder));
const busiestShare = total ? Math.round((weekdayOrder[busiest] / total) * 100) : 0;
const byWeekday = ["понедельникам", "вторникам", "средам", "четвергам", "пятницам", "субботам", "воскресеньям"];

const average = chars.length ? Math.round(chars.reduce((sum, value) => sum + value, 0) / chars.length) : 0;

const topicCounts = new Map<string, number>();
for (const topic of topics) topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
const topTopics = [...topicCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "ru")).slice(0, 6);

const today = new Date();
today.setHours(12, 0, 0, 0);
const start = new Date(today);
start.setDate(start.getDate() - (weeks * 7 - 1));
start.setDate(start.getDate() - ((start.getDay() + 6) % 7));

const shortMonth = new Intl.DateTimeFormat("ru-RU", { month: "short" });
const dayLabel = new Intl.DateTimeFormat("ru-RU", { day: "numeric", month: "long" });

interface Cell { key: string; title: string; level: number; today: boolean }
const cells: Cell[] = [];
const monthMarks: { column: number; label: string }[] = [];
let cursor = new Date(start);
let column = -1;
let previousMonth = -1;
while (cursor <= today) {
  const index = Math.floor((cursor.getTime() - start.getTime()) / 86400000);
  const inColumn = Math.floor(index / 7);
  if (inColumn !== column) {
    column = inColumn;
    if (cursor.getMonth() !== previousMonth) {
      previousMonth = cursor.getMonth();
      monthMarks.push({ column, label: shortMonth.format(cursor).replace(".", "") });
    }
  }
  const key = date(cursor);
  const count = countByDay.get(key) ?? 0;
  cells.push({
    key,
    level: count === 0 ? 0 : count === 1 ? 1 : count <= 3 ? 2 : 3,
    today: key === date(today),
    title: count ? `${dayLabel.format(cursor)} — ${count} ${plural(count, unitForms[unit])}` : `${dayLabel.format(cursor)} — ${unit === "запись" ? "без записей" : "без материалов"}`,
  });
  cursor = new Date(cursor.getTime() + 86400000);
}
const marked = new Map(monthMarks.map((mark) => [mark.column, mark.label]));
---

<section class="activity" aria-labelledby="activity-title">
  <div class="activity-head">
    <h2 id="activity-title">{heading}</h2>
  </div>

  <div class="activity-calendar" role="img" aria-label={`Календарь активности: ${total} ${plural(total, unitForms[unit])} за последние ${weeks} недель`}>
    <div class="activity-months" aria-hidden="true">
      {Array.from({ length: column + 1 }, (_, index) => <span>{marked.get(index) ?? ""}</span>)}
    </div>
    <div class="activity-body">
      <div class="activity-weekdays" aria-hidden="true"><span>пн</span><span></span><span>ср</span><span></span><span>пт</span><span></span><span></span></div>
      <div class="activity-grid" aria-hidden="true">
        {cells.map((cell) => <span class:list={["activity-cell", `is-level-${cell.level}`, cell.today && "is-today"]} title={cell.title} />)}
      </div>
    </div>
  </div>

  <dl class="activity-stats">
    <div><dt>Всего</dt><dd>{total}</dd></div>
    <div><dt>Чаще всего пишу</dt><dd>по {byWeekday[busiest]} <small>{busiestShare}%</small></dd></div>
    <div><dt>{avgLabel}</dt><dd>{average.toLocaleString("ru-RU")} <small>знаков</small></dd></div>
  </dl>

  {topTopics.length > 0 && (
    <div class="activity-topics">
      <span class="activity-topics-label">Частые темы</span>
      <div class="activity-chips">{topTopics.map(([topic, count]) => <span>{topic}<small>{count}</small></span>)}</div>
    </div>
  )}
</section>

<style>
  .activity { min-width: 0; }
  .activity-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); margin: 0 0 var(--s-3); }
  .activity-head h2 { margin: 0; font: 500 1rem / 1.2 var(--font-display); letter-spacing: -.01em; }

  .activity-months { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); margin: 0 0 .35rem; padding-left: calc(1.7rem + 2px); }
  .activity-months span { overflow: visible; color: var(--ink-2); font-size: .58rem; line-height: 1; white-space: nowrap; }
  .activity-body { display: flex; gap: .35rem; }
  .activity-weekdays { display: grid; grid-template-rows: repeat(7, 1fr); width: 1.35rem; color: var(--ink-2); font-size: .58rem; line-height: 1; }
  .activity-weekdays span { display: flex; align-items: center; }
  .activity-grid { display: grid; grid-template-rows: repeat(7, 1fr); grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 2px; flex: 1; min-width: 0; }
  .activity-cell { aspect-ratio: 1; border-radius: 2px; background: color-mix(in srgb, var(--line) 40%, transparent); }
  .activity-cell.is-level-1 { background: color-mix(in srgb, var(--accent) 32%, transparent); }
  .activity-cell.is-level-2 { background: color-mix(in srgb, var(--accent) 62%, transparent); }
  .activity-cell.is-level-3 { background: var(--accent); }
  .activity-cell.is-today { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 55%, transparent); }

  .activity-stats { display: grid; gap: .45rem; margin: var(--s-4) 0 0; }
  .activity-stats > div { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
  .activity-stats dt { color: var(--ink-2); font-size: .74rem; }
  .activity-stats dd { margin: 0; font: 500 .92rem / 1.2 var(--font-display); }
  .activity-stats dd small { color: var(--ink-2); font-size: .68rem; font-weight: 400; }

  .activity-topics { margin: var(--s-4) 0 0; }
  .activity-topics-label { display: block; margin: 0 0 .45rem; color: var(--ink-2); font-size: .74rem; }
  .activity-chips { display: flex; flex-wrap: wrap; gap: .3rem; }
  .activity-chips span { display: inline-flex; align-items: baseline; gap: .35em; padding: .18rem .55rem; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-2); font-size: .72rem; }
  .activity-chips small { color: var(--ink-2); font-size: .62rem; opacity: .75; }
</style>
