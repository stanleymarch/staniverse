---
import type { AnyEntry } from "../lib/content";
import type { GraphEdge, GraphNode } from "../lib/graph";
import Base from "../layouts/Base.astro";
import LocalGraph from "./LocalGraph.astro";
import TableOfContents from "./TableOfContents.astro";
import { experimentStatus, hrefFor, kindLabel, projectStatus, workStatus } from "../lib/content";
import { buildRecommendations } from "../lib/recommendations";
import { topicRoute } from "../lib/topics";
import { getCollection, render } from "astro:content";
import { getTopicDefinition, normalizeTopics } from "../lib/taxonomy";
interface Props { entry: AnyEntry; nodes: GraphNode[]; edges: GraphEdge[]; chapters?: AnyEntry[] }
const { entry, nodes, edges, chapters=[] } = Astro.props;
const recommendations = buildRecommendations(entry.data.id, nodes, edges);
const { Content, headings } = await render(entry);
const status = entry.data.kind === "project" ? projectStatus[entry.data.status] : entry.data.kind === "work" ? workStatus[entry.data.status] : entry.data.kind === "experiment" ? experimentStatus[entry.data.status] : undefined;
const published = entry.data.date ?? entry.data.updated;
const publishedLabel = published ? new Intl.DateTimeFormat("ru-RU", { day: "numeric", month: "long", year: "numeric" }).format(published) : "";
const showPublished = Boolean(published && ["article", "telegram-post", "telegram-article", "experiment"].includes(entry.data.kind));
const stageVertical = entry.collection === "publications" && entry.data.format === "short";
const stageClass = ["video-stage", { "is-vertical": stageVertical }];
const embedUrl = entry.collection === "publications" ? entry.data.embedUrl : undefined;
const publicationMeta = entry.collection === "publications" && entry.data.platform ? {
  platform: entry.data.platform === "youtube" ? "YouTube" : entry.data.platform === "vk" ? "VK Видео" : "Telegram",
  ownership: entry.data.ownership === "verified" || entry.data.ownership === "own" ? "Проверенное авторское видео" : entry.data.ownership === "external" ? "Внешний материал" : "Авторство ожидает проверки",
  sourceUrl: entry.data.sourceUrl,
} : undefined;
const gallery = entry.collection === "publications" && entry.data.kind !== "telegram-article" ? entry.data.media.filter((item) => item.publicPath) : [];
const galleryImages = gallery.filter((item) => item.type === "image");
const galleryRemainder = galleryImages.length > 1 ? gallery.filter((item) => item.type !== "image") : gallery;
const channelVideos = entry.collection === "publications" && entry.data.channel?.key ? (await getCollection("publications"))
  .filter((video) => video.data.kind === "youtube-video" && video.data.channel?.key === entry.data.channel?.key && video.id !== entry.id && ["verified", "own"].includes(video.data.ownership ?? ""))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 8) : [];
const sourceTags = entry.collection === "publications" ? entry.data.sourceTags ?? [] : entry.data.sourceTags ?? entry.data.tags;
// A topic already implied by the author's own tag is not an "automatically found" hypothesis.
const sourceTagIds = new Set(normalizeTopics(sourceTags));
const sourceTagLinks = sourceTags.map((tag) => ({ tag, href: topicRoute(tag) ?? `/garden/?source=${encodeURIComponent(tag)}` }));
const inferredTopics = entry.data.topics
  .filter((topic) => !sourceTagIds.has(topic))
  .map((topic) => {
    const label = getTopicDefinition(topic)?.label ?? topic;
    return { label, href: topicRoute(topic) ?? `/garden/?q=${encodeURIComponent(label)}` };
  });
const plainCopy = (value: string) => value
  .replace(/<!--[\s\S]*?-->/g, " ")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/<[^>]+>/g, " ")
  .replace(/!\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  .replace(/[*_>#]/g, "")
  .replaceAll(String.fromCharCode(96), "")
  .replace(/\s+/g, " ")
  .trim();
const isTelegramPublication = entry.collection === "publications" && ["telegram-post", "telegram-article"].includes(entry.data.kind);
const summaryPrefix = plainCopy(entry.data.summary).replace(/…$/u, "").trim();
const entities = entry.collection === "publications" ? entry.data.entities ?? [] : [];
const entitySummary = entities.length > 1 ? `Упомянуто · ${entities[0]} и ещё ${entities.length - 1}` : entities.length === 1 ? `Упомянуто · ${entities[0]}` : "";
const showSummary = !isTelegramPublication || !summaryPrefix || !plainCopy(entry.body ?? "").startsWith(summaryPrefix);
const readingWords = plainCopy(entry.body ?? "").split(/\s+/u).filter(Boolean).length;
const readingImages = entry.collection === "publications" ? entry.data.media.filter((item) => item.type === "image").length : 0;
const readingMinutes = Math.max(1, Math.ceil(readingWords / 180 + Math.min(readingImages, 20) * 0.12));
const readingLabel = readingWords < 60 && readingImages > 0 ? `≈ ${readingMinutes} мин просмотра` : `≈ ${readingMinutes} мин чтения`;
const showReadingEstimate = ["article", "telegram-post", "telegram-article"].includes(entry.data.kind);
const connectionIds = new Set<string>();
for (const edge of edges) {
  const other = edge.source === entry.data.id ? edge.target : edge.target === entry.data.id ? edge.source : undefined;
  if (other && !other.startsWith("topic:")) connectionIds.add(other);
}
const connectionCount = connectionIds.size;
const connectionWord = connectionCount % 10 === 1 && connectionCount % 100 !== 11 ? "связь" : [2, 3, 4].includes(connectionCount % 10) && ![12, 13, 14].includes(connectionCount % 100) ? "связи" : "связей";
const schemaType = ["youtube-video", "video"].includes(entry.data.kind)
  ? "VideoObject"
  : ["article", "telegram-post", "telegram-article"].includes(entry.data.kind)
    ? "Article"
    : "CreativeWork";
/* Rich results need an image; a work or project falls back to its section card. */
const schemaImage = entry.collection === "publications" && entry.data.thumbnailUrl
  ? entry.data.thumbnailUrl
  : new URL(`/og/${entry.collection === "projects" ? "projects" : entry.collection === "works" ? "works" : entry.collection === "articles" ? "articles" : entry.collection === "experiments" ? "experiments" : "garden"}.png`, Astro.site).href;
const parentCrumb = entry.collection === "works"
  ? { name: "Работы", href: "/works/" }
  : entry.collection === "projects"
    ? { name: "Проекты", href: "/projects/" }
    : entry.collection === "experiments"
      ? { name: "Лаборатория", href: "/lab/" }
      : { name: "Сад", href: "/garden/" };
const entryJsonLd: Record<string, unknown> = {
  "@type": schemaType,
  "@id": new URL(`${hrefFor(entry)}#content`, Astro.site).href,
  url: new URL(hrefFor(entry), Astro.site).href,
  name: entry.data.title,
  headline: entry.data.title,
  description: entry.data.summary,
  image: schemaImage,
  inLanguage: "ru-RU",
  author: { "@id": new URL("/#stanislav-ermolenko", Astro.site).href },
  isPartOf: { "@id": new URL("/#website", Astro.site).href },
  ...(entry.data.date ? { datePublished: entry.data.date.toISOString() } : {}),
  ...(entry.data.updated ? { dateModified: entry.data.updated.toISOString() } : {}),
  ...(entry.collection === "publications" && entry.data.thumbnailUrl ? { thumbnailUrl: entry.data.thumbnailUrl } : {}),
  ...(entry.collection === "publications" && entry.data.embedUrl ? { embedUrl: entry.data.embedUrl } : {}),
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: parentCrumb.name, item: new URL(parentCrumb.href, Astro.site).href },
      { "@type": "ListItem", position: 2, name: entry.data.title, item: new URL(hrefFor(entry), Astro.site).href },
    ],
  },
};
---
<Base title={entry.data.title} description={entry.data.summary} ogImage={entry.collection === "publications" ? entry.data.thumbnailUrl : undefined} jsonLd={entryJsonLd} published={entry.data.date} modified={entry.data.updated ?? entry.data.date}>
  <article class="entry-shell">
    <div class="entry-columns">
    <div class="entry-main">
    <header class="entry-hero">
      <div class="entry-hero-meta"><span class="section-kicker">{entry.data.forwardFrom ? `Репост из «${entry.data.forwardFrom}»` : kindLabel[entry.data.kind]}{status && ` · ${status}`}</span>{showPublished && published && <time datetime={published.toISOString()}>{publishedLabel}</time>}</div>
      <nav class="entry-breadcrumbs" aria-label="Хлебные крошки"><a href="/">станивёрс</a> <span aria-hidden="true">/</span> <a href={parentCrumb.href}>{parentCrumb.name}</a> <span aria-hidden="true">/</span> <span aria-current="page">{entry.data.title}</span></nav>
      <h1 class:list={{ "is-long": entry.data.title.length > 64, "is-very-long": entry.data.title.length > 105 }}>{entry.data.title}</h1>
      {(showReadingEstimate || connectionCount > 0) && <div class="entry-reading-meta" aria-label="Параметры материала">
        {showReadingEstimate && <span>{readingLabel}</span>}
        {connectionCount > 0 && <button type="button" data-open-graph>↗ {connectionCount} {connectionWord}</button>}
      </div>}
      {showSummary && <p class="entry-summary">{entry.data.summary}</p>}
      {entities.length > 0 && <details class="auto-topics entity-list"><summary>{entitySummary}</summary><div class="tag-row">{entities.map((entity) => <span>{entity}</span>)}</div></details>}
      {publicationMeta && <div class="publication-facts"><span>{publicationMeta.platform}</span><span>{publicationMeta.ownership}</span><a href={publicationMeta.sourceUrl}>Открыть оригинал ↗</a></div>}
      {entry.data.kind === "work" && <dl class="work-facts">
        {String(entry.data.year).trim().length > 0 && <div><dt>Год</dt><dd>{entry.data.year}</dd></div>}
        <div><dt>Роль</dt><dd>{entry.data.role}</dd></div>
        {entry.data.client && <div><dt>Для кого</dt><dd>{entry.data.client}</dd></div>}
        {entry.data.features.length > 0 && <div class="work-features"><dt>Что сделано лично</dt><dd>{entry.data.features.map((feature)=><span>{feature}</span>)}</dd></div>}
      </dl>}
    </header>
    {embedUrl && entry.collection === "publications" && entry.data.kind === "youtube-video" && entry.data.thumbnailUrl && (
      <div class:list={stageClass} data-video-stage data-embed={embedUrl} data-title={entry.data.title}>
        <button type="button" class="video-poster" data-video-play aria-label={`Смотреть: ${entry.data.title}`}>
          <img src={entry.data.thumbnailUrl} alt="" loading="eager" decoding="async" />
          <span class="video-poster-play" aria-hidden="true">▶</span>
        </button>
      </div>
    )}
    {embedUrl && !(entry.collection === "publications" && entry.data.kind === "youtube-video" && entry.data.thumbnailUrl) && <div class:list={stageClass}><iframe src={embedUrl} title={entry.data.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>}
    {channelVideos.length > 0 && <section class="channel-gallery" aria-labelledby="channel-gallery-title"><h2 id="channel-gallery-title">Ещё видео канала</h2><div class="channel-gallery-grid">{channelVideos.map((video) => <a href={hrefFor(video)}><img src={video.data.thumbnailUrl} alt="" loading="lazy" decoding="async" width="320" height="180" /><strong>{video.data.title}</strong></a>)}</div></section>}
    {galleryImages.length > 1 && (
      <section class="media-carousel" data-media-carousel aria-label={`Фотографии публикации · ${galleryImages.length}`}>
        <div class="media-carousel-stage">
          <button type="button" class="media-carousel-arrow is-prev" data-carousel-prev aria-label="Предыдущее фото">←</button>
          <div class="media-carousel-viewport" data-carousel-viewport>
            <div class="media-carousel-track">
              {galleryImages.map((item,index)=><figure class="media-carousel-slide" data-carousel-slide><a href={item.publicPath}><img src={item.publicPath} alt={`${entry.data.title} · изображение ${index+1}`} loading={index>0?"lazy":"eager"} decoding="async" /></a><figcaption>{index+1} / {galleryImages.length}</figcaption></figure>)}
            </div>
          </div>
          <button type="button" class="media-carousel-arrow is-next" data-carousel-next aria-label="Следующее фото">→</button>
        </div>
        <div class="media-carousel-controls">
          <div class="media-carousel-dots" aria-label="Выбрать фото">{galleryImages.map((_,index)=><button type="button" data-carousel-dot={index} aria-label={`Фото ${index+1}`} aria-current={index===0?"true":"false"}></button>)}</div>
          <output data-carousel-status aria-live="polite">1 / {galleryImages.length}</output>
        </div>
      </section>
    )}
    {galleryRemainder.length > 0 && <div class="media-gallery" aria-label="Медиа публикации">{galleryRemainder.map((item,index)=>item.type==="image"?<a href={item.publicPath}><img src={item.publicPath} alt={`${entry.data.title} · изображение ${index+1}`} loading={index>0?"lazy":"eager"} decoding="async" /></a>:item.type==="video"?<video controls playsinline preload="metadata" width="320" height="180" src={item.publicPath}>Видео из публикации</video>:item.type==="audio"?<audio controls preload="metadata" src={item.publicPath}>Аудио из публикации</audio>:<a class="media-document" href={item.publicPath}>Открыть документ ↗</a>)}</div>}
    {entry.collection === "projects" && entry.data.gallery.length > 0 && (
      <section class="media-carousel" data-media-carousel aria-label={`Концепты проекта · ${entry.data.gallery.length}`}>
        <div class="media-carousel-viewport" data-carousel-viewport>
          <div class="media-carousel-track">
            {entry.data.gallery.map((slide, index) => <figure class="media-carousel-slide" data-carousel-slide><a href={slide.src}><img src={slide.src} alt={slide.caption} loading={index > 0 ? "lazy" : "eager"} decoding="async" /></a><figcaption>{slide.caption}</figcaption></figure>)}
          </div>
        </div>
      </section>
    )}
    {entry.collection === "projects" && entry.data.gallery.length > 0 && <p class="media-carousel-note">Все изображения — концепты будущего внедрения, а не фотографии работающих инсталляций.</p>}
    <div class="prose"><Content />
        {chapters.length>0&&<section class="project-chapters" aria-labelledby="project-chapters-title"><h2 id="project-chapters-title">Главы и результаты проекта</h2><p>Материалы собраны здесь в контексте собственной инициативы, а не среди заказных работ.</p><div>{chapters.map((chapter)=><a href={hrefFor(chapter)}><small>{chapter.data.kind==="work"?chapter.data.year:""}</small><strong>{chapter.data.title}</strong><span>{chapter.data.summary}</span></a>)}</div></section>}
        {(sourceTagLinks.length > 0 || inferredTopics.length > 0) && <footer class="entry-taxonomy" aria-label="Темы и теги материала">
          <h2>Темы и теги</h2>
          {sourceTagLinks.length > 0 && <div class="tag-group"><span class="tag-origin">Теги автора</span><div class="tag-row">{sourceTagLinks.map(({ tag, href }) => <a href={href}>#{tag}</a>)}</div></div>}
          {inferredTopics.length > 0 && <div class="tag-group"><span class="tag-origin">Ещё по теме · найдено автоматически</span><div class="tag-row is-inferred">{inferredTopics.map(({ label, href }) => <a href={href}>{label}</a>)}</div></div>}
        </footer>}
        {recommendations.length > 0 && (
          <section class="read-next" aria-labelledby="read-next-title">
            <h2 id="read-next-title">Читать дальше</h2>
            <ol class="read-next-list">
              {recommendations.map((item) => (
                <li>
                  <a href={item.href}>
                    <span class="read-next-kind">{kindLabel[item.kind] ?? "Материал"}</span>
                    <strong>{item.title}</strong>
                    <span class="read-next-reason">{item.reason}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
    </div>
    </div>

    <aside class="entry-aside">
      <TableOfContents headings={headings} />
      <details class="graph-fold" open>
        <summary class="graph-fold__title">Связи рядом</summary>
        <LocalGraph currentId={entry.data.id} nodes={nodes} edges={edges} />
      </details>
    </aside>
    </div>
<script>
  import { installLightbox } from "../lib/lightbox";

  document.querySelectorAll<HTMLElement>("[data-video-stage]").forEach((stage) => {
    const play = stage.querySelector<HTMLButtonElement>("[data-video-play]");
    if (!play) return;
    play.addEventListener("click", () => {
      const url = new URL(stage.dataset.embed ?? "", location.origin);
      url.searchParams.set("autoplay", "1");
      const iframe = document.createElement("iframe");
      iframe.src = url.toString();
      iframe.title = stage.dataset.title ?? "Видео";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      stage.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });

  /* Telegram-article bodies embed carousels as bare viewport markup without
     controls; give every carousel the same side arrows, dots and counter. */
  document.querySelectorAll<HTMLElement>("[data-media-carousel]").forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>("[data-carousel-viewport]");
    const slides = [...carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]")];
    if (!viewport || slides.length < 2) return;
    if (!carousel.querySelector(".media-carousel-stage")) {
      const stage = document.createElement("div");
      stage.className = "media-carousel-stage";
      const makeArrow = (direction: "prev" | "next") => {
        const arrow = document.createElement("button");
        arrow.type = "button";
        arrow.className = `media-carousel-arrow is-${direction}`;
        if (direction === "prev") arrow.dataset.carouselPrev = "";
        else arrow.dataset.carouselNext = "";
        arrow.setAttribute("aria-label", direction === "prev" ? "Предыдущее фото" : "Следующее фото");
        arrow.textContent = direction === "prev" ? "←" : "→";
        return arrow;
      };
      viewport.before(stage);
      stage.append(makeArrow("prev"), viewport, makeArrow("next"));
    }
    if (!carousel.querySelector(".media-carousel-controls")) {
      const controls = document.createElement("div");
      controls.className = "media-carousel-controls";
      const dots = document.createElement("div");
      dots.className = "media-carousel-dots";
      dots.setAttribute("aria-label", "Выбрать фото");
      slides.forEach((_, index) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.dataset.carouselDot = String(index);
        dot.setAttribute("aria-label", `Фото ${index + 1}`);
        dot.setAttribute("aria-current", String(index === 0));
        dots.append(dot);
      });
      const status = document.createElement("output");
      status.dataset.carouselStatus = "";
      status.setAttribute("aria-live", "polite");
      status.textContent = `1 / ${slides.length}`;
      controls.append(dots, status);
      carousel.append(controls);
    }
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")];
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const status = carousel.querySelector<HTMLOutputElement>("[data-carousel-status]");
    if (!previous || !next || !status) return;
    let current = 0;
    let frame = 0;
    const update = (index: number) => {
      current = Math.max(0, Math.min(slides.length - 1, index));
      dots.forEach((dot, dotIndex) => dot.setAttribute("aria-current", String(dotIndex === current)));
      status.value = `${current + 1} / ${slides.length}`;
      previous.disabled = current === 0;
      next.disabled = current === slides.length - 1;
    };
    const go = (index: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, index));
      viewport.scrollTo({ left: slides[target].offsetLeft, behavior: "smooth" });
      update(target);
    };
    previous.addEventListener("click", () => go(current - 1));
    next.addEventListener("click", () => go(current + 1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => go(index)));
    viewport.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const nearest = slides.reduce((best, slide, index) => Math.abs(slide.offsetLeft - viewport.scrollLeft) < Math.abs(slides[best].offsetLeft - viewport.scrollLeft) ? index : best, 0);
        update(nearest);
      });
    }, { passive: true });
    update(0);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-open-graph]").forEach((button) => {
    const graph = document.querySelector<HTMLDetailsElement>(".graph-fold");
    if (!graph) {
      button.hidden = true;
      return;
    }
    button.addEventListener("click", () => {
      graph.open = true;
      const title = graph.querySelector<HTMLElement>(".graph-fold__title");
      if (!title) return;
      /* Focus without scrolling first, then let the rail (or the page on
         narrow screens) bring the heading into view in one smooth move. */
      title.focus({ preventScroll: true });
      requestAnimationFrame(() => {
        title.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "nearest" });
      });
    });
  });

  installLightbox();
</script>

<style>
  /* The stage box owns its aspect ratio; the poster fills it (cover trims the
     baked-in pillarbox bars YouTube adds to Shorts thumbnails). */
  .video-poster { position: absolute; inset: 0; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: #05070d; cursor: pointer; }
  .video-poster img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: .92; }
  .video-poster:hover img, .video-poster:focus-visible img { opacity: 1; }
  .video-poster-play { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 4.2rem; height: 4.2rem; border: 2px solid rgba(255, 255, 255, .85); border-radius: 50%; background: rgba(5, 7, 13, .55); color: #fff; font-size: 1.3rem; transform: translate(-50%, -50%); transition: transform .2s ease, background .2s ease; }
  .video-poster:hover .video-poster-play, .video-poster:focus-visible .video-poster-play { transform: translate(-50%, -50%) scale(1.08); background: rgba(100, 223, 244, .35); }
  .channel-gallery { max-width: 980px; margin: var(--s-6) 0 0; }
  .channel-gallery h2 { margin: 0 0 var(--s-4); font: 500 1.2rem Unbounded; }
  .channel-gallery-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-3); }
  .channel-gallery-grid a { min-width: 0; color: inherit; }
  .channel-gallery-grid img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--line); }
  .entry-reading-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin: -.1rem 0 var(--s-3); color: var(--ink-2); font-size: .78rem; }
  .entry-reading-meta button { padding: 0; border: 0; background: transparent; color: var(--accent); font: inherit; cursor: pointer; }
  .entry-reading-meta button:hover, .entry-reading-meta button:focus-visible { text-decoration: underline; text-underline-offset: .22em; }

  .channel-gallery-grid strong { display: block; margin-top: var(--s-2); font-size: .82rem; font-weight: 500; line-height: 1.35; overflow-wrap: anywhere; }
  .channel-gallery-grid a:hover img, .channel-gallery-grid a:focus-visible img { border-color: var(--accent); }
  /* The rail is raised to the title's height: the two-column grid starts at the
     hero, so contents and neighbourhood are beside the heading from the first
     screen — not somewhere below where the text begins. Sticky keeps them in
     reach; the rail owns its scroll and never grows past the fold. */
  .entry-columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); gap: var(--flow-section); align-items: start; min-width: 0; }
  .entry-main { min-width: 0; }
