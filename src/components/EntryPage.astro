---
import type { AnyEntry } from "../lib/content";
import type { GraphEdge, GraphNode } from "../lib/graph";
import Base from "../layouts/Base.astro";
import LocalGraph from "./LocalGraph.astro";
import { kindLabel, projectStatus } from "../lib/content";
import { render } from "astro:content";
interface Props { entry: AnyEntry; nodes: GraphNode[]; edges: GraphEdge[] }
const { entry, nodes, edges } = Astro.props;
const { Content } = await render(entry);
const status = entry.data.kind === "project" ? projectStatus[entry.data.status] : undefined;
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="entry-shell">
    <header class="entry-hero">
      <div class="section-kicker">{kindLabel[entry.data.kind]}{status && ` · ${status}`}</div>
      <h1>{entry.data.title}</h1>
      <p class="entry-summary">{entry.data.summary}</p>
      <div class="tag-row">{entry.data.tags.map((tag) => <a href={`/garden/?tag=${tag}`}>#{tag}</a>)}</div>
    </header>
    <div class="entry-grid">
      <div class="prose"><Content /></div>
      <LocalGraph currentId={entry.data.id} nodes={nodes} edges={edges} />
    </div>
  </article>
</Base>
