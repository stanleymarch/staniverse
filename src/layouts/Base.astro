---
import "../styles/global.css";
import "../styles/details.css";

interface Props { title: string; description?: string; immersive?: boolean }
const { title, description = "Staniverse — работы, собственные проекты, публикации и карта опыта Станислава Ермоленко.", immersive = false } = Astro.props;
const pageTitle = title === "Staniverse" ? title : `${title} · Staniverse`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ru" class:list={{ immersive }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a12" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Staniverse" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">К содержанию</a>
    {!immersive && (
      <header class="site-header">
        <a class="brand" href="/" aria-label="Staniverse, на главную"><span class="brand-mark">s</span><span>staniverse</span></a>
        <nav id="primary-navigation" aria-label="Основная навигация">
          <a href="/works/">Работы</a>
          <a href="/projects/">Проекты</a>
          <a href="/garden/">Сад</a>
          <a href="/topics/">Темы</a>
          <a href="/about/">Обо мне</a>
        </nav>
        <a class="universe-link" href="/universe/">Вселенная <span aria-hidden="true">↗</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="menu-toggle-label">Меню</span>
          <span class="menu-toggle-icon" aria-hidden="true"></span>
        </button>
      </header>
    )}
    <main id="content"><slot /></main>
    {!immersive && (
      <footer class="site-footer">
        <div><strong>Staniverse</strong><p>Связи между технологиями, памятью, медиа и местом.</p></div>
        <div class="footer-links"><a href="/about/#manifesto">Манифест</a><a href="mailto:stas@staniverse.xyz">Почта</a><a href="https://t.me/staniverse">Telegram</a><a href="https://vk.com/staniverse">VK</a><a href="https://www.youtube.com/@staniverse">YouTube</a><a href="https://vk.com/yatygorod">VK я.ты.город.</a><a href="https://www.youtube.com/@yatygorod">YouTube я.ты.город.</a></div>
      </footer>
    )}
  </body>
</html>

<script>
  document.querySelectorAll<HTMLElement>(".site-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle");
    const nav = header.querySelector<HTMLElement>("#primary-navigation");
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      header.toggleAttribute("data-menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    nav.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        toggle.focus();
      }
    });
  });
</script>
