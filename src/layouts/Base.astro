---
import "../styles/global.css";
import "../styles/details.css";
import { analyticsEnabled, metrikaCounterId, webmasterVerification } from "../lib/analytics";
import { alternatesFor } from "../lib/i18n";
import { ogImageFor } from "../lib/og";

interface Props {
  title: string;
  description?: string;
  immersive?: boolean;
  /** Extends the viewport meta; `/card/` needs `cover` for env(safe-area-inset-*)`. */
  viewportFit?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  /** Adds the typed page node search engines look for on these two routes. */
  pageType?: "AboutPage" | "ContactPage";
  /** Page language; switches html lang, og:locale and the shared chrome. RU is the default. */
  lang?: "ru" | "en";
  /** Publish/update times for article-like pages (og:type=article). */
  published?: Date;
  modified?: Date;
  /** Trail below the site root for the BreadcrumbList node. Omitted: derived from
      the URL. Roots and pages outside the section vocabulary get no node. */
  breadcrumbs?: { name: string; href: string }[];
}
// One description for the whole site: XR, AI-автоматизация, архивы и медиа для
// бизнеса, музеев и культурных проектов — no audience is the afterthought here.
const siteDescription = "станивёрс — портфолио Станислава Ермоленко: XR и WebXR, AI-автоматизация рабочих процессов, цифровые архивы, сайты и медиа — для бизнеса, музеев и культурных проектов.";
const {
  title,
  description = siteDescription,
  immersive = false,
  viewportFit,
  ogImage,
  jsonLd,
  pageType,
  lang = "ru",
  published,
  modified,
  breadcrumbs,
} = Astro.props;
/* Shared chrome (nav, search, footer, consent) stays bilingual in one place so an
   EN page is a full citizen of the site, not a translated island. */
const chrome = lang === "en" ? {
  skipLink: "Skip to content",
  nav: [
    ["/en/works/", "Works"],
    ["/en/projects/", "Projects"],
    ["/en/lab/", "Lab"],
    ["/garden/", "Garden"],
    ["/en/about/", "About"],
    ["/en/contacts/", "Contacts"],
  ] as const,
  search: "Search",
  searchLabel: "Site search (Ctrl+K)",
  map: "XR map",
  menu: "Menu",
  tagline: "Connections between technology, memory, media and place.",
  footerLinks: [
    ["/en/works/", "Works"],
    ["/en/projects/", "Projects"],
    ["/en/lab/", "Lab"],
    ["/videos/", "Video"],
    ["/en/contacts/", "Contacts"],
    ["/manifesto/", "Manifesto"],
    ["/donate/", "Support"],
    ["/privacy/", "Privacy"],
    ["/licenses/", "Licenses"],
  ] as const,
  consentText: "Yandex Metrika shows which materials are useful. It loads only with your consent. See the",
  consentMore: "privacy policy",
  consentAccept: "Allow",
  consentDecline: "Decline",
} : {
  skipLink: "К содержанию",
  nav: [
    ["/works/", "Работы"],
    ["/projects/", "Проекты"],
    ["/lab/", "Лаба"],
    ["/garden/", "Сад"],
    ["/about/", "Обо мне"],
    ["/contacts/", "Контакты"],
  ] as const,
  search: "Поиск",
  searchLabel: "Поиск по сайту (Ctrl+K)",
  map: "XR-карта",
  menu: "Меню",
  tagline: "Связи между технологиями, памятью, медиа и местом.",
  footerLinks: [
    ["/works/", "Работы"],
    ["/projects/", "Проекты"],
    ["/lab/", "Лаба"],
    ["/videos/", "Видео"],
    ["/contacts/", "Контакты"],
    ["/manifesto/", "Манифест"],
    ["/donate/", "Поддержать"],
    ["/privacy/", "Конфиденциальность"],
    ["/licenses/", "Технологии и лицензии"],
  ] as const,
  consentText: "Яндекс Метрика помогает понять, какие материалы полезны. Она загрузится только с вашего согласия. Подробнее — в",
  consentMore: "политике конфиденциальности",
  consentAccept: "Разрешить",
  consentDecline: "Не разрешать",
};
const localeTag = lang === "en" ? "en_US" : "ru_RU";
const alternateLocale = lang === "en" ? "ru_RU" : "en_US";
const inLanguage = lang === "en" ? "en" : "ru-RU";
const alternateLinks = alternatesFor(Astro.url.pathname).map((alternate) => ({
  ...alternate,
  href: new URL(alternate.href, Astro.site).href,
}));
/* Header language switch: shown only where a translated twin really exists,
   exactly the pairs hreflang already advertises. */
const languageSwitch = (() => {
  const pair = alternatesFor(Astro.url.pathname).find((alternate) => alternate.lang !== lang);
  return pair ? { lang: pair.lang as "ru" | "en", href: pair.href } : undefined;
})();
/* The site brand is «станивёрс» — lowercase Cyrillic, the way the author writes it.
   Latin "Staniverse" stays a machine-readable alias: domain, handles, schema.org
   alternateName. Page titles, share cards and the wordmark follow the Cyrillic. */
const siteName = "станивёрс";

const brandOnly = title.toLocaleLowerCase("ru-RU") === siteName;
const pageTitle = brandOnly ? siteName : `${title} · ${siteName}`;
// The share card is already branded, so a brand-only title must not repeat itself in the alt text.
const imageAlt = brandOnly ? siteName : `${siteName} — ${title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const personId = new URL("/#stanislav-ermolenko", Astro.site).href;
const websiteId = new URL("/#website", Astro.site).href;
const baseGraph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: new URL("/", Astro.site).href,
    alternateName: "Staniverse",
    description: siteDescription,
    inLanguage,
    creator: { "@id": personId },
    publisher: { "@id": personId },
  },
  {
    "@type": "Person",
    "@id": personId,
    name: "Станислав Ермоленко",
    alternateName: "Стас Ермоленко",
    url: new URL("/", Astro.site).href,
    jobTitle: "XR-разработчик и специалист по AI-автоматизации",
    description: "Делаю XR и WebXR, встраиваю AI в рабочие процессы, собираю цифровые архивы и медиа, интерфейсы и исследования. Работаю и с бизнесом, и с музеями, культурой и искусством.",
    email: "mailto:stas@staniverse.xyz",
    homeLocation: { "@type": "Place", name: "Санкт-Петербург, Россия" },
    alumniOf: { "@type": "CollegeOrUniversity", name: "Вятский государственный университет" },
    affiliation: { "@type": "CollegeOrUniversity", name: "ИТМО" },
    knowsAbout: [
      "XR и WebXR",
      "виртуальные пространства",
      "3D и Gaussian Splatting",
      "AI-автоматизация бизнес-процессов",
      "AI-агенты",
      "интеграция CRM",
      "n8n",
      "цифровые архивы",
      "медиа и видеопроизводство",
      "контентные системы",
      "музеи и культурное наследие",
      "городские исследования",
      "арт и сценография",
      "веб-разработка",
      "продуктовый менеджмент",
      "образовательные программы и ДПО",
      "прикладные исследования",
    ],
    sameAs: ["https://github.com/stanleymarch", "https://t.me/staniverse", "https://vk.com/staniverse", "https://www.youtube.com/@staniverse"],
  },
  ...(pageType
    ? [{
        "@type": pageType,
        "@id": `${canonical.href}#page`,
        url: canonical.href,
        name: pageTitle,
        description,
        inLanguage,
        isPartOf: { "@id": websiteId },
        about: { "@id": personId },
        mainEntity: { "@id": personId },
      }]
    : []),
];
const segments = Astro.url.pathname.split("/").filter(Boolean);
/* EN twins live under /en/<section>/… — they are article-like exactly like their RU originals. */
const sectionSegment = segments[0] === "en" ? segments[1] ?? "" : segments[0] ?? "";
const image = new URL(ogImage ?? ogImageFor(sectionSegment), Astro.site);
/* YouTube thumbnails are 480×360; every own OG card is 1200×630. Lying dimensions
   make scrapers crop the card, so the pair follows the actual image source. */
const [imageWidth, imageHeight] = ogImage && !ogImage.startsWith("/") ? [480, 360] : [1200, 630];
const articleLike = ["works", "projects", "garden", "articles", "topics"].includes(sectionSegment) && segments.length > (segments[0] === "en" ? 2 : 1);
/* Search engines read the hierarchy from a BreadcrumbList node, and Yandex's
   «Навигационная цепочка» report wants it as an object of its own — a breadcrumb
   nested inside the page's CreativeWork is Google's shape, not Yandex's. One
   derivation serves every route: root, then section, then the page itself, with
   the section label taken from the vocabulary the header navigation already uses. */
const sectionCrumbs: Record<string, Record<"ru" | "en", { name: string; href: string }>> = {
  works: { ru: { name: "Работы", href: "/works/" }, en: { name: "Works", href: "/en/works/" } },
  projects: { ru: { name: "Проекты", href: "/projects/" }, en: { name: "Projects", href: "/en/projects/" } },
  garden: { ru: { name: "Сад", href: "/garden/" }, en: { name: "Garden", href: "/garden/" } },
  articles: { ru: { name: "Статьи", href: "/articles/" }, en: { name: "Articles", href: "/en/articles/" } },
  videos: { ru: { name: "Видео", href: "/videos/" }, en: { name: "Videos", href: "/videos/" } },
  topics: { ru: { name: "Темы", href: "/topics/" }, en: { name: "Topics", href: "/topics/" } },
  lab: { ru: { name: "Лаборатория", href: "/lab/" }, en: { name: "Lab", href: "/en/lab/" } },
  experiments: { ru: { name: "Лаборатория", href: "/lab/" }, en: { name: "Lab", href: "/en/lab/" } },
  about: { ru: { name: "Обо мне", href: "/about/" }, en: { name: "About", href: "/en/about/" } },
  contacts: { ru: { name: "Контакты", href: "/contacts/" }, en: { name: "Contacts", href: "/en/contacts/" } },
  manifesto: { ru: { name: "Манифест", href: "/manifesto/" }, en: { name: "Manifesto", href: "/manifesto/" } },
  donate: { ru: { name: "Поддержать", href: "/donate/" }, en: { name: "Support", href: "/donate/" } },
  privacy: { ru: { name: "Конфиденциальность", href: "/privacy/" }, en: { name: "Privacy", href: "/privacy/" } },
  licenses: { ru: { name: "Лицензии", href: "/licenses/" }, en: { name: "Licenses", href: "/licenses/" } },
  universe: { ru: { name: "Вселенная", href: "/universe/" }, en: { name: "Universe", href: "/universe/" } },
};
const isSiteRoot = canonical.pathname === "/" || canonical.pathname === "/en/";
/* /en/<section>/ is as shallow as /<section>/: both end on their own section. */
const sectionDepth = segments[0] === "en" ? 2 : 1;
const sectionCrumb = sectionCrumbs[sectionSegment]?.[lang];
const derivedTrail = isSiteRoot
  ? []
  : segments.length <= sectionDepth
    ? sectionCrumb ? [sectionCrumb] : []
    : [...(sectionCrumb ? [sectionCrumb] : []), { name: title, href: canonical.href }];
const trail = breadcrumbs ?? derivedTrail;
const breadcrumbNode = trail.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonical.href}#breadcrumb`,
      /* The root is prepended here rather than in the trail, so no caller can
         publish a chain that starts halfway up the tree. */
      itemListElement: [{ name: lang === "en" ? "Home" : "станивёрс", href: lang === "en" ? "/en/" : "/" }, ...trail]
        .map((crumb, index) => ({ "@type": "ListItem", position: index + 1, name: crumb.name, item: new URL(crumb.href, Astro.site).href })),
    }
  : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...baseGraph,
    /* Rich results require an image on article-like nodes; a page that brought its
       own node gets the same card og:image advertises unless it sets its own. */
    ...(jsonLd ? [jsonLd.image ? jsonLd : { ...jsonLd, image: image.href }] : []),
    ...(breadcrumbNode ? [breadcrumbNode] : []),
  ],
};
---
<!doctype html>
<html lang={lang} class:list={{ immersive }}>
  <head>
    <meta name="viewport" content={`width=device-width, initial-scale=1${viewportFit ? `, viewport-fit=${viewportFit}` : ""}`} />
    <meta name="author" content="Станислав Ермоленко" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06080f" />
    <!-- The canvas is dark before any stylesheet arrives: without this, every
         cross-document navigation paints a white flash between the two pages. -->
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Cyrillic carries the page copy, latin carries the brand and every
         latin term inside that copy: both subsets sit on the first screen. -->
    <link rel="preload" href="/fonts/geologica-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geologica-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("reveal-on");</script>
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    {alternateLinks.length > 0 && <link rel="alternate" hreflang="x-default" href={alternateLinks[0].href} />}
    <link rel="alternate" type="application/rss+xml" title="станивёрс" href={new URL("/rss.xml", Astro.site).href} />
    <meta property="og:type" content={articleLike ? "article" : "website"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={localeTag} />
    {alternateLinks.some((alternate) => alternate.lang === "en") && <meta property="og:locale:alternate" content={alternateLocale} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {articleLike && published && <meta property="article:published_time" content={published.toISOString()} />}
    {articleLike && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {webmasterVerification && <meta name="yandex-verification" content={webmasterVerification} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{chrome.skipLink}</a>
    {!immersive && (
      <header class:list={["site-header", languageSwitch && "has-language-switch"]}>
        <a class="brand" href={lang === "en" ? "/en/" : "/"} aria-label="станивёрс"><span class="brand-mark">s</span><span>станивёрс</span></a>
        <nav id="primary-navigation" aria-label={chrome.menu}>
          {chrome.nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        {languageSwitch && (
          <a class="lang-switch" href={languageSwitch.href} hreflang={languageSwitch.lang} lang={languageSwitch.lang} aria-label={lang === "en" ? "Русская версия" : "English version"}>{languageSwitch.lang === "en" ? "EN" : "RU"}</a>
        )}
        <button class="site-search-open" type="button" data-search-open aria-haspopup="dialog" aria-label={chrome.searchLabel}>{chrome.search}</button>
        <a class="universe-link" href="/universe/" aria-label={chrome.map}><span class="universe-link-text">{chrome.map}</span> <span aria-hidden="true">↗</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="menu-toggle-label">{chrome.menu}</span>
          <span class="menu-toggle-icon" aria-hidden="true"></span>
        </button>
      </header>
    )}
    <main id="content"><slot /></main>
    {analyticsEnabled && (
      <aside class="consent-banner" data-consent-banner data-counter={metrikaCounterId} role="region" aria-label={lang === "en" ? "Statistics settings" : "Настройки статистики"} hidden>
        <p>{chrome.consentText} <a href="/privacy/">{chrome.consentMore}</a>.</p>
        <div class="consent-banner-actions">
          <button type="button" class="button primary" data-consent-accept>{chrome.consentAccept}</button>
          <button type="button" class="button" data-consent-decline>{chrome.consentDecline}</button>
        </div>
      </aside>
    )}
    {!immersive && (
      <footer class="site-footer">
        <div><strong>станивёрс</strong><p>{chrome.tagline}</p></div>
        <div class="footer-links">
          {chrome.footerLinks.map(([href, label]) => <a href={href}>{label}</a>)}
          <a href="mailto:stas@staniverse.xyz">{lang === "en" ? "Email" : "Почта"}</a>
          <a href="https://github.com/stanleymarch" target="_blank" rel="noreferrer">GitHub</a>
          <span class="footer-social-group" aria-label={lang === "en" ? "Staniverse social media" : "Соцсети станивёрса"}>
            <small>станивёрс</small>
            <a class="footer-social-link" href="https://t.me/staniverse" target="_blank" rel="noreferrer" aria-label={lang === "en" ? "Staniverse on Telegram" : "станивёрс в Telegram"} title={lang === "en" ? "Staniverse on Telegram" : "станивёрс в Telegram"}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m21 3-3.2 16.1c-.2 1.1-1 1.4-1.9.9l-5.2-3.8-2.5 2.4c-.3.3-.5.5-1 .5l.4-5.3 9.7-8.7c.4-.4-.1-.6-.7-.2L4.8 12.3.1 10.8c-1-.3-1-1 .2-1.5L19.1 2c.9-.3 2.1.2 1.9 1z"></path></svg>
            </a>
            <a class="footer-social-link" href="https://vk.com/staniverse" target="_blank" rel="noreferrer" aria-label={lang === "en" ? "Staniverse on VK" : "станивёрс во ВКонтакте"} title={lang === "en" ? "Staniverse on VK" : "станивёрс во ВКонтакте"}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="3" width="20" height="18" rx="5"></rect><path d="M6.3 8.1c.7 4.2 2.7 7.6 6.5 7.6h.8v-2.4c1.3.2 2.1 1.2 2.8 2.4h2.2c-.8-1.6-1.8-2.8-3-3.4 1.2-.8 2.1-2.2 2.8-4.2h-2.2c-.6 1.8-1.5 3.1-2.6 3.7V8.1h-2v5.3c-1.6-.6-2.7-2.6-3.2-5.3z"></path></svg>
            </a>
            <a class="footer-social-link" href="https://www.youtube.com/@staniverse" target="_blank" rel="noreferrer" aria-label={lang === "en" ? "Staniverse on YouTube" : "станивёрс на YouTube"} title={lang === "en" ? "Staniverse on YouTube" : "станивёрс на YouTube"}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="5.5" width="19" height="13" rx="4.5"></rect><path d="m10 9 5 3-5 3z"></path></svg>
            </a>
          </span>
          <span class="footer-social-group" aria-label={lang === "en" ? "I. You. City social media" : "Соцсети «я.ты.город.»"}>
            <small>я.ты.город.</small>
            <a class="footer-social-link" href="https://vk.com/yatygorod" target="_blank" rel="noreferrer" aria-label={lang === "en" ? "I. You. City on VK" : "«я.ты.город.» во ВКонтакте"} title={lang === "en" ? "I. You. City on VK" : "«я.ты.город.» во ВКонтакте"}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="3" width="20" height="18" rx="5"></rect><path d="M6.3 8.1c.7 4.2 2.7 7.6 6.5 7.6h.8v-2.4c1.3.2 2.1 1.2 2.8 2.4h2.2c-.8-1.6-1.8-2.8-3-3.4 1.2-.8 2.1-2.2 2.8-4.2h-2.2c-.6 1.8-1.5 3.1-2.6 3.7V8.1h-2v5.3c-1.6-.6-2.7-2.6-3.2-5.3z"></path></svg>
            </a>
            <a class="footer-social-link" href="https://www.youtube.com/@yatygorod" target="_blank" rel="noreferrer" aria-label={lang === "en" ? "I. You. City on YouTube" : "«я.ты.город.» на YouTube"} title={lang === "en" ? "I. You. City on YouTube" : "«я.ты.город.» на YouTube"}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="5.5" width="19" height="13" rx="4.5"></rect><path d="m10 9 5 3-5 3z"></path></svg>
            </a>
          </span>
        </div>
      </footer>
    )}
    {!immersive && (
      <div class="site-search" data-search-panel role="dialog" aria-modal="true" aria-label="Поиск по сайту" hidden>
        <div class="site-search-box">
          <div class="site-search-head">
            <input data-search-input type="search" placeholder="Тема, проект, технология, место…" autocomplete="off" aria-label="Поисковый запрос" />
            <button type="button" data-search-close aria-label="Закрыть поиск">×</button>
          </div>
          <p class="site-search-status" data-search-status>Введите запрос: тема, проект, технология, место…</p>
          <ul class="site-search-results" data-search-results></ul>
        </div>
      </div>
    )}
    <script is:inline type="module" src="/scripts/site-search.js"></script>
    <script is:inline type="module" src="/scripts/consent.js"></script>
  </body>
</html>

<script>
  document.querySelectorAll<HTMLElement>(".site-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle");
    const nav = header.querySelector<HTMLElement>("#primary-navigation");
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      header.toggleAttribute("data-menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    nav.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        toggle.focus();
      }
    });
  });
  // Glass spotlight: each card exposes its pointer position as --mx/--my,
  // so the ::before pool follows the cursor. Fine pointers only, calm respected.
  if (matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let spotFrame = 0;
    let spotCard: HTMLElement | null = null;
    let spotX = 0;
    let spotY = 0;
    const paintSpot = () => {
      spotFrame = 0;
      spotCard?.style.setProperty("--mx", `${spotX.toFixed(1)}px`);
      spotCard?.style.setProperty("--my", `${spotY.toFixed(1)}px`);
    };
    addEventListener("pointermove", (event) => {
      const card = (event.target as Element | null)?.closest<HTMLElement>(".content-card, .direction-tile");
      if (!card) return;
      const rect = card.getBoundingClientRect();
      spotCard = card;
      spotX = event.clientX - rect.left;
      spotY = event.clientY - rect.top;
      if (!spotFrame) spotFrame = requestAnimationFrame(paintSpot);
    }, { passive: true });
  }

  // One reveal system for the whole site: every section and catalogue hero rises in once,
  // as a unit, with the same timing everywhere; nothing moves when the visitor asked for calm.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const targets = document.querySelectorAll("main .section, main .catalog-hero");
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) { entry.target.setAttribute("data-revealed", "true"); observer.unobserve(entry.target); }
    }, { rootMargin: "0px 0px -12% 0px" });
    targets.forEach((target) => observer.observe(target));
  }
</script>
